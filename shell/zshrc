# ─── Oh My Zsh ────────────────────────────────────────────────
export ZSH="$HOME/.oh-my-zsh"
ZSH_THEME="robbyrussell"
plugins=(z)
source $ZSH/oh-my-zsh.sh

# ─── Environment ──────────────────────────────────────────────
# Hardcoded brew shellenv (regenerate: /opt/homebrew/bin/brew shellenv)
export HOMEBREW_PREFIX="/opt/homebrew"
export HOMEBREW_CELLAR="/opt/homebrew/Cellar"
export HOMEBREW_REPOSITORY="/opt/homebrew"
export PATH="/opt/homebrew/bin:/opt/homebrew/sbin${PATH+:$PATH}"
export MANPATH="/opt/homebrew/share/man${MANPATH+:$MANPATH}:"
export INFOPATH="/opt/homebrew/share/info:${INFOPATH:-}"
export EDITOR="vim"
export VISUAL="vim"
export PATH="$HOME/tools:$HOME/.local/bin:$PATH"

# fzf
source <(fzf --zsh)

# opam
[[ ! -r "$HOME/.opam/opam-init/init.zsh" ]] || source "$HOME/.opam/opam-init/init.zsh" > /dev/null 2> /dev/null

# direnv
eval "$(direnv hook zsh)"

# ─── Navigation ───────────────────────────────────────────────
alias ..="cd .."
alias ...="cd ../.."
alias c="clear"
alias ll="ls -lAh"
alias la="ls -a"

repo() {
  if [[ -z "$1" ]]; then
    ls "$REPO_ROOT"
    return
  fi
  local target="$REPO_ROOT/$1"
  if [[ -d "$target" ]]; then
    cd "$target"
  else
    echo "no repo '$1' in $REPO_ROOT" >&2
    return 1
  fi
}
_repo() { compadd -M 'm:{a-zA-Z}={A-Za-z}' $(ls "$REPO_ROOT") }
compdef _repo repo

# ─── Git ──────────────────────────────────────────────────────
alias gs="git status"
alias gco="git checkout"
alias gb="git branch"
alias ga="git add"
alias gc="git commit"
alias gpush="git push"
alias gpull="git pull"
alias gca="git commit --amend --no-edit"
alias gpushup='git push --set-upstream origin $(git branch --show-current)'
alias gl="git log --oneline --graph -20"
alias gr="git review"
alias greb="git rebase"
alias grebi="git rebase -i"
alias gf="git fetch --prune"
alias gd="git diff"
alias gds="git diff --staged"
alias grs="git restore --staged ."
alias gst="git stash"
alias gstp="git stash pop"
alias gu="git reset --soft HEAD~1"
alias greset="git reset --hard HEAD"
gborrow() { git fetch origin $1 && git branch $1 FETCH_HEAD && git checkout $1; }
alias gclean="git branch --merged | grep -v '\*\|main\|master' | xargs -n1 git branch -d"
gsync() {
  local default_branch=$(git symbolic-ref refs/remotes/origin/HEAD --short | sed 's|origin/||')
  git fetch origin "$default_branch" && git rebase "origin/$default_branch" --autostash
}
alias gprc="gh pr checkout"
gfresh() {
  local branch=$(git branch --show-current)
  git fetch origin "$branch" || { echo "No remote branch origin/$branch"; return 1; }
  git stash
  git reset --hard "origin/$branch"
}
cdg() { cd "$(git rev-parse --show-toplevel)"; }
gbclean() {
  git fetch -p && git branch -vv | grep 'origin/.*: gone]' | awk '{print $1}' | xargs git branch -D
}

# ─── Dev ──────────────────────────────────────────────────────
alias py="python3"
alias serve="python3 -m http.server"
alias ports="lsof -i -P -n | grep LISTEN"
alias ip="curl -s ifconfig.me"
alias flushdns="sudo dscacheutil -flushcache; sudo killall -HUP mDNSResponder"
killport() { lsof -ti:$1 | xargs kill -9; }

# ─── GitHub ──────────────────────────────────────────────────
alias gopen="gh browse"
alias gpr="gh pr view --web"

# ─── Files ────────────────────────────────────────────────────
alias sizeof="du -sh"
alias ducks="du -cksh * | sort -rh | head -20"

# ─── Claude ───────────────────────────────────────────────────
alias cc="claude"
alias ccy="claude --dangerously-skip-permissions"
alias ccc="claude -c"
alias ccr="claude -r"
alias ccp="claude -p"
alias ccw="claude -w"
alias ccry="claude -r --dangerously-skip-permissions"
alias cccy="claude -c --dangerously-skip-permissions"

# ─── Shell ────────────────────────────────────────────────────
alias dot="cd ~/dotfiles"
alias tools="cd ~/tools"
alias sz="source ~/.zshrc"
alias pull-dot='git -C ~/dotfiles pull --rebase && source ~/.zshrc'

# ─── Work ────────────────────────────────────────────────────
[ -f ~/.zshrc.work ] && source ~/.zshrc.work
[ -f ~/.zshrc.personal ] && source ~/.zshrc.personal
