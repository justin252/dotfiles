# ─── Oh My Zsh ────────────────────────────────────────────────
export ZSH="$HOME/.oh-my-zsh"
ZSH_THEME="robbyrussell"
plugins=(z)
source $ZSH/oh-my-zsh.sh

# ─── Environment ──────────────────────────────────────────────
# Hardcoded brew shellenv (regenerate: /opt/homebrew/bin/brew shellenv)
export HOMEBREW_PREFIX="/opt/homebrew"
export HOMEBREW_CELLAR="/opt/homebrew/Cellar"
export HOMEBREW_REPOSITORY="/opt/homebrew"
export PATH="/opt/homebrew/bin:/opt/homebrew/sbin${PATH+:$PATH}"
export MANPATH="/opt/homebrew/share/man${MANPATH+:$MANPATH}:"
export INFOPATH="/opt/homebrew/share/info:${INFOPATH:-}"
export EDITOR="vim"
export VISUAL="vim"
export PATH="$HOME/tools:$HOME/.local/bin:$PATH"

# fzf
source <(fzf --zsh)

# cargo
[[ -f "$HOME/.cargo/env" ]] && source "$HOME/.cargo/env"

# opam
[[ ! -r "$HOME/.opam/opam-init/init.zsh" ]] || source "$HOME/.opam/opam-init/init.zsh" > /dev/null 2> /dev/null

# direnv
eval "$(direnv hook zsh)"

# ─── Navigation ───────────────────────────────────────────────
alias ..="cd .."
alias ...="cd ../.."
alias c="clear"
alias ll="ls -lAh"

repo() {
  if [[ -z "$1" ]]; then
    ls "$REPO_ROOT"
    return
  fi
  local target="$REPO_ROOT/$1"
  if [[ -d "$target" ]]; then
    cd "$target"
  else
    echo "no repo '$1' in $REPO_ROOT" >&2
    return 1
  fi
}
_repo() { compadd -M 'm:{a-zA-Z}={A-Za-z}' $(ls "$REPO_ROOT") }
compdef _repo repo

# ─── Git ──────────────────────────────────────────────────────
alias gs="git status"
alias gco="git checkout"
alias gb="git branch"
alias ga="git add"
alias gc="git commit"
alias gpush="git push"
alias gpull="git pull --rebase --autostash"
alias gca="git commit --amend --no-edit"
alias gpushup='git push --set-upstream origin $(git branch --show-current)'
alias gl="git log --oneline --graph -20"
alias gr="git review"
alias greb="git rebase"
alias grebi="git rebase -i"
alias gf="git fetch --prune"
alias gd="git diff"
alias gds="git diff --staged"
alias grs="git restore --staged ."
alias gst="git stash"
alias gstp="git stash pop"
alias gu="git reset --soft HEAD~1"
alias greset="git reset --hard HEAD"
gborrow() { git fetch origin $1 && git branch $1 FETCH_HEAD && git checkout $1; }
_git_default_branch() { local b; b=$(git symbolic-ref refs/remotes/origin/HEAD --short 2>/dev/null | sed 's|origin/||'); echo "${b:-main}"; }
unalias gclean 2>/dev/null
gclean() {
  git fetch -p
  local default=$(_git_default_branch)
  # branches whose remote is gone
  git branch -vv | grep 'origin/.*: gone]' | awk '{print $1}' | xargs git branch -D 2>/dev/null
  # branches merged into default branch
  git branch --merged "$default" | grep -v "\*\|$default" | xargs git branch -d 2>/dev/null
}
gsync() {
  local default=$(_git_default_branch)
  git fetch origin "$default" && git rebase "origin/$default" --autostash
}
gm() {
  git checkout "$(_git_default_branch)" && git pull --rebase --autostash
}
alias gprc="gh pr checkout"
gfresh() {
  local branch=$(git branch --show-current)
  git fetch origin "$branch" || { echo "No remote branch origin/$branch"; return 1; }
  local stash_msg=$(git stash)
  git reset --hard "origin/$branch"
  [[ "$stash_msg" != "No local changes to save" ]] && echo "Local changes stashed: git stash pop to recover"
}
cdg() { cd "$(git rev-parse --show-toplevel)"; }

# ─── Dev ──────────────────────────────────────────────────────
alias py="python3"
alias serve="python3 -m http.server"
alias ports="lsof -i -P -n | grep LISTEN"
alias ip="curl -s ifconfig.me"
alias flushdns="sudo dscacheutil -flushcache; sudo killall -HUP mDNSResponder"
killport() { lsof -ti:$1 | xargs kill -9; }

# ─── GitHub ──────────────────────────────────────────────────
alias gopen="gh browse"
alias gpr="gh pr view --web"

# ─── Files ────────────────────────────────────────────────────
alias sizeof="du -sh"
alias ducks="du -cksh * | sort -rh | head -20"

# ─── Claude ───────────────────────────────────────────────────
alias cc="claude"
alias ccy="claude --dangerously-skip-permissions"
alias ccc="claude -c"
alias ccr="claude -r"
alias ccp="claude -p"
alias ccw="claude -w"
alias ccry="claude -r --dangerously-skip-permissions"
alias cccy="claude -c --dangerously-skip-permissions"

# ─── Shell ────────────────────────────────────────────────────
alias dot="cd ~/dotfiles"
tools() { cd "${TOOLS_PATH:-$HOME/tools}"; }
alias sz="source ~/.zshrc"
alias pull-dot='git -C ~/dotfiles pull --rebase --autostash && source ~/.zshrc'
alias pull-tools='git -C ~/tools pull --rebase --autostash'
push-tools() {
  local msg="${1:-update}"
  local branch="chore/$(date +%Y%m%d)-${msg// /-}"
  git -C ~/tools checkout -b "$branch" && \
  git -C ~/tools add -A && \
  git -C ~/tools commit -m "chore: $msg" && \
  git -C ~/tools push -u origin "$branch" && \
  gh pr create -R justin252/tools --fill
}

# ─── Work ────────────────────────────────────────────────────
[ -f ~/.zshrc.work ] && source ~/.zshrc.work
[ -f ~/.zshrc.personal ] && source ~/.zshrc.personal
