# ─── Git Worktrees ───────────────────────────────────────────

wt() {
  case "${1:-}" in
    "")
      local trees
      trees=$(~/tools/wt list --plain 2>/dev/null)
      [[ -z "$trees" ]] && { echo "no worktrees" >&2; return 1; }
      if command -v fzf &>/dev/null; then
        local pick
        pick=$(echo "$trees" | fzf --prompt="worktree> ") && cd "$pick"
      else
        echo "$trees"
      fi
      return ;;
    resolve|list|rm|clean|migrate|-h|--help)
      ~/tools/wt "$@"
      return ;;
    -d)
      shift
      ~/tools/wt rm "$@"
      return ;;
    *)
      local dest
      dest=$(~/tools/wt new "$1") || return 1
      cd "$dest"
      echo "→ $(git -C "$dest" rev-parse --abbrev-ref HEAD 2>/dev/null || echo "$1") at $dest" ;;
  esac
}

