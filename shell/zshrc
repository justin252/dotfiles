# ─── Cached hook helper ──────────────────────────────────────
# Cache shell hook output to ~/.cache/zsh/<name>.zsh; regen when binary changes
_cache_hook() {
  local name=$1 bin=$2 cmd=$3
  local cache="$HOME/.cache/zsh/${name}.zsh"
  local binpath="${commands[$bin]:-}"
  [[ -z $binpath ]] && return
  if [[ ! -f $cache || $binpath -nt $cache ]]; then
    mkdir -p "${cache:h}"
    eval "$cmd" > "$cache"
  fi
  source "$cache"
}

# fzf
_cache_hook fzf fzf 'fzf --zsh'

