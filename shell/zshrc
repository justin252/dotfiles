# ─── Git Worktrees ───────────────────────────────────────────
_wt_main_root() {
  local toplevel common
  toplevel=$(git rev-parse --show-toplevel 2>/dev/null) || return 1
  common=$(git rev-parse --git-common-dir 2>/dev/null)
  if [[ "$common" != ".git" && "$common" != "$(git rev-parse --git-dir 2>/dev/null)" ]]; then
    (cd "$(dirname "$common")" && pwd)
  else
    echo "$toplevel"
  fi
}

# Kill any tmux sessions whose working directory is inside a path (layer-agnostic)
_wt_kill_sessions_in() {
  local target="$1" sess sess_path
  while read -r sess; do
    sess_path=$(tmux display-message -t "$sess" -p '#{pane_current_path}' 2>/dev/null) || continue
    [[ "$sess_path" == "$target"* ]] && tmux kill-session -t "$sess" 2>/dev/null
  done < <(tmux list-sessions -F '#{session_name}' 2>/dev/null)
}

# Remove a worktree by path, killing sessions and cleaning up the branch
_wt_remove() {
  local wt_path="$1" root="${2:-}"
  _wt_kill_sessions_in "$wt_path"
  local branch
  branch=$(git -C "$wt_path" rev-parse --abbrev-ref HEAD 2>/dev/null) || true
  if git worktree remove "$wt_path" --force 2>/dev/null; then
    [[ -n "$branch" && "$branch" != "HEAD" && -n "$root" ]] && git -C "$root" branch -d "$branch" 2>/dev/null || true
    echo "  removed $(basename "$wt_path")"
  else
    echo "  failed: $(basename "$wt_path")" >&2
    return 1
  fi
}

wt() {
  case "${1:-}" in
    -h|--help)
      echo "wt – navigate to any branch or PR (worktrees managed automatically)"
      echo "  wt <branch>        go to branch (finds existing worktree or creates one)"
      echo "  wt <PR#>           go to PR branch (e.g. wt 90, wt #90)"
      echo "  wt <PR-URL>        go to PR branch from URL"
      echo "  wt                 fzf picker – switch between worktrees"
      echo "  wt list            show all worktrees (plain text)"
      echo "  wt -d <name>       delete worktree"
      echo "  wt clean           remove worktrees with merged PRs"
      echo "  wt clean --all     delete ALL non-main worktrees"
      return ;;
    -d)
      [[ -z "${2:-}" ]] && { echo "usage: wt -d <name>" >&2; return 1; }
      local root repo wt_path
      root=$(_wt_main_root 2>/dev/null) || { echo "error: not in a git repo" >&2; return 1; }
      repo=$(basename "$root")
      wt_path="${root}/../${repo}-wt-${2}"
      if [[ ! -d "$wt_path" ]]; then
        echo "error: no worktree '$2'" >&2; return 1
      fi
      if [[ -n "$(git -C "$wt_path" status --porcelain 2>/dev/null)" ]]; then
        echo "warning: worktree '$2' has uncommitted changes" >&2
        [[ -t 0 ]] || { echo "use --force or run interactively" >&2; return 1; }
        read -r "reply?remove anyway? [y/N] "
        [[ ! "$reply" =~ ^[Yy] ]] && return 1
      fi
      _wt_remove "$wt_path" "$root"
      return ;;
    "")
      local trees
      trees=$(git worktree list --porcelain 2>/dev/null | awk '/^worktree /{print $2}')
      [[ -z "$trees" ]] && { echo "no worktrees" >&2; return 1; }
      if command -v fzf &>/dev/null; then
        local pick
        pick=$(echo "$trees" | fzf --prompt="worktree> ") && cd "$pick"
      else
        echo "$trees"
      fi
      return ;;
    list)
      git worktree list 2>/dev/null || echo "not in a git repo" >&2
      return ;;
    clean)
      local root force_flag=false clean_all=false
      root=$(_wt_main_root 2>/dev/null) || { echo "error: not in a git repo" >&2; return 1; }
      shift
      for arg in "$@"; do
        case "$arg" in
          --all) clean_all=true ;;
          --force|-f) force_flag=true ;;
        esac
      done
      local wt_paths=()
      while read -r wt_path; do
        [[ "$wt_path" == "$root" ]] && continue
        wt_paths+=("$wt_path")
      done < <(git worktree list --porcelain 2>/dev/null | awk '/^worktree /{print $2}')
      if [[ ${#wt_paths[@]} -eq 0 ]]; then
        echo "no worktrees to clean"
        return 0
      fi
      local to_remove=() branch merged
      if [[ "$clean_all" == true ]]; then
        to_remove=("${wt_paths[@]}")
      else
        # select worktrees whose PR is merged
        echo "checking worktrees..."
        for wt_path in "${wt_paths[@]}"; do
          branch=$(git -C "$wt_path" rev-parse --abbrev-ref HEAD 2>/dev/null) || continue
          [[ -z "$branch" || "$branch" == "HEAD" ]] && continue
          merged=$(gh pr list --head "$branch" --state merged --no-interactive --json number --jq '.[0].number // empty' 2>/dev/null || true)
          if [[ -n "$merged" ]]; then
            echo "  $(basename "$wt_path") ($branch) – PR #$merged merged"
            to_remove+=("$wt_path")
          fi
        done
      fi
      if [[ ${#to_remove[@]} -eq 0 ]]; then
        echo "nothing to clean"
        return 0
      fi
      if [[ "$clean_all" == true ]]; then
        echo "will remove ${#to_remove[@]} worktree(s):"
        for p in "${to_remove[@]}"; do echo "  $(basename "$p")"; done
      fi
      if [[ "$force_flag" != true ]]; then
        [[ -t 0 ]] || { echo "use --force or run interactively" >&2; return 1; }
        read -r "reply?remove ${#to_remove[@]} worktree(s)? [y/N] "
        [[ ! "$reply" =~ ^[Yy] ]] && return 0
      fi
      for wt_path in "${to_remove[@]}"; do
        _wt_remove "$wt_path" "$root"
      done
      git worktree prune 2>/dev/null
      return ;;
    *)
      local dest
      dest=$(~/tools/wt-resolve "$1") || return 1
      cd "$dest"
      echo "→ $(git -C "$dest" rev-parse --abbrev-ref HEAD 2>/dev/null || echo "$1") at $dest" ;;
  esac
}

