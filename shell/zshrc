# ─── Oh My Zsh ───────────────────────────────────────────────────
export ZSH="$HOME/.oh-my-zsh"
ZSH_THEME="robbyrussell"
plugins=(git)
source $ZSH/oh-my-zsh.sh

# ─── Git ─────────────────────────────────────────────────────────
alias gs="git status"
alias gco="git checkout"
alias gb="git branch"
alias ga="git add"
alias gc="git commit"
alias gpush="git push"
alias gpull="git pull"
alias gca="git commit --amend --no-edit"
alias gpushup='git push --set-upstream origin $(git branch --show-current)'
alias gl="git log"
alias greb="git rebase"
alias grebi="git rebase -i"
alias gf="git fetch --prune"
alias gd="git diff"
alias gds="git diff --staged"
alias gst="git stash"
alias gstp="git stash pop"
alias gu="git reset --soft HEAD~1"
alias greset="git reset --hard HEAD"
alias gborrow='(){git fetch origin $1 && git branch $1 FETCH_HEAD && git checkout $1;}'

# ─── Git Helpers ─────────────────────────────────────────────────
cdg() { cd "$(git rev-parse --show-toplevel)"; }

gbclean() {
  git fetch -p && git branch -vv | grep 'origin/.*: gone]' | awk '{print $1}' | xargs git branch -D
}

# ─── Utility ─────────────────────────────────────────────────────
store_token() {
	printf "Enter env var name (e.g. FOOBAR_TOKEN): " && \
	  read TOKEN_NAME && \
	  printf "Enter API token value: " && \
	  read TOKEN && \
	  security add-generic-password -U -a ${USER} -s ${TOKEN_NAME} -w ${TOKEN} && \
	  unset TOKEN

	TO_WRITE="\nexport ${TOKEN_NAME}="
	TO_WRITE+='$(security find-generic-password -a ${USER}'
	TO_WRITE+=" -s ${TOKEN_NAME} -w)"
	echo -e "${TO_WRITE}" >> ~/.zshrc
	unset TOKEN_NAME
	source ~/.zshrc
}

alias sz="source ~/.zshrc"
alias sync-dotfiles='cd ~/dotfiles && git add -A && git commit -m "chore: sync" && git push && cd -'

# ─── Tools ───────────────────────────────────────────────────────
[ -f ~/.fzf.zsh ] && source ~/.fzf.zsh
eval "$(direnv hook zsh)"
export PATH="$PATH:$HOME/.local/bin"
export PATH="$HOME/tools:$PATH"
