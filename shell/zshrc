# ─── Git ──────────────────────────────────────────────────────
# Hygiene: gm (main + auto-stash + cleanup), gsync (rebase onto main), gclean (cleanup only), gnew (fresh branch)
# All use self-healing fetch – auto-rebuilds refs on stale packed-ref conflicts
# Worktrees: wt <branch|PR#|URL>. Graphite stacks: gtr not gsync
alias gs="git status"
alias gco="git checkout"
alias gb="git branch"
alias ga="git add"
alias gc="git commit"
alias gpush="git push"
alias gpull="git pull --rebase"
alias gca="git commit --amend --no-edit"
alias gpushup='git push --set-upstream origin $(git branch --show-current)'
alias gl="git log --oneline --graph -20"
alias greb="git rebase"
alias grebi="git rebase -i"
alias gf="git fetch --prune"
alias gd="git diff"
alias gds="git diff --staged"
alias grs="git restore --staged ."
alias gst="git stash"
alias gstp="git stash pop"
alias gu="git reset --soft HEAD~1"
alias greset="git reset --hard HEAD"
_git_default_branch() { local b; b=$(git symbolic-ref refs/remotes/origin/HEAD --short 2>/dev/null | sed 's|origin/||'); echo "${b:-main}"; }
# Prune + auto-rebuild refs on packed-ref conflict
_git_fetch_clean() {
  if ! git fetch --prune origin 2>/dev/null; then
    git for-each-ref --format='delete %(refname)' refs/remotes/origin \
      | git update-ref --stdin
    git fetch origin
  fi
}
# Delete gone, merged, and squash-merged branches
_gclean_branches() {
  local default=$(_git_default_branch)
  git branch -vv | grep 'origin/.*: gone]' | awk '{print $1}' | grep . | xargs git branch -D 2>/dev/null
  git branch --merged "$default" | grep -v "\*\|$default" | grep . | xargs git branch -d 2>/dev/null
  local branch
  for branch in $(git branch --format='%(refname:short)' | grep -v "^${default}$"); do
    local state=$(gh pr list --head "$branch" --state merged --json state --jq '.[0].state' 2>/dev/null)
    [[ "$state" == "MERGED" ]] && echo "deleted $branch (PR merged)" && git branch -D "$branch" 2>/dev/null
  done
}
unalias gclean 2>/dev/null
gclean() { _git_fetch_clean && _gclean_branches; }
gsync() {
  local default=$(_git_default_branch)
  _git_fetch_clean && git rebase "origin/$default"
}
gm() {
  _git_fetch_clean
  git checkout "$(_git_default_branch)" && git pull --rebase
  _gclean_branches
  ~/tools/wt clean --force 2>/dev/null || true
}
gfresh() {
  local branch=$(git branch --show-current)
  git fetch origin "$branch" || { echo "No remote branch origin/$branch"; return 1; }
  local stash_msg=$(git stash)
  git reset --hard "origin/$branch"
  [[ "$stash_msg" != "No local changes to save" ]] && echo "Local changes stashed: git stash pop to recover"
}
gnew() {
  local name="$1"
  [[ -z "$name" ]] && echo "usage: gnew <branch-name>" >&2 && return 1
  _git_fetch_clean
  git checkout -b "$name" "origin/$(_git_default_branch)"
}
cdg() { cd "$(git rev-parse --show-toplevel)"; }

