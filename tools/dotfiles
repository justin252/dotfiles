#!/usr/bin/env bash
# category: config
# dotfiles - unified dotfiles sync: pull, verify, refresh, heal
set -euo pipefail

DOTFILES="${DOTFILES:-$HOME/dotfiles}"
WORK_DOTFILES="${WORK_DOTFILES:-$HOME/dotfiles-work}"
OS="$(uname -s)"

# ━━━ Output helpers ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

_green()  { printf '\033[32m%s\033[0m\n' "$*"; }
_yellow() { printf '\033[33m%s\033[0m\n' "$*" >&2; }
_red()    { printf '\033[31m%s\033[0m\n' "$*" >&2; }
_bold()   { printf '\033[1m%s\033[0m\n' "$*" >&2; }
die()     { printf 'error: %s\n' "$1" >&2; [[ -n "${2:-}" ]] && printf '  → %s\n' "$2" >&2; exit 1; }

repaired=0
warnings=0
pulled=0

DRYRUN=false

# ━━━ Symlink manifest ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

_managed_links() {
  # target|source pairs
  cat <<EOF
$HOME/tools|$DOTFILES/tools
$HOME/.zshrc|$DOTFILES/shell/zshrc
$HOME/.tmux.conf|$DOTFILES/shell/tmux.conf
$HOME/.agents/AGENTS.md|$DOTFILES/.agents/AGENTS.md
$HOME/.gemini/GEMINI.md|$DOTFILES/.gemini/GEMINI.md
$HOME/.claude/CLAUDE.md|$DOTFILES/.claude/CLAUDE.md
$HOME/.claude/settings.json|$DOTFILES/.claude/settings.json
$HOME/.claude/agents|$DOTFILES/.claude/agents
$HOME/.claude/hooks/ag-state.sh|$DOTFILES/.claude/hooks/ag-state.sh
$HOME/.cursor/rules|$DOTFILES/.cursor/rules
$HOME/.gitconfig.dotfiles|$DOTFILES/git/config
EOF

  # Work overlay links (conditional)
  if [[ -d "$WORK_DOTFILES/.git" ]]; then
    cat <<EOF
$HOME/.zshrc.work|$WORK_DOTFILES/shell/zshrc.work
$HOME/.agents/AGENTS-work.md|$WORK_DOTFILES/.agents/AGENTS-work.md
EOF
  fi
}

# ━━━ Pull repos ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

_pull_repo() {
  local repo="$1" name="$2"
  if [[ ! -d "$repo/.git" ]]; then
    return 0
  fi
  # Don't touch repos that already have a rebase in progress
  if [[ -d "$repo/.git/rebase-merge" || -d "$repo/.git/rebase-apply" ]]; then
    _yellow "warn: $name has rebase in progress; skipping pull"
    warnings=$((warnings + 1))
    return 0
  fi
  echo "pulling $name..." >&2
  if git -C "$repo" fetch origin main 2>/dev/null && \
     git -C "$repo" rebase --autostash origin/main 2>/dev/null; then
    pulled=$((pulled + 1))
  else
    _yellow "warn: $name pull failed (conflict or network); aborting our rebase"
    git -C "$repo" rebase --abort 2>/dev/null || true
    warnings=$((warnings + 1))
  fi
}

_pull_repos() {
  _pull_repo "$DOTFILES" "dotfiles"
  _pull_repo "$WORK_DOTFILES" "dotfiles-work"
  _pull_repo "$HOME/workspaces-dotfiles" "workspaces-dotfiles"
}

# ━━━ Helpers ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

_prune_broken_links() {
  local dir="$1"
  [[ -d "$dir" ]] || return 0
  local link
  for link in "$dir"/*; do
    if [[ -L "$link" && ! -e "$link" ]]; then
      $DRYRUN && _yellow "  broken symlink: $link" || rm -f "$link"
    fi
  done
}

_skill_sources() {
  [[ -d "$DOTFILES/.agents/skills" ]] && printf '%s\n' "$DOTFILES/.agents/skills"
  [[ -d "$WORK_DOTFILES/.agents/skills" ]] && printf '%s\n' "$WORK_DOTFILES/.agents/skills"
}

_resolve_dir() {
  local path="$1"
  [[ -d "$path" ]] || return 1
  (
    cd "$path" >/dev/null 2>&1 &&
    pwd -P
  )
}

_managed_skill_names() {
  local source_dir skill

  for source_dir in "$@"; do
    [[ -d "$source_dir" ]] || continue
    for skill in "$source_dir"/*/; do
      [[ -d "$skill" ]] || continue
      basename "$skill"
    done
  done | sort -u
}

_expected_skill_source() {
  local skill_name="$1"
  shift
  local source_dir candidate expected=""

  for source_dir in "$@"; do
    candidate="$source_dir/$skill_name"
    [[ -d "$candidate" ]] || continue
    expected="$candidate"
  done

  [[ -n "$expected" ]] && printf '%s\n' "$expected"
}

_flat_dir_sources() {
  local subpath="$1"
  [[ -d "$DOTFILES/$subpath" ]] && printf '%s\n' "$DOTFILES/$subpath"
  [[ -d "$WORK_DOTFILES/$subpath" ]] && printf '%s\n' "$WORK_DOTFILES/$subpath"
}

_expected_flat_source() {
  local fname="$1"
  shift
  local source_dir candidate expected=""

  for source_dir in "$@"; do
    candidate="$source_dir/$fname"
    [[ -f "$candidate" ]] || continue
    expected="$candidate"
  done

  [[ -n "$expected" ]] && printf '%s\n' "$expected"
}

_skill_description() {
  local skill_dir="$1"
  local skill_name skill_desc _desc

  skill_name="$(basename "$skill_dir")"
  skill_desc="Activate the $skill_name skill."
  if [[ -f "$skill_dir/SKILL.md" ]]; then
    _desc=$(
      awk '
        NR == 1 {
          if ($0 != "---") {
            exit
          }
          in_frontmatter = 1
          next
        }
        in_frontmatter && /^---$/ {
          closed = 1
          in_frontmatter = 0
          exit
        }
        in_frontmatter && /^description:/ {
          value = $0
          sub(/^description: *"?/, "", value)
          sub(/"? *$/, "", value)
          desc = value
        }
        END {
          if (closed && desc != "") {
            print desc
          }
        }
      ' "$skill_dir/SKILL.md"
    )
    [[ -n "$_desc" ]] && skill_desc="$_desc"
  fi
  printf '%s\n' "$skill_desc"
}

_write_gemini_command() {
  local skill_dir="$1" dest="$2"
  local skill_name skill_desc

  skill_name="$(basename "$skill_dir")"
  skill_desc="$(_skill_description "$skill_dir")"
  skill_desc="${skill_desc//\"/\\\"}"
  cat > "$dest" <<GEMEOF
description = "$skill_desc"
prompt = "Read and follow the instructions in ~/.agents/skills/$skill_name/SKILL.md"
GEMEOF
}

# ━━━ Ensure functions ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# Each _ensure_* checks + fixes one concern. DRYRUN=true skips mutations.

_ensure_symlinks() {
  echo "symlinks:" >&2
  local target source ok=0
  while IFS='|' read -r target source; do
    [[ -n "$target" ]] || continue
    $DRYRUN || mkdir -p "$(dirname "$target")"

    if [[ ! -e "$source" ]]; then
      _yellow "  warn: source missing: $source"
      warnings=$((warnings + 1))
      continue
    fi

    if [[ -L "$target" ]]; then
      local current
      current="$(readlink "$target")"
      if [[ "$current" == "$source" ]]; then
        ((ok++)) || true
        continue
      fi
      if $DRYRUN; then
        _yellow "  wrong: $target → $current (expected $source)"
        warnings=$((warnings + 1))
      else
        ln -sfn "$source" "$target"
        echo "  repaired: $target (was → $current)" >&2
        repaired=$((repaired + 1))
      fi
    elif [[ -e "$target" ]]; then
      _yellow "  blocked: $target exists as real file (expected symlink to $source)"
      warnings=$((warnings + 1))
    else
      if $DRYRUN; then
        _yellow "  missing: $target"
        warnings=$((warnings + 1))
      else
        ln -sfn "$source" "$target"
        echo "  created: $target → $source" >&2
        repaired=$((repaired + 1))
      fi
    fi
  done < <(_managed_links)
  $DRYRUN && echo "  $ok ok, $warnings issues" >&2 || true
}

_ensure_flat_dirs() {
  echo "flat dirs:" >&2
  local subpath label target
  for subpath in .agents/conventions .agents/docs; do
    label="${subpath##*/}"
    target="$HOME/$subpath"
    local sources=()
    local source_dir
    while IFS= read -r source_dir; do
      [[ -n "$source_dir" ]] && sources+=("$source_dir")
    done < <(_flat_dir_sources "$subpath")

    if $DRYRUN; then
      if [[ ! -d "$target" || -L "$target" ]]; then
        _yellow "  $label: directory missing or not a real dir"
        warnings=$((warnings + 1))
        continue
      fi

      if [[ ${#sources[@]} -eq 0 ]]; then
        _yellow "  $label: no sources found"
        warnings=$((warnings + 1))
        continue
      fi

      local managed_names_file
      managed_names_file="$(mktemp "${TMPDIR:-/tmp}/dotfiles-flat-dir.XXXXXX")" || {
        _yellow "  $label: unable to create temp file for checks"
        warnings=$((warnings + 1))
        continue
      }

      for source_dir in "${sources[@]}"; do
        for f in "$source_dir"/*; do
          [[ -f "$f" ]] || continue
          printf '%s\n' "$(basename "$f")" >>"$managed_names_file"
        done
      done
      sort -u "$managed_names_file" -o "$managed_names_file"

      local expected_count=0 ok=0 broken=0 fname expected
      while IFS= read -r fname; do
        [[ -n "$fname" ]] || continue
        expected_count=$((expected_count + 1))
        expected="$(_expected_flat_source "$fname" "${sources[@]}")"

        if [[ -L "$target/$fname" && "$(readlink "$target/$fname")" == "$expected" ]]; then
          ((ok++)) || true
        elif [[ ! -e "$target/$fname" && ! -L "$target/$fname" ]]; then
          _yellow "  $label missing: $fname"
          warnings=$((warnings + 1))
        else
          _yellow "  $label wrong: $fname"
          warnings=$((warnings + 1))
        fi
      done <"$managed_names_file"

      for link in "$target"/*; do
        [[ -L "$link" ]] || continue
        local link_name
        link_name="$(basename "$link")"
        if [[ -e "$link" ]]; then
          # Valid symlink – check if it's stale (not in any source)
          if ! grep -qx "$link_name" "$managed_names_file"; then
            _yellow "  $label stale: $link_name"
            warnings=$((warnings + 1))
          fi
          continue
        fi
        ((broken++)) || true
      done
      if [[ $broken -gt 0 ]]; then
        _yellow "  $label: $broken broken symlinks"
        warnings=$((warnings + 1))
      fi
      echo "  $label: source=$expected_count ok=$ok" >&2
      rm -f "$managed_names_file"
    else
      mkdir -p "$target"
      _prune_broken_links "$target"

      if [[ ${#sources[@]} -eq 0 ]]; then
        _yellow "  $label: no sources found"
        warnings=$((warnings + 1))
        continue
      fi

      # Symlink each file (work wins on collision; skip existing regular files)
      local count=0 source_dir f fname
      for source_dir in "${sources[@]}"; do
        for f in "$source_dir"/*; do
          [[ -f "$f" ]] || continue
          fname="$(basename "$f")"
          if [[ -f "$target/$fname" && ! -L "$target/$fname" ]]; then
            _yellow "  $label: skipping $fname (local file exists)"
            warnings=$((warnings + 1))
            continue
          fi
          ln -sf "$f" "$target/$fname"
          ((count++)) || true
        done
      done
      # Remove stale symlinks (source file was deleted but symlink persists)
      local stale=0 link_name
      for link in "$target"/*; do
        [[ -L "$link" ]] || continue
        link_name="$(basename "$link")"
        local found=false
        for source_dir in "${sources[@]}"; do
          if [[ -f "$source_dir/$link_name" ]]; then
            found=true
            break
          fi
        done
        if ! $found; then
          rm -f "$link"
          ((stale++)) || true
        fi
      done
      echo "  $label: $count synced${stale:+, $stale stale removed}" >&2
    fi
  done
}

_ensure_skills() {
  echo "skills:" >&2
  local skill_sources=()
  local source_dir skill_name skill
  local managed_names_file
  local managed_count=0

  managed_names_file="$(mktemp "${TMPDIR:-/tmp}/dotfiles-skills.XXXXXX")" || {
    _yellow "  warn: unable to create temp file for skill checks"
    warnings=$((warnings + 1))
    return 0
  }

  while IFS= read -r source_dir; do
    [[ -n "$source_dir" ]] && skill_sources+=("$source_dir")
  done < <(_skill_sources)

  if [[ ${#skill_sources[@]} -eq 0 ]]; then
    _yellow "  warn: no skill sources found"
    warnings=$((warnings + 1))
    rm -f "$managed_names_file"
    return 0
  fi

  _managed_skill_names "${skill_sources[@]}" >"$managed_names_file"
  managed_count=$(grep -c . "$managed_names_file" 2>/dev/null || true)

  if $DRYRUN; then
    local agents_ok=0 claude_ok=0 cursor_ok=0 gemini_ok=0
    local expected_skill expected_resolved actual_resolved gemini_tmp
    while IFS= read -r skill_name; do
      [[ -n "$skill_name" ]] || continue
      expected_skill="$(_expected_skill_source "$skill_name" "${skill_sources[@]}")"
      expected_resolved="$(_resolve_dir "$expected_skill" 2>/dev/null || true)"

      actual_resolved="$(_resolve_dir "$HOME/.agents/skills/$skill_name" 2>/dev/null || true)"
      if [[ -L "$HOME/.agents/skills/$skill_name" && -n "$expected_resolved" && "$actual_resolved" == "$expected_resolved" ]]; then
        ((agents_ok++)) || true
      else
        _yellow "  agents wrong: $skill_name"
        warnings=$((warnings + 1))
      fi

      actual_resolved="$(_resolve_dir "$HOME/.claude/skills/$skill_name" 2>/dev/null || true)"
      if [[ -L "$HOME/.claude/skills/$skill_name" && -n "$expected_resolved" && "$actual_resolved" == "$expected_resolved" ]]; then
        ((claude_ok++)) || true
      else
        _yellow "  claude wrong: $skill_name"
        warnings=$((warnings + 1))
      fi

      if [[ -d "$HOME/.cursor/skills/$skill_name" && ! -L "$HOME/.cursor/skills/$skill_name" ]] && \
         diff -qr "$expected_skill" "$HOME/.cursor/skills/$skill_name" >/dev/null 2>&1; then
        ((cursor_ok++)) || true
      else
        _yellow "  cursor wrong: $skill_name"
        warnings=$((warnings + 1))
      fi

      gemini_tmp="$(mktemp "${TMPDIR:-/tmp}/dotfiles-gemini.XXXXXX")" || {
        _yellow "  gemini wrong: $skill_name (tempfile failed)"
        warnings=$((warnings + 1))
        continue
      }
      if ! _write_gemini_command "$expected_skill" "$gemini_tmp"; then
        _yellow "  gemini wrong: $skill_name"
        warnings=$((warnings + 1))
        rm -f "$gemini_tmp"
        continue
      fi
      if [[ -f "$HOME/.gemini/commands/$skill_name.toml" ]] && cmp -s "$gemini_tmp" "$HOME/.gemini/commands/$skill_name.toml"; then
        ((gemini_ok++)) || true
      else
        _yellow "  gemini wrong: $skill_name"
        warnings=$((warnings + 1))
      fi
      rm -f "$gemini_tmp"
    done <"$managed_names_file"
    # Detect stale skills (in destination but not in any source)
    for entry in "$HOME/.agents/skills"/*/; do
      [[ -d "$entry" ]] || continue
      skill_name="$(basename "$entry")"
      if ! grep -qx "$skill_name" "$managed_names_file"; then
        _yellow "  agents stale: $skill_name"
        warnings=$((warnings + 1))
      fi
    done
    echo "  source=$managed_count agents=$agents_ok claude=$claude_ok cursor=$cursor_ok gemini=$gemini_ok" >&2
    rm -f "$managed_names_file"
    return 0
  fi

  mkdir -p "$HOME/.agents/skills" "$HOME/.claude/skills" "$HOME/.cursor/skills" "$HOME/.gemini/commands"

  _prune_broken_links "$HOME/.agents/skills"
  _prune_broken_links "$HOME/.claude/skills"
  _prune_broken_links "$HOME/.gemini/commands"

  # Clean managed skills
  if [[ $managed_count -gt 0 ]]; then
    while IFS= read -r skill_name; do
      [[ -n "$skill_name" ]] || continue
      rm -rf "$HOME/.agents/skills/$skill_name" "$HOME/.claude/skills/$skill_name" "$HOME/.cursor/skills/$skill_name" "$HOME/.gemini/commands/$skill_name.toml"
    done <"$managed_names_file"
  fi

  # Rebuild from sources
  for source_dir in "${skill_sources[@]}"; do
    for skill in "$source_dir"/*/; do
      [[ -d "$skill" ]] || continue
      skill_name="$(basename "$skill")"
      ln -sfn "$skill" "$HOME/.agents/skills/$skill_name"

      # Gemini Custom Command
      _write_gemini_command "$skill" "$HOME/.gemini/commands/$skill_name.toml"
    done
  done

  # Remove stale skills before syncing (stale entries can crash cp -R -L)
  local stale=0
  for entry in "$HOME/.agents/skills"/*/; do
    [[ -d "$entry" ]] || continue
    skill_name="$(basename "$entry")"
    local found=false
    for source_dir in "${skill_sources[@]}"; do
      if [[ -d "$source_dir/$skill_name" ]]; then
        found=true
        break
      fi
    done
    if ! $found; then
      rm -rf "$HOME/.agents/skills/$skill_name" "$HOME/.claude/skills/$skill_name" "$HOME/.cursor/skills/$skill_name" "$HOME/.gemini/commands/$skill_name.toml"
      ((stale++)) || true
    fi
  done

  # Sync to Claude (symlinks) and Cursor (copies)
  local count=0
  for skill in "$HOME/.agents/skills"/*/; do
    [[ -d "$skill" ]] || continue
    skill_name="$(basename "$skill")"
    ln -sfn "$skill" "$HOME/.claude/skills/$skill_name"
    rm -rf "$HOME/.cursor/skills/$skill_name"
    cp -R -L "$skill" "$HOME/.cursor/skills/$skill_name"
    ((count++)) || true
  done

  echo "  $count synced${stale:+, $stale stale removed}" >&2
  rm -f "$managed_names_file"
}

_ensure_codex() {
  command -v codex &>/dev/null || return 0
  echo "codex:" >&2

  local config_file="$HOME/.codex/config.toml"

  if $DRYRUN; then
    if [[ ! -f "$config_file" ]]; then
      _yellow "  config missing"
      warnings=$((warnings + 1))
      return 0
    fi
    local missing=0
    grep -q '^approval_policy *= *"never"' "$config_file" 2>/dev/null || ((missing++)) || true
    grep -q '^sandbox_mode *= *"danger-full-access"' "$config_file" 2>/dev/null || ((missing++)) || true
    if [[ $missing -gt 0 ]]; then
      _yellow "  $missing defaults need sync"
      warnings=$((warnings + 1))
    else
      echo "  defaults ok" >&2
    fi
    return 0
  fi

  local config_dir="$HOME/.codex"
  local tmp_file
  tmp_file="$(mktemp "${TMPDIR:-/tmp}/codex-config.XXXXXX")"

  mkdir -p "$config_dir"
  [[ -f "$config_file" ]] || touch "$config_file"

  awk '
    BEGIN { entered_section = 0; found_approval = 0; found_sandbox = 0 }
    function print_missing() {
      if (!found_approval) print "approval_policy = \"never\""
      if (!found_sandbox) print "sandbox_mode = \"danger-full-access\""
    }
    {
      if (!entered_section && $0 ~ /^[[:space:]]*\[/) { print_missing(); entered_section = 1 }
      if (!entered_section && $0 ~ /^[[:space:]]*approval_policy[[:space:]]*=/) {
        print "approval_policy = \"never\""; found_approval = 1; next
      }
      if (!entered_section && $0 ~ /^[[:space:]]*sandbox_mode[[:space:]]*=/) {
        print "sandbox_mode = \"danger-full-access\""; found_sandbox = 1; next
      }
      print
    }
    END { if (!entered_section) print_missing() }
  ' "$config_file" >"$tmp_file" || { rm -f "$tmp_file"; return 1; }

  mv "$tmp_file" "$config_file"
  echo "  defaults synced" >&2
}

_ensure_karabiner() {
  [[ "$OS" == "Darwin" ]] || return 0
  local src="$DOTFILES/karabiner/karabiner.json"
  local dest="$HOME/.config/karabiner/karabiner.json"
  [[ -f "$src" ]] || return 0
  echo "karabiner:" >&2

  if $DRYRUN; then
    if [[ ! -f "$dest" ]]; then
      _yellow "  copy missing"
      warnings=$((warnings + 1))
    elif [[ "$src" -nt "$dest" ]]; then
      _yellow "  stale (source newer than copy)"
      warnings=$((warnings + 1))
    else
      echo "  ok" >&2
    fi
    return 0
  fi

  mkdir -p "$HOME/.config/karabiner"
  cp "$src" "$dest"
  echo "  copied" >&2
}

_ensure_git_config() {
  echo "git:" >&2
  if git config --global --get-all include.path 2>/dev/null | grep -qF '.gitconfig.dotfiles'; then
    $DRYRUN && echo "  include.path ok" >&2
    return 0
  fi

  if $DRYRUN; then
    _yellow "  include.path missing"
    warnings=$((warnings + 1))
  else
    # shellcheck disable=SC2088  # literal tilde is intentional – git expands ~ in include.path
    git config --global --add include.path '~/.gitconfig.dotfiles'
    echo "  added include for .gitconfig.dotfiles" >&2
  fi
}

_ensure_dirs() {
  echo "dirs:" >&2
  local missing=0
  for d in "$HOME/.agents/artifacts" "$HOME/.agents/sessions" "$HOME/.agents/state" "$HOME/.agents/learnings"; do
    if [[ ! -d "$d" ]]; then
      if $DRYRUN; then
        _yellow "  missing: $d"
        ((missing++)) || true
      else
        mkdir -p "$d"
      fi
    fi
  done
  # Per-animal learnings files (circus roster)
  for animal in octopus beaver dog eagle owl lion elephant; do
    local lf="$HOME/.agents/learnings/${animal}.md"
    if [[ ! -f "$lf" ]]; then
      if $DRYRUN; then
        _yellow "  missing: learnings/${animal}.md"
        ((missing++)) || true
      else
        touch "$lf"
        echo "  seeded: learnings/${animal}.md" >&2
      fi
    fi
  done
  if $DRYRUN; then
    [[ $missing -gt 0 ]] && warnings=$((warnings + missing)) || echo "  ok" >&2
  fi
}

_ensure_seeds() {
  echo "seeds:" >&2
  local missing=0
  for f in "$HOME/.agents/INBOX.md" "$HOME/.agents/wins.md"; do
    if [[ ! -f "$f" ]]; then
      if $DRYRUN; then
        _yellow "  missing: $(basename "$f")"
        ((missing++)) || true
      else
        if [[ "$(basename "$f")" == "INBOX.md" ]]; then
          cat > "$f" <<'SEEDEOF'
## Refined

## Inbox

## Resolved
SEEDEOF
        else
          touch "$f"
        fi
        echo "  seeded: $(basename "$f")" >&2
      fi
    fi
  done
  # Per-animal learnings files (circus roster)
  for animal in octopus beaver dog eagle owl lion elephant; do
    local lf="$HOME/.agents/learnings/${animal}.md"
    if [[ ! -f "$lf" ]]; then
      if $DRYRUN; then
        _yellow "  missing: learnings/${animal}.md"
        ((missing++)) || true
      else
        touch "$lf"
        echo "  seeded: learnings/${animal}.md" >&2
      fi
    fi
  done
  if $DRYRUN; then
    [[ $missing -gt 0 ]] && warnings=$((warnings + missing)) || echo "  ok" >&2
  fi
}

# ━━━ Shared dispatch ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# Adding a new concern: add one _ensure_* function + one line here.

_run_ensures() {
  _ensure_symlinks
  _ensure_flat_dirs
  _ensure_skills
  _ensure_codex
  _ensure_karabiner
  _ensure_git_config
  _ensure_dirs
  _ensure_seeds
}

# ━━━ Subcommands ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

_doctor_repos() {
  echo "repos:" >&2
  local repo name
  for repo in "$DOTFILES" "$WORK_DOTFILES" "$HOME/workspaces-dotfiles"; do
    name="$(basename "$repo")"
    if [[ ! -d "$repo/.git" ]]; then
      echo "  $name: not found" >&2
      continue
    fi
    local branch dirty behind status
    branch="$(git -C "$repo" branch --show-current 2>/dev/null || echo "detached")"
    dirty="$(git -C "$repo" status --porcelain 2>/dev/null | head -1)"
    behind="$(git -C "$repo" rev-list --count HEAD..origin/main 2>/dev/null || echo "?")"
    status="branch=$branch"
    [[ -n "$dirty" ]] && status="$status, dirty"
    [[ "$behind" != "0" && "$behind" != "?" ]] && status="$status, ${behind} behind"
    echo "  $name: $status" >&2
  done
}

cmd_default() {
  _bold "dot: syncing"
  echo "" >&2

  _pull_repos

  echo "" >&2
  DRYRUN=false
  _run_ensures

  echo "" >&2
  _bold "done: $pulled repos pulled, $repaired links repaired, $warnings warnings"
}

cmd_doctor() {
  _bold "dotfiles doctor"
  echo "" >&2

  _doctor_repos

  echo "" >&2
  DRYRUN=true
  _run_ensures

  echo "" >&2
  if [[ $warnings -eq 0 ]]; then
    _bold "all healthy"
  else
    _bold "$warnings issues found"
  fi

  echo "" >&2
  echo "platform:" >&2
  echo "  os: $OS" >&2
  [[ -d "$WORK_DOTFILES/.git" ]] && echo "  context: work" >&2 || echo "  context: personal" >&2
}

cmd_setup() {
  _bold "dotfiles setup: full rebuild"
  echo "" >&2

  [[ -f "$DOTFILES/install.sh" ]] || die "$DOTFILES/install.sh not found"

  bash "$DOTFILES/install.sh"

  if [[ -f "$WORK_DOTFILES/install.sh" ]]; then
    echo "" >&2
    bash "$WORK_DOTFILES/install.sh"
  fi

  echo "" >&2
  _bold "install complete"
}

usage() {
  cat <<'EOF'
dotfiles - unified dotfiles sync

Usage:
  dotfiles            Pull repos, verify symlinks, refresh skills, sync configs
  dotfiles setup      Full rebuild via install.sh (first-time setup, binary installs)
  dotfiles doctor     Read-only health check

Flags:
  -h, --help          Show this help

Shell reload happens automatically via the zshrc wrapper.
EOF
}

# ━━━ Dispatch ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

case "${1:-}" in
  ""              ) cmd_default ;;
  setup           ) shift; [[ "${1:-}" == -h || "${1:-}" == --help ]] && { echo "dotfiles setup: full rebuild via install.sh" >&2; exit 0; }; cmd_setup ;;
  doctor          ) shift; [[ "${1:-}" == -h || "${1:-}" == --help ]] && { echo "dotfiles doctor: read-only health check" >&2; exit 0; }; cmd_doctor ;;
  -h|--help       ) usage ;;
  *)              die "unknown command: $1" "Run 'dotfiles --help' for usage" ;;
esac
