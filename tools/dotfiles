#!/usr/bin/env bash
# category: config
# dotfiles - unified dotfiles sync: pull, verify, refresh, heal
set -euo pipefail

DOTFILES="${DOTFILES:-$HOME/dotfiles}"
WORK_DOTFILES="${WORK_DOTFILES:-$HOME/dotfiles-work}"
OS="$(uname -s)"

# ━━━ Output helpers ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

_green()  { printf '\033[32m%s\033[0m\n' "$*"; }
_yellow() { printf '\033[33m%s\033[0m\n' "$*" >&2; }
_red()    { printf '\033[31m%s\033[0m\n' "$*" >&2; }
_bold()   { printf '\033[1m%s\033[0m\n' "$*"; }

repaired=0
warnings=0
pulled=0

# ━━━ Symlink manifest ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

_managed_links() {
  # target|source pairs
  cat <<EOF
$HOME/tools|$DOTFILES/tools
$HOME/.zshrc|$DOTFILES/shell/zshrc
$HOME/.tmux.conf|$DOTFILES/shell/tmux.conf
$HOME/.agents/AGENTS.md|$DOTFILES/.agents/AGENTS.md
$HOME/.agents/conventions|$DOTFILES/.agents/conventions
$HOME/.agents/docs|$DOTFILES/.agents/docs
$HOME/.gemini/GEMINI.md|$DOTFILES/.gemini/GEMINI.md
$HOME/.claude/CLAUDE.md|$DOTFILES/.claude/CLAUDE.md
$HOME/.claude/settings.json|$DOTFILES/.claude/settings.json
$HOME/.claude/agents|$DOTFILES/.claude/agents
$HOME/.cursor/rules|$DOTFILES/.cursor/rules
$HOME/.gitconfig.dotfiles|$DOTFILES/git/config
EOF

  # Work overlay links (conditional)
  if [[ -d "$WORK_DOTFILES/.git" ]]; then
    cat <<EOF
$HOME/.zshrc.work|$WORK_DOTFILES/shell/zshrc.work
$HOME/.agents/AGENTS-work.md|$WORK_DOTFILES/.agents/AGENTS-work.md
EOF
  fi
}

# ━━━ Pull repos ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

_pull_repo() {
  local repo="$1" name="$2"
  if [[ ! -d "$repo/.git" ]]; then
    return 0
  fi
  # Don't touch repos that already have a rebase in progress
  if [[ -d "$repo/.git/rebase-merge" || -d "$repo/.git/rebase-apply" ]]; then
    _yellow "warn: $name has rebase in progress; skipping pull"
    warnings=$((warnings + 1))
    return 0
  fi
  echo "pulling $name..."
  if git -C "$repo" fetch origin main 2>/dev/null && \
     git -C "$repo" rebase --autostash origin/main 2>/dev/null; then
    pulled=$((pulled + 1))
  else
    _yellow "warn: $name pull failed (conflict or network); aborting our rebase"
    git -C "$repo" rebase --abort 2>/dev/null || true
    warnings=$((warnings + 1))
  fi
}

_pull_repos() {
  _pull_repo "$DOTFILES" "dotfiles"
  _pull_repo "$WORK_DOTFILES" "dotfiles-work"
  _pull_repo "$HOME/workspaces-dotfiles" "workspaces-dotfiles"
}

# ━━━ Verify + repair symlinks ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

_verify_symlinks() {
  local target source
  while IFS='|' read -r target source; do
    [[ -n "$target" ]] || continue
    mkdir -p "$(dirname "$target")"

    # Skip if source doesn't exist (stale manifest entry)
    if [[ ! -e "$source" ]]; then
      _yellow "  warn: source missing: $source"
      warnings=$((warnings + 1))
      continue
    fi

    if [[ -L "$target" ]]; then
      local current
      current="$(readlink "$target")"
      if [[ "$current" == "$source" ]]; then
        continue
      fi
      ln -sfn "$source" "$target"
      echo "  repaired: $target (was → $current)"
      repaired=$((repaired + 1))
    elif [[ -e "$target" ]]; then
      _yellow "  warn: $target exists as real file (expected symlink to $source)"
      warnings=$((warnings + 1))
    else
      ln -sfn "$source" "$target"
      echo "  created: $target → $source"
      repaired=$((repaired + 1))
    fi
  done < <(_managed_links)
}

# ━━━ Refresh agent dirs ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

_prune_broken_links() {
  local dir="$1"
  [[ -d "$dir" ]] || return 0
  local link
  for link in "$dir"/*; do
    if [[ -L "$link" && ! -e "$link" ]]; then
      rm -f "$link"
    fi
  done
}

# Merge flat files from personal + work dotfiles into a target dir.
# Converts directory symlinks to real dirs with per-file symlinks.
# Usage: _refresh_flat_dir <subpath> <label>
#   e.g. _refresh_flat_dir ".agents/conventions" "conventions"
_refresh_flat_dir() {
  local subpath="$1" label="$2"
  local target="$HOME/$subpath"

  # Convert directory symlink to real dir (migration from old layout)
  if [[ -L "$target" ]]; then
    rm -f "$target"
  fi
  mkdir -p "$target"
  _prune_broken_links "$target"

  # Collect sources
  local sources=()
  [[ -d "$DOTFILES/$subpath" ]] && sources+=("$DOTFILES/$subpath")
  [[ -d "$WORK_DOTFILES/$subpath" ]] && sources+=("$WORK_DOTFILES/$subpath")

  # Symlink each file (work wins on collision)
  local count=0 source_dir f fname
  for source_dir in "${sources[@]}"; do
    for f in "$source_dir"/*; do
      [[ -f "$f" ]] || continue
      fname="$(basename "$f")"
      ln -sf "$f" "$target/$fname"
      ((count++)) || true
    done
  done

  echo "  $label: $count files synced"
}

_refresh_skills() {
  # Remove stale top-level symlinks (from old layout)
  [[ -L "$HOME/.agents/skills" ]] && rm -f "$HOME/.agents/skills" || true
  [[ -L "$HOME/.claude/skills" ]] && rm -f "$HOME/.claude/skills" || true
  [[ -L "$HOME/.cursor/skills" ]] && rm -f "$HOME/.cursor/skills" || true

  mkdir -p "$HOME/.agents/skills" "$HOME/.claude/skills" "$HOME/.cursor/skills" "$HOME/.gemini/commands"

  _prune_broken_links "$HOME/.agents/skills"
  _prune_broken_links "$HOME/.claude/skills"
  _prune_broken_links "$HOME/.gemini/commands"

  # Collect skill sources
  local skill_sources=()
  [[ -d "$DOTFILES/.agents/skills" ]] && skill_sources+=("$DOTFILES/.agents/skills")
  [[ -d "$WORK_DOTFILES/.agents/skills" ]] && skill_sources+=("$WORK_DOTFILES/.agents/skills")
  if [[ ${#skill_sources[@]} -eq 0 ]]; then
    _yellow "warn: no skill sources found"
    warnings=$((warnings + 1))
    return 0
  fi

  # Collect unique skill names
  local managed_names=()
  local source_dir skill skill_name
  for source_dir in "${skill_sources[@]}"; do
    for skill in "$source_dir"/*/; do
      [[ -d "$skill" ]] || continue
      skill_name="$(basename "$skill")"
      local found=0
      if [[ ${#managed_names[@]} -gt 0 ]]; then
        local existing
        for existing in "${managed_names[@]}"; do
          [[ "$existing" == "$skill_name" ]] && found=1 && break
        done
      fi
      [[ $found -eq 0 ]] && managed_names+=("$skill_name")
    done
  done

  # Clean managed skills
  if [[ ${#managed_names[@]} -gt 0 ]]; then
    for skill_name in "${managed_names[@]}"; do
      rm -rf "$HOME/.agents/skills/$skill_name" "$HOME/.claude/skills/$skill_name" "$HOME/.cursor/skills/$skill_name" "$HOME/.gemini/commands/$skill_name.toml"
    done
  fi

  # Rebuild from sources
  for source_dir in "${skill_sources[@]}"; do
    for skill in "$source_dir"/*/; do
      [[ -d "$skill" ]] || continue
      skill_name="$(basename "$skill")"
      ln -sfn "$skill" "$HOME/.agents/skills/$skill_name"

      # Gemini Custom Command
      local skill_desc="Activate the $skill_name skill."
      if [[ -f "$skill/SKILL.md" ]]; then
        local _desc
        _desc=$(awk '/^---$/{n++; next} n==1 && /^description:/{sub(/^description: *"?/,""); sub(/"? *$/,""); print; exit}' "$skill/SKILL.md")
        [[ -n "$_desc" ]] && skill_desc="$_desc"
      fi
      skill_desc="${skill_desc//\"/\\\"}"
      cat > "$HOME/.gemini/commands/$skill_name.toml" <<GEMEOF
description = "$skill_desc"
prompt = "Read and follow the instructions in ~/.agents/skills/$skill_name/SKILL.md"
GEMEOF
    done
  done

  # Sync to Claude (symlinks) and Cursor (copies)
  local count=0
  for skill in "$HOME/.agents/skills"/*/; do
    [[ -d "$skill" ]] || continue
    skill_name="$(basename "$skill")"
    ln -sfn "$skill" "$HOME/.claude/skills/$skill_name"
    rm -rf "$HOME/.cursor/skills/$skill_name"
    cp -R -L "$skill" "$HOME/.cursor/skills/$skill_name"
    ((count++)) || true
  done

  echo "  skills: $count synced"
}

# ━━━ Sync Codex config ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

_sync_codex_config() {
  command -v codex &>/dev/null || return 0

  local config_dir="$HOME/.codex"
  local config_file="$config_dir/config.toml"
  local tmp_file
  tmp_file="$(mktemp "${TMPDIR:-/tmp}/codex-config.XXXXXX")"

  mkdir -p "$config_dir"
  [[ -f "$config_file" ]] || touch "$config_file"

  awk '
    BEGIN { entered_section = 0; found_approval = 0; found_sandbox = 0 }
    function print_missing() {
      if (!found_approval) print "approval_policy = \"never\""
      if (!found_sandbox) print "sandbox_mode = \"workspace-write\""
    }
    {
      if (!entered_section && $0 ~ /^[[:space:]]*\[/) { print_missing(); entered_section = 1 }
      if (!entered_section && $0 ~ /^[[:space:]]*approval_policy[[:space:]]*=/) {
        print "approval_policy = \"never\""; found_approval = 1; next
      }
      if (!entered_section && $0 ~ /^[[:space:]]*sandbox_mode[[:space:]]*=/) {
        print "sandbox_mode = \"workspace-write\""; found_sandbox = 1; next
      }
      print
    }
    END { if (!entered_section) print_missing() }
  ' "$config_file" >"$tmp_file" || { rm -f "$tmp_file"; return 1; }

  mv "$tmp_file" "$config_file"
  echo "  codex: defaults synced"
}

# ━━━ Platform-specific ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

_sync_karabiner() {
  [[ "$OS" == "Darwin" ]] || return 0
  [[ -f "$DOTFILES/karabiner/karabiner.json" ]] || return 0
  mkdir -p "$HOME/.config/karabiner"
  cp "$DOTFILES/karabiner/karabiner.json" "$HOME/.config/karabiner/karabiner.json"
  echo "  karabiner: copied"
}

# ━━━ Git config ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

_ensure_git_include() {
  if ! git config --global --get-all include.path 2>/dev/null | grep -qF '.gitconfig.dotfiles'; then
    git config --global --add include.path '~/.gitconfig.dotfiles'
    echo "  git: added include for .gitconfig.dotfiles"
  fi
}

# ━━━ Subcommands ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

cmd_default() {
  _bold "dot: syncing"
  echo ""

  _pull_repos

  echo ""
  echo "verifying symlinks..."
  _verify_symlinks

  echo ""
  echo "refreshing..."
  _refresh_flat_dir ".agents/conventions" "conventions"
  _refresh_flat_dir ".agents/docs" "docs"
  _refresh_skills
  _sync_codex_config
  _sync_karabiner
  _ensure_git_include

  # Ensure required dirs exist
  mkdir -p "$HOME/.agents/artifacts" "$HOME/.agents/sessions" "$HOME/.agents/state"

  # Seed local-only files
  if [[ ! -f "$HOME/.agents/INBOX.md" ]]; then
    cat > "$HOME/.agents/INBOX.md" <<'SEEDEOF'
## Refined

## Inbox

## Resolved
SEEDEOF
    echo "  seeded: INBOX.md"
  fi
  [[ -f "$HOME/.agents/wins.md" ]] || { touch "$HOME/.agents/wins.md"; echo "  seeded: wins.md"; }

  echo ""
  _bold "done: $pulled repos pulled, $repaired links repaired, $warnings warnings"
}

cmd_setup() {
  _bold "dotfiles setup: full rebuild"
  echo ""

  [[ -f "$DOTFILES/install.sh" ]] || { _red "$DOTFILES/install.sh not found"; exit 1; }

  bash "$DOTFILES/install.sh"

  if [[ -f "$WORK_DOTFILES/install.sh" ]]; then
    echo ""
    bash "$WORK_DOTFILES/install.sh"
  fi

  echo ""
  _bold "install complete"
}

cmd_doctor() {
  _bold "dotfiles doctor"
  echo ""

  # Repos
  echo "repos:"
  local repo name
  for repo in "$DOTFILES" "$WORK_DOTFILES" "$HOME/workspaces-dotfiles"; do
    name="$(basename "$repo")"
    if [[ ! -d "$repo/.git" ]]; then
      echo "  $name: not found"
      continue
    fi
    local branch dirty behind
    branch="$(git -C "$repo" branch --show-current 2>/dev/null || echo "detached")"
    dirty="$(git -C "$repo" status --porcelain 2>/dev/null | head -1)"
    behind="$(git -C "$repo" rev-list --count HEAD..origin/main 2>/dev/null || echo "?")"
    local status="branch=$branch"
    [[ -n "$dirty" ]] && status="$status, dirty"
    [[ "$behind" != "0" && "$behind" != "?" ]] && status="$status, ${behind} behind"
    echo "  $name: $status"
  done

  # Symlinks
  echo ""
  echo "symlinks:"
  local ok=0 broken=0 wrong=0 blocked=0
  local target source
  while IFS='|' read -r target source; do
    [[ -n "$target" ]] || continue
    if [[ -L "$target" ]]; then
      local current
      current="$(readlink "$target")"
      if [[ "$current" == "$source" ]]; then
        ok=$((ok + 1))
      else
        echo "  wrong target: $target → $current (expected $source)"
        wrong=$((wrong + 1))
      fi
    elif [[ -e "$target" ]]; then
      echo "  blocked: $target (real file, expected symlink)"
      blocked=$((blocked + 1))
    else
      echo "  missing: $target"
      broken=$((broken + 1))
    fi
  done < <(_managed_links)
  echo "  $ok ok, $broken missing, $wrong wrong, $blocked blocked"

  # Skills
  echo ""
  echo "skills:"
  local skill_count=0
  for s in "$HOME/.agents/skills"/*/; do
    [[ -d "$s" ]] && ((skill_count++)) || true
  done
  echo "  $skill_count in ~/.agents/skills/"

  # Platform
  echo ""
  echo "platform:"
  echo "  os: $OS"
  [[ -d "$WORK_DOTFILES/.git" ]] && echo "  context: work" || echo "  context: personal"
}

usage() {
  cat <<'EOF'
dotfiles - unified dotfiles sync

Usage:
  dotfiles            Pull repos, verify symlinks, refresh skills, sync configs
  dotfiles setup      Full rebuild via install.sh (first-time setup, binary installs)
  dotfiles doctor     Read-only health check

Replaces pull-dot, reset-dot, refresh-skills, sync-codex-config.
Shell reload happens automatically via the zshrc wrapper.
EOF
}

# ━━━ Dispatch ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

case "${1:-}" in
  ""              ) cmd_default ;;
  setup           ) cmd_setup ;;
  doctor          ) cmd_doctor ;;
  _refresh-skills ) _refresh_skills ;;
  _refresh-flat-dir ) shift; _refresh_flat_dir "$@" ;;
  _sync-codex     ) _sync_codex_config ;;
  -h|--help       ) usage ;;
  *)
    echo "error: unknown command: $1" >&2
    echo "  → Run 'dotfiles --help' for usage" >&2
    exit 1
    ;;
esac
