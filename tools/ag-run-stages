#!/usr/bin/env bash
# ag-run-stages - multi-executor stage pipeline runner
# Called by `ag run` when stages need different executors.
# category: agent
set -euo pipefail

usage() {
  cat <<'EOF'
ag-run-stages - run pipeline stages with per-stage executors

Usage: ag-run-stages --session <name> --topic <slug> --plan <path> [--skip <stages>]

Reads AG_EXECUTOR, AG_SHIPPER, AG_REVIEWER, AG_LEARNER env vars.
Format: executor:model (e.g., claude:opus, codex:gpt-5.4)

Stages: execute, ship, review, fix, retro
EOF
}

# Parse executor:model format
_executor() { echo "${1%%:*}"; }
_model()    { local m="${1#*:}"; [[ "$m" == "$1" ]] && m=""; echo "$m"; }

# Build command with model flag
_build_cmd() {
  local val="$1" prompt="$2"
  local exe model cmd
  exe="$(_executor "$val")"
  model="$(_model "$val")"

  case "$exe" in
    claude) cmd="claude${model:+ --model $model}" ;;
    codex)  cmd="codex exec${model:+ -m $model} --sandbox workspace-write -a never" ;;
    *)      cmd="$exe" ;;
  esac
  echo "$cmd $(printf '%q' "$prompt")"
}

# Wait for stage completion via sentinel file
_wait_stage() {
  local state_dir="$1" stage="$2" timeout="${3:-600}"
  local sentinel="$state_dir/stage-done"
  local elapsed=0

  while [[ ! -f "$sentinel" ]]; do
    sleep 5
    elapsed=$((elapsed + 5))
    if (( elapsed >= timeout )); then
      echo "timeout waiting for stage '$stage' after ${timeout}s" >&2
      return 1
    fi
  done

  local result
  result=$(cat "$sentinel")
  rm -f "$sentinel"
  [[ "$result" == "done" ]]
}

# Send command to tmux session with sentinel wrapper
_run_in_session() {
  local session="$1" cmd="$2" state_dir="$3"
  local sentinel="$state_dir/stage-done"
  rm -f "$sentinel"
  tmux send-keys -t "$session" \
    "$cmd && echo done > $(printf '%q' "$sentinel") || echo fail > $(printf '%q' "$sentinel")" Enter
}

# --- main ---

session="" topic="" plan="" skip_str=""

while [[ $# -gt 0 ]]; do
  case "$1" in
    --session) session="$2"; shift 2 ;;
    --topic)   topic="$2"; shift 2 ;;
    --plan)    plan="$2"; shift 2 ;;
    --skip)    skip_str="$2"; shift 2 ;;
    -h|--help) usage; exit 0 ;;
    *)         echo "unknown flag: $1" >&2; exit 1 ;;
  esac
done

[[ -z "$session" || -z "$topic" || -z "$plan" ]] && { usage >&2; exit 1; }

state_dir="$HOME/.agents/state/$topic"
mkdir -p "$state_dir"

# Parse skip list
IFS=',' read -ra skips <<< "${skip_str:-}"
_should_skip() {
  local stage="$1"
  for s in "${skips[@]:-}"; do
    [[ "$s" == "$stage" ]] && return 0
  done
  return 1
}

# Resolve per-stage config
exe_val="${AG_EXECUTOR:-claude:opus}"
ship_val="${AG_SHIPPER:-claude:sonnet}"
review_val="${AG_REVIEWER:-codex:gpt-5.4}"
learn_val="${AG_LEARNER:-claude:haiku}"

echo "ag-run-stages: $topic" >&2
echo "  execute: $exe_val" >&2
echo "  ship:    $ship_val" >&2
echo "  review:  $review_val" >&2
echo "  retro:   $learn_val" >&2
[[ -n "$skip_str" ]] && echo "  skip:    $skip_str" >&2

# --- Stage 1: Execute ---
if ! _should_skip "execute"; then
  echo "stage: execute ($exe_val)" >&2
  echo "executing" > "$state_dir/phase"
  cmd="$(_build_cmd "$exe_val" "/execute $plan")"
  _run_in_session "$session" "$cmd" "$state_dir"
  _wait_stage "$state_dir" "execute" 1800 || { echo "execute failed" >&2; exit 1; }
fi

# --- Stage 2: Ship ---
if ! _should_skip "ship"; then
  echo "stage: ship ($ship_val)" >&2
  echo "shipping" > "$state_dir/phase"
  cmd="$(_build_cmd "$ship_val" "/checkpoint")"
  _run_in_session "$session" "$cmd" "$state_dir"
  _wait_stage "$state_dir" "ship" 600 || { echo "ship failed" >&2; exit 1; }
fi

# --- Stage 3: Review ---
if ! _should_skip "review"; then
  echo "stage: review ($review_val)" >&2
  echo "reviewing" > "$state_dir/phase"
  # Review uses the dedicated tool, not a generic executor
  review --topic "$topic" 2>/dev/null &
  review_pid=$!
  review_elapsed=0
  while (( review_elapsed < 600 )); do
    if [[ -f "$HOME/.agents/artifacts/$topic/review-state.json" ]]; then
      rstate=$(cat "$HOME/.agents/artifacts/$topic/review-state.json" 2>/dev/null)
      if echo "$rstate" | grep -q '"status":"done"' 2>/dev/null; then
        break
      fi
    fi
    sleep 10
    review_elapsed=$((review_elapsed + 10))
  done
  wait "$review_pid" 2>/dev/null || true
fi

# --- Stage 4: Fix (conditional) ---
if ! _should_skip "fix"; then
  review_md="$HOME/.agents/artifacts/$topic/review.md"
  if [[ -f "$review_md" ]] && grep -qE '^#{1,3} .*(Blocker|Issue)|severity: *(blocker|issue)' "$review_md" 2>/dev/null; then
    echo "stage: fix ($exe_val)" >&2
    echo "fixing" > "$state_dir/phase"
    cmd="$(_build_cmd "$exe_val" "Read $review_md and fix all blocker/issue findings. Then run /checkpoint to amend and push.")"
    _run_in_session "$session" "$cmd" "$state_dir"
    _wait_stage "$state_dir" "fix" 900 || { echo "fix failed" >&2; exit 1; }
  fi
fi

# --- Stage 5: Retro ---
if ! _should_skip "retro"; then
  echo "stage: retro ($learn_val)" >&2
  echo "learning" > "$state_dir/phase"
  cmd="$(_build_cmd "$learn_val" "/retro")"
  _run_in_session "$session" "$cmd" "$state_dir"
  _wait_stage "$state_dir" "retro" 300 || { echo "retro failed (non-fatal)" >&2; }
fi

# --- Done ---
echo "done" > "$state_dir/phase"
echo "ag-run-stages: $topic complete" >&2
