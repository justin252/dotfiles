#!/usr/bin/env bash
# ag-status-line – polled by tmux status-right every 5s
# Shows compact agent session indicators: name● (active) name○ (idle)
# category: agent
set -euo pipefail

sessions=$(tmux list-sessions -F '#{session_name}' 2>/dev/null | grep '^ag-' || true)
[[ -z "$sessions" ]] && exit 0

active_count=0
idle_parts=""

while read -r sess; do
  # extract slug from tmux env (reliable), fallback to name parsing
  slug=$(tmux show-environment -t "$sess" AG_SLUG 2>/dev/null | sed 's/^AG_SLUG=//') || true
  if [[ -z "$slug" ]]; then
    tmp="${sess#ag-}"; slug="${tmp#*-}"
  fi

  # check pipeline state, fall back to phase file, then pane command
  phase_file="$HOME/.agents/state/$slug/phase"
  pipeline_file="$HOME/.agents/state/$slug/pipeline.json"
  phase=""
  [[ -f "$phase_file" ]] && phase=$(cat "$phase_file" 2>/dev/null)

  # enrich with pipeline.json timing if available
  stage_elapsed=""
  if [[ -n "$phase" && "$phase" != "done" && -f "$pipeline_file" ]] && command -v jq >/dev/null 2>&1; then
    stage_start=$(jq -r --arg s "$phase" '
      (.stages | to_entries[] | select(.value.status == "running") | .value.started) // empty
    ' "$pipeline_file" 2>/dev/null || true)
    if [[ -n "$stage_start" ]]; then
      start_epoch=$(date -j -f "%Y-%m-%dT%H:%M:%SZ" "$stage_start" +%s 2>/dev/null || date -d "$stage_start" +%s 2>/dev/null || true)
      if [[ -n "$start_epoch" ]]; then
        elapsed_s=$(( $(date +%s) - start_epoch ))
        if (( elapsed_s >= 60 )); then
          stage_elapsed=" $((elapsed_s / 60))m"
        fi
      fi
    fi
  fi

  if [[ -n "$phase" && "$phase" != "done" ]]; then
    case "$phase" in
      executing) icon="🦊" ;;
      shipping)  icon="🦅" ;;
      reviewing) icon="🦉" ;;
      fixing)    icon="🔧" ;;
      learning)  icon="🐘" ;;
      *)         icon="●"  ;;
    esac
    active_count=$((active_count + 1))
    idle_parts+=" #[fg=cyan]${slug}${icon}${stage_elapsed}"
  elif [[ "$phase" == "done" ]]; then
    idle_parts+=" #[fg=green]${slug}✓"
  else
    pane_cmd=$(tmux display-message -t "$sess" -p '#{pane_current_command}' 2>/dev/null || echo "")
    if [[ "$pane_cmd" == "zsh" || "$pane_cmd" == "bash" || -z "$pane_cmd" ]]; then
      idle_parts+=" #[fg=yellow]${slug}○"
    else
      active_count=$((active_count + 1))
    fi
  fi
done <<< "$sessions"

# build output: show active count, then idle names (idle = needs attention)
out=""
if [[ $active_count -gt 0 ]]; then
  out+="#[fg=green]${active_count}●"
fi
out+="${idle_parts}"

if [[ -n "$out" ]]; then
  echo "#[fg=blue]ag: ${out} #[fg=default]| "
fi
