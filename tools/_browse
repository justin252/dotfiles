#!/usr/bin/env bash
# _browse - shared fzf browser library
# Sourced by sessions, notes, artifacts. Not executed directly.

# ANSI color codes
YELLOW=$'\033[33m'
DIM=$'\033[2m'
RESET=$'\033[0m'

# Preview command for markdown/text files
_browse_preview() {
  local file="$1"
  bat --style=plain --color=always "$file" 2>/dev/null || cat "$file"
}

# Standard fzf invocation with preview + ctrl-y copy
# Args: prompt, header, entries (tab-delimited), [query]
_browse_fzf() {
  local prompt="$1"
  local header="$2"
  local entries="$3"
  local query="${4:-}"

  local preview_cmd="bat --style=plain --color=always {2} 2>/dev/null || cat {2}"
  
  local fzf_args=(
    --prompt="$prompt"
    --header="$header"
    --ansi
    --delimiter=$'\t'
    --with-nth=1
    --preview="$preview_cmd"
    --preview-window=right:60%:wrap
    --bind='ctrl-y:execute-silent(echo {2} | tr -d "\n" | if command -v pbcopy >/dev/null; then pbcopy; elif command -v xclip >/dev/null; then xclip -selection clipboard; fi)+abort'
  )
  [[ -n "$query" ]] && fzf_args+=(--query="$query")
  
  printf '%s' "$entries" | fzf "${fzf_args[@]}"
}

# Standard action dispatcher
# Args: action, full_path, display_name
_browse_action() {
  local action="$1"
  local full="$2"
  local fname="${3:-$(basename "$full")}"
  
  case "$action" in
    edit)
      ${EDITOR:-code} "$full" ;;
    ide)
      ${DOTFILES_IDE:-code} "$full" ;;
    claude)
      echo "Launching Claude Code: ${fname%.md}"
      claude "load ${fname%.md} ($full)" ;;
    codex)
      echo "Launching Codex: ${fname%.md}"
      codex "load ${fname%.md} ($full)" ;;
    *)
      echo "Unknown action: $action" >&2
      return 1 ;;
  esac
}
