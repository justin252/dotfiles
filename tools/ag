#!/usr/bin/env bash
# ag - agent session manager (stage 6-7 orchestrator)
# One command for parallel agent work: auto-creates worktrees, launches claude.
set -euo pipefail

usage() {
  cat <<'EOF'
ag - agent session manager
  ag <name>                 launch $AGENT_EXECUTOR (default claude) in worktree
  ag <name> -m MSG          launch with initial task
  ag <name> --cursor        cursor + agent in worktree
  ag <name> --claude        force using claude
  ag <name> --gemini        force using gemini
  ag <name> --codex         force using codex
  ag                        dashboard – all sessions, all repos (fzf)
  ag status                 cross-repo unified view
  ag kill <name>            kill session
  ag clean                  dead sessions + merged worktrees
EOF
}

main_repo_root() {
  local toplevel common
  toplevel=$(git rev-parse --show-toplevel 2>/dev/null) || return 1
  common=$(git rev-parse --git-common-dir 2>/dev/null)
  if [[ "$common" != ".git" && "$common" != "$(git rev-parse --git-dir 2>/dev/null)" ]]; then
    # Inside a worktree: common dir is /path/to/main/.git
    (cd "$(dirname "$common")" && pwd)
  else
    echo "$toplevel"
  fi
}

repo_name() {
  basename "$(main_repo_root 2>/dev/null)" 2>/dev/null || echo "local"
}

# Resolve worktree path: exact match → fuzzy → fzf disambiguate → auto-create
resolve_worktree() {
  local name="$1" auto_confirm="${2:-false}"
  local root repo dest
  root=$(main_repo_root) || { echo "not in a git repo" >&2; return 1; }
  repo=$(basename "$root")
  dest="${root}/../${repo}-wt-${name}"

  # exact match – fast path
  if [[ -d "$dest" ]]; then
    echo "$dest"; return
  fi

  # substring search across existing worktrees
  local matches=()
  while read -r wt; do
    [[ -z "$wt" ]] && continue
    [[ "$(basename "$wt")" == *"$name"* ]] && matches+=("$wt")
  done < <(git worktree list --porcelain 2>/dev/null | awk '/^worktree /{print $2}')

  if [[ ${#matches[@]} -eq 1 ]]; then
    echo "${matches[0]}"; return
  elif [[ ${#matches[@]} -gt 1 ]]; then
    if command -v fzf &>/dev/null; then
      local pick
      pick=$(printf '%s\n' "${matches[@]}" "+ create new: $name" | fzf --prompt="multiple matches> ") || return 1
      if [[ "$pick" != "+ create new: $name" ]]; then
        echo "$pick"; return
      fi
    else
      echo "multiple worktrees match '$name':" >&2
      printf '  %s\n' "${matches[@]}" >&2
      return 1
    fi
  fi

  # lock to prevent race between concurrent ag calls
  local lockdir="/tmp/ag-create-${name}.lock"
  if ! mkdir "$lockdir" 2>/dev/null; then
    echo "error: another ag instance is creating '$name'" >&2
    return 1
  fi
  trap "rmdir '$lockdir' 2>/dev/null" RETURN

  # auto-create worktree – confirm unless auto_confirm or non-TTY
  if [[ "$auto_confirm" != true && -t 0 ]]; then
    echo "will create worktree: $dest (branch: $name)" >&2
    read -r -p "continue? [Y/n] " reply
    [[ "$reply" =~ ^[Nn] ]] && return 1
  fi
  local default_branch
  default_branch=$(git symbolic-ref refs/remotes/origin/HEAD 2>/dev/null | sed 's|refs/remotes/origin/||')
  if [[ -z "$default_branch" ]]; then
    default_branch="main"
    echo "warning: origin/HEAD not set, assuming '$default_branch'" >&2
  fi
  if ! git fetch origin "$default_branch" --quiet 2>&1; then
    echo "error: git fetch failed – check network/auth" >&2
    return 1
  fi
  local output
  if ! output=$(git worktree add "$dest" -b "$name" "origin/$default_branch" 2>&1); then
    if echo "$output" | grep -q "already exists"; then
      echo "error: branch '$name' already exists – use a different name or: git branch -d $name" >&2
    else
      echo "error: failed to create worktree '$name': $output" >&2
    fi
    return 1
  fi
  echo "created worktree: $dest" >&2
  echo "$dest"
}

attach_or_switch() {
  local session="$1"
  if [[ -n "${TMUX:-}" ]]; then
    tmux switch-client -t "$session"
  else
    tmux attach-session -t "$session"
  fi
}

case "${1:-}" in
  -h|--help) usage ;;
  kill)
    if [[ "${2:-}" == "--help" || "${2:-}" == "-h" ]]; then
      echo "ag kill <name> – kill an agent session"; exit 0
    fi
    [[ -z "${2:-}" ]] && { echo "usage: ag kill <name>" >&2; exit 1; }
    local_repo=$(repo_name)
    tmux kill-session -t "ag-${local_repo}-${2}" 2>/dev/null && echo "killed ag-${local_repo}-${2}" || echo "no session ag-${local_repo}-${2}" >&2
    ;;
  status)
    json=false
    for arg in "${@:2}"; do
      case "$arg" in
        --help|-h) echo "ag status – show all agent sessions across repos"
                   echo "  --json    machine-readable output"
                   exit 0 ;;
        --json) json=true ;;
      esac
    done
    # cross-repo: iterate all ag-* tmux sessions
    sessions_list=$(tmux list-sessions -F '#{session_name}' 2>/dev/null | grep '^ag-' || true)
    if [[ -z "$sessions_list" ]]; then
      [[ "$json" == true ]] && echo "[]" || echo "no agent sessions"
      exit 0
    fi

    [[ "$json" == false ]] && printf "%-25s %-25s %-10s %s\n" "SESSION" "BRANCH" "STATUS" "PR"

    # collect session info, fire gh calls in parallel
    tmpdir=$(mktemp -d)
    trap "rm -rf '$tmpdir'" EXIT
    while read -r sess; do
      wt_path=$(tmux display-message -t "$sess" -p '#{pane_current_path}' 2>/dev/null) || continue
      branch=$(git -C "$wt_path" rev-parse --abbrev-ref HEAD 2>/dev/null || echo "-")
      pane_cmd=$(tmux display-message -t "$sess" -p '#{pane_current_command}' 2>/dev/null)
      if [[ "$pane_cmd" == "zsh" || "$pane_cmd" == "bash" ]]; then
        state="idle"
      else
        state="active"
      fi
      # extract slug: ag-<repo>-<slug>
      tmp="${sess#ag-}"
      slug="${tmp#*-}"
      echo "$sess $branch $state $slug" >> "$tmpdir/sessions"
      if [[ "$branch" != "-" ]]; then
        (gh pr list --head "$branch" --no-interactive --json state --jq '.[0].state // "-"' 2>/dev/null || echo "-") > "$tmpdir/pr-${sess}" &
      else
        echo "-" > "$tmpdir/pr-${sess}"
      fi
    done <<< "$sessions_list"
    wait

    # print results
    if [[ "$json" == true ]]; then
      echo "["
      first=true
      while read -r sess branch state slug; do
        pr_state=$(cat "$tmpdir/pr-${sess}" 2>/dev/null || echo "-")
        $first || echo ","
        printf '  {"name":"%s","session":"%s","branch":"%s","state":"%s","pr":"%s"}' \
          "$slug" "$sess" "$branch" "$state" "$pr_state"
        first=false
      done < "$tmpdir/sessions"
      echo ""
      echo "]"
    else
      while read -r sess branch state slug; do
        pr_state=$(cat "$tmpdir/pr-${sess}" 2>/dev/null || echo "-")
        printf "%-25s %-25s %-10s %s\n" "$sess" "$branch" "$state" "$pr_state"
      done < "$tmpdir/sessions"
    fi
    ;;
  clean)
    force=false
    for arg in "${@:2}"; do
      case "$arg" in
        --help|-h) echo "ag clean – kill dead sessions + remove merged worktrees"; exit 0 ;;
        --force|-f) force=true ;;
      esac
    done
    # kill dead sessions
    echo "=== dead sessions ==="
    found_dead=false
    while read -r sess; do
      pane_cmd=$(tmux display-message -t "$sess" -p '#{pane_current_command}' 2>/dev/null)
      if [[ "$pane_cmd" == "zsh" || "$pane_cmd" == "bash" ]]; then
        echo "killing dead session: $sess"
        tmux kill-session -t "$sess"
        found_dead=true
      fi
    done < <(tmux list-sessions -F '#{session_name}' 2>/dev/null | grep '^ag-')
    $found_dead || echo "  (none)"

    # offer to remove merged worktrees (current repo)
    if main_repo_root &>/dev/null; then
      root=$(main_repo_root)
      repo=$(basename "$root")
      echo ""
      echo "=== merged worktrees ($(repo_name)) ==="
      to_remove=()
      while read -r wt_path; do
        [[ "$wt_path" == "$root" ]] && continue
        branch=$(git -C "$wt_path" rev-parse --abbrev-ref HEAD 2>/dev/null)
        name=$(basename "$wt_path")
        merged=$(gh pr list --head "$branch" --state merged --no-interactive --json number --jq '.[0].number // empty' 2>/dev/null)
        if [[ -n "$merged" ]]; then
          echo "  $name ($branch) – PR #$merged merged"
          to_remove+=("$name")
        fi
      done < <(git worktree list --porcelain 2>/dev/null | awk '/^worktree /{print $2}')

      if [[ ${#to_remove[@]} -gt 0 ]]; then
        echo ""
        if [[ "$force" == true ]]; then
          reply="y"
        elif [[ -t 0 ]]; then
          read -r -p "Remove these merged worktrees? [y/N] " reply
        else
          echo "skipping prompt (not a TTY). Use 'ag clean --force'." >&2
          reply="n"
        fi
        if [[ "$reply" =~ ^[Yy] ]]; then
          for name in "${to_remove[@]}"; do
            tmux kill-session -t "ag-${repo}-${name}" 2>/dev/null
            if git worktree remove "$name" 2>/dev/null; then
              echo "removed $name"
            else
              echo "  failed to remove $name (dirty or locked?)" >&2
            fi
          done
        fi
      else
        echo "  (none)"
      fi
    fi
    ;;
  "")
    # dashboard: all ag-* sessions across all repos
    sessions=$(tmux list-sessions -F '#{session_name}  (#{session_windows} windows, #{?session_attached,attached,detached})' 2>/dev/null | grep '^ag-' || true)
    [[ -z "${sessions:-}" ]] && { echo "no agent sessions"; exit 0; }
    if command -v fzf &>/dev/null; then
      pick=$(echo "$sessions" | fzf --prompt="agent> " | awk '{print $1}') || exit 0
      attach_or_switch "$pick"
    else
      echo "$sessions"
    fi
    ;;
  *)
    # launch: ag <name> [flags]
    name="$1"
    if [[ "$name" == -* ]]; then
      echo "error: name cannot start with '-': $name" >&2
      echo "run 'ag --help' for usage" >&2
      exit 1
    fi
    if [[ ! "$name" =~ ^[a-zA-Z0-9][a-zA-Z0-9_-]*$ ]]; then
      echo "error: name must be alphanumeric (hyphens/underscores ok): $name" >&2
      exit 1
    fi
    shift

    cmd="${AGENT_EXECUTOR:-claude}"
    open_cursor=false
    prompt=""

    while [[ $# -gt 0 ]]; do
      case "$1" in
        --cursor) open_cursor=true; shift ;;
        --gemini) cmd="gemini"; shift ;;
        --claude) cmd="claude"; shift ;;
        --codex)  cmd="codex"; shift ;;
        -m)       [[ -z "${2:-}" ]] && { echo "usage: ag <name> -m MSG" >&2; exit 1; }
                  prompt="$2"; shift 2 ;;
        *)        echo "unknown flag: $1" >&2; exit 1 ;;
      esac
    done

    command -v "$cmd" >/dev/null 2>&1 || { echo "$cmd not found on PATH" >&2; exit 1; }

    auto_confirm=false
    [[ -n "$prompt" ]] && auto_confirm=true
    worktree=$(resolve_worktree "$name" "$auto_confirm") || exit 1
    local_repo=$(repo_name)
    session="ag-${local_repo}-${name}"

    # if session exists, just attach
    if tmux has-session -t "$session" 2>/dev/null; then
      echo "attaching to existing session: $session"
      attach_or_switch "$session"
      exit 0
    fi

    # open cursor in worktree if requested
    if [[ "$open_cursor" == true ]]; then
      if command -v cursor &>/dev/null; then
        cursor "$worktree" &
        echo "opened cursor: $worktree"
      else
        echo "cursor not found on PATH" >&2
      fi
    fi

    # create tmux session
    if ! tmux new-session -d -s "$session" -c "$worktree" 2>/dev/null; then
      echo "error: failed to create tmux session '$session'" >&2
      echo "cleaning up worktree..." >&2
      git worktree remove "$worktree" 2>/dev/null
      exit 1
    fi
    if [[ -n "$prompt" ]]; then
      # positional arg = first message in interactive session (not -p pipe mode)
      tmux send-keys -t "$session" "$cmd $(printf '%q' "$prompt")" Enter
    else
      tmux send-keys -t "$session" "$cmd" Enter
    fi

    # attach
    attach_or_switch "$session"
    ;;
esac
