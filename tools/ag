#!/usr/bin/env bash
# ag - agent session manager (stage 6-7 orchestrator)
# One command for parallel agent work: auto-creates worktrees, launches claude.
# category: agent
set -euo pipefail

# --no-input / AG_NO_INPUT: skip all interactive prompts
no_input=false
[[ "${AG_NO_INPUT:-}" == "1" ]] && no_input=true

usage() {
  cat <<'EOF'
ag - agent session manager
  ag run                    🦁 pick a plan (fzf) and run full pipeline
  ag run <plan>             smart resolve: slug, path, or partial match
  ag run -a                 pick from artifacts only
  ag run <plan> --skip review   skip pipeline stages
  ag <name>                 launch $AGENT_EXECUTOR (default claude) in worktree
  ag <name> -m MSG          launch with initial task
  ag <name> --cursor        cursor + agent in worktree
  ag <name> --claude        force using claude
  ag <name> --gemini        force using gemini
  ag <name> --codex         force using codex
  ag pr <number|url>        checkout PR into worktree + attach
  ag pr <number|url> -m MSG checkout PR + launch agent with task
  ag pr <number|url> --review  review PR diff with agent (no worktree)
  ag                        dashboard – all sessions, all repos (fzf)
  ag status                 cross-repo unified view
  ag kill <name>            kill session
  ag clean                  dead sessions + merged worktrees
  ag clean --all            kill all sessions + remove all worktrees + state
  ag clean --no-input       same, skip confirmation (also: --force)
  AG_NO_INPUT=1 ag ...      skip all prompts (for scripts/orchestrator)
EOF
}

main_repo_root() {
  local toplevel common
  toplevel=$(git rev-parse --show-toplevel 2>/dev/null) || return 1
  common=$(git rev-parse --git-common-dir 2>/dev/null)
  if [[ "$common" != ".git" && "$common" != "$(git rev-parse --git-dir 2>/dev/null)" ]]; then
    # Inside a worktree: common dir is /path/to/main/.git
    (cd "$(dirname "$common")" && pwd)
  else
    echo "$toplevel"
  fi
}

repo_name() {
  basename "$(main_repo_root 2>/dev/null)" 2>/dev/null || echo "local"
}

# Extract slug from tmux session, with fallback for older sessions
_ag_slug() {
  local sess="$1"
  local slug
  slug=$(tmux show-environment -t "$sess" AG_SLUG 2>/dev/null | sed 's/^AG_SLUG=//') || true
  if [[ -z "$slug" ]]; then
    # fallback: parse from session name (breaks on hyphenated repo names)
    local tmp="${sess#ag-}"
    slug="${tmp#*-}"
  fi
  echo "$slug"
}

# Extract branch from tmux session env, with fallback to git
_ag_branch() {
  local sess="$1" wt_path="${2:-}"
  local branch
  branch=$(tmux show-environment -t "$sess" AG_BRANCH 2>/dev/null | sed 's/^AG_BRANCH=//') || true
  if [[ -z "$branch" && -n "$wt_path" ]]; then
    branch=$(git -C "$wt_path" rev-parse --abbrev-ref HEAD 2>/dev/null || echo "")
  fi
  echo "$branch"
}

# Store session metadata in tmux environment
_ag_set_env() {
  local session="$1" slug="$2" repo="$3" branch="$4"
  tmux set-environment -t "$session" AG_SLUG "$slug" 2>/dev/null || true
  tmux set-environment -t "$session" AG_REPO "$repo" 2>/dev/null || true
  tmux set-environment -t "$session" AG_BRANCH "$branch" 2>/dev/null || true
}

attach_or_switch() {
  local session="$1"
  if [[ -n "${TMUX:-}" ]]; then
    tmux switch-client -t "$session"
  else
    tmux attach-session -t "$session"
  fi
}

case "${1:-}" in
  -h|--help) usage ;;
  run)
    if [[ "${2:-}" == "--help" || "${2:-}" == "-h" ]]; then
      cat <<'RUNEOF'
ag run – 🦁 full pipeline from plan.md to PR

Usage:
  ag run                     pick a plan (fzf) – all sources, sorted by last modified
  ag run -a                  pick from artifacts only
  ag run <plan>              smart resolve: slug, path, or partial match
  ag run <plan> --skip review --skip retro

Flags:
  -a, --artifacts               show only artifact plans in picker
  --codex, --claude, --gemini   override agent (default: plan frontmatter > $AGENT_EXECUTOR > claude)
  --skip <stage>                skip pipeline stage (review, retro, fix). repeatable.
  --dry-run                     show what would happen, don't launch
  --json                        machine-readable output

Examples:
  ag run                      interactive plan picker (all sources)
  ag run -a                   artifacts only
  ag run auth                 finds ~/.agents/artifacts/auth/plan.md
  ag run auth --codex         use codex instead of claude
  ag run auth --skip review   skip review stage
  ag run ./plan.md            explicit plan file
RUNEOF
      exit 0
    fi

    run_cmd=""
    run_dry=false
    run_json=false
    run_input=""
    run_skip=()
    run_artifacts_only=false

    _skip_next=false
    for arg in "${@:2}"; do
      if [[ "$_skip_next" == true ]]; then
        case "$arg" in
          review|retro|fix) run_skip+=("$arg") ;;
          *) echo "invalid --skip stage: $arg (valid: review, retro, fix)" >&2; exit 1 ;;
        esac
        _skip_next=false
        continue
      fi
      case "$arg" in
        --codex)       run_cmd="codex" ;;
        --claude)      run_cmd="claude" ;;
        --gemini)      run_cmd="gemini" ;;
        --dry-run)     run_dry=true ;;
        --json)        run_json=true ;;
        --skip)        _skip_next=true ;;
        --skip=*)      _sv="${arg#--skip=}"
                       case "$_sv" in
                         review|retro|fix) run_skip+=("$_sv") ;;
                         *) echo "invalid --skip stage: $_sv (valid: review, retro, fix)" >&2; exit 1 ;;
                       esac ;;
        -a|--artifacts) run_artifacts_only=true ;;
        -*)            echo "unknown flag: $arg" >&2; exit 1 ;;
        *)             [[ -z "$run_input" ]] && run_input="$arg" || { echo "unexpected arg: $arg" >&2; exit 1; } ;;
      esac
    done

    # --- helpers ---

    _run_relative_time() {
      local mod_ts="$1"
      local now_ts; now_ts=$(date +%s)
      local diff_s=$((now_ts - mod_ts))
      if (( diff_s < 60 )); then echo "now"
      elif (( diff_s < 3600 )); then echo "$((diff_s / 60))m ago"
      elif (( diff_s < 86400 )); then echo "$((diff_s / 3600))h ago"
      else echo "$((diff_s / 86400))d ago"
      fi
    }

    _run_file_mtime() {
      stat -c '%Y' "$1" 2>/dev/null && return
      stat -f '%m' "$1" 2>/dev/null && return
      echo 0
    }

    _run_plan_title() {
      local f="$1"
      local title
      title=$(sed -n '/^---$/,/^---$/{ /^name:/{ s/^name: *//; p; q; } }' "$f" 2>/dev/null)
      [[ -n "$title" ]] && { echo "$title"; return; }
      title=$(grep -m1 '^# ' "$f" 2>/dev/null | sed 's/^# //')
      [[ -n "$title" ]] && { echo "$title"; return; }
      echo "-"
    }

    _run_build_line() {
      local plan_path="$1" source_tag="$2"
      local topic_dir slug title total done artifacts mod_ts mod_rel status

      topic_dir=$(dirname "$plan_path")
      slug=$(basename "$topic_dir")
      # for cursor/claude plans, use filename as slug
      if [[ "$source_tag" != "art" ]]; then
        slug=$(basename "$plan_path" .md)
        slug="${slug%.plan}"
      fi
      # truncate long slugs
      if [[ ${#slug} -gt 24 ]]; then
        slug="${slug:0:21}..."
      fi

      title=$(_run_plan_title "$plan_path")
      if [[ ${#title} -gt 32 ]]; then
        title="${title:0:29}..."
      fi

      if [[ "$source_tag" == "art" ]]; then
        total=$(grep -cE '^\s*- \[[ x]\]' "$plan_path" 2>/dev/null || echo 0)
        done=$(grep -cE '^\s*- \[x\]' "$plan_path" 2>/dev/null || echo 0)
        artifacts=$(find "$topic_dir" -maxdepth 1 -name '*.md' ! -name plan.md 2>/dev/null | wc -l | tr -d ' ')
        local phase_file="$HOME/.agents/state/$slug/phase"
        if [[ -f "$phase_file" ]]; then
          local phase; phase=$(cat "$phase_file" 2>/dev/null)
          case "$phase" in
            executing) status="🦊 run" ;;
            shipping)  status="🦅 ship" ;;
            reviewing) status="🦉 rev" ;;
            fixing)    status="🔧 fix" ;;
            learning)  status="🐘 learn" ;;
            done)      status="✅ done" ;;
            *)         status="ready" ;;
          esac
        else
          status="ready"
        fi
      else
        total="-"; done="-"; artifacts="-"; status="-"
      fi

      mod_ts=$(_run_file_mtime "$plan_path")
      mod_rel=$(_run_relative_time "$mod_ts")

      printf "%s\t%-24s\t%-32s\t[%-6s]\t%s/%s\t%s art\t%s\n" \
        "$mod_ts" "$slug" "$title" "$source_tag" "$done" "$total" "$artifacts" "$mod_rel"
    }

    _run_collect_plans() {
      local artifacts_only="$1"
      local cutoff_ts raw=""
      cutoff_ts=$(( $(date +%s) - 14 * 86400 ))

      # Phase 1: cheap – just mtime + path + source (one stat per file)
      for p in "$HOME/.agents/artifacts"/*/plan.md; do
        [[ -f "$p" ]] || continue
        local mt; mt=$(_run_file_mtime "$p")
        raw+="${mt}"$'\t'"${p}"$'\t'"art"$'\n'
      done

      if [[ "$artifacts_only" != true ]]; then
        for p in "$HOME/.cursor/plans"/*.plan.md; do
          [[ -f "$p" ]] || continue
          local mt; mt=$(_run_file_mtime "$p")
          (( mt < cutoff_ts )) && continue
          raw+="${mt}"$'\t'"${p}"$'\t'"cursor"$'\n'
        done

        for p in "$HOME/.claude/plans"/*.md "$HOME/.claude/plans/saved"/*.md; do
          [[ -f "$p" ]] || continue
          local mt; mt=$(_run_file_mtime "$p")
          (( mt < cutoff_ts )) && continue
          raw+="${mt}"$'\t'"${p}"$'\t'"claude"$'\n'
        done
      fi

      # Phase 2: top 30 by mtime, then expensive display build
      local lines=""
      while IFS=$'\t' read -r _mt path src; do
        [[ -z "$path" ]] && continue
        lines+="$(_run_build_line "$path" "$src")"$'\n'
      done < <(printf '%s' "$raw" | sort -t$'\t' -k1 -rn | head -30)

      printf '%s' "$lines" | sort -t$'\t' -k1 -rn | cut -f2-
    }

    # --- plan resolution ---

    _run_resolve_plan() {
      local input="$1"
      run_plan=""
      run_topic=""

      # 1. explicit file path
      if [[ -f "$input" ]]; then
        run_plan="$(cd "$(dirname "$input")" && pwd)/$(basename "$input")"
        local pdir; pdir=$(basename "$(dirname "$run_plan")")
        if [[ "$pdir" == "plans" || "$pdir" == "saved" ]]; then
          run_topic=$(basename "$run_plan" .md)
          run_topic="${run_topic%.plan}"
        else
          run_topic="$pdir"
        fi
        return 0
      fi

      # 2. exact artifact slug
      if [[ -f "$HOME/.agents/artifacts/$input/plan.md" ]]; then
        run_topic="$input"
        run_plan="$HOME/.agents/artifacts/$run_topic/plan.md"
        return 0
      fi

      # 3. partial match across artifacts
      local matches=()
      for d in "$HOME/.agents/artifacts"/*/plan.md; do
        [[ -f "$d" ]] || continue
        local s; s=$(basename "$(dirname "$d")")
        [[ "$s" == *"$input"* ]] && matches+=("$d")
      done

      if [[ ${#matches[@]} -eq 1 ]]; then
        run_plan="${matches[0]}"
        run_topic=$(basename "$(dirname "$run_plan")")
        return 0
      elif [[ ${#matches[@]} -gt 1 ]]; then
        if command -v fzf &>/dev/null; then
          local lines=""
          for m in "${matches[@]}"; do
            lines+="$(_run_build_line "$m" "art")"$'\n'
          done
          local pick
          pick=$(printf '%s' "$lines" | sort -t$'\t' -k1 -rn | cut -f2- | fzf \
            --prompt="run> " --query="$input" \
            --header="multiple matches" \
            --preview="cat \$HOME/.agents/artifacts/{1}/plan.md" \
            | awk '{print $1}') || exit 0
          run_topic="$pick"
          run_plan="$HOME/.agents/artifacts/$pick/plan.md"
          return 0
        fi
        echo "error: multiple plans match '$input':" >&2
        for m in "${matches[@]}"; do
          echo "  $(basename "$(dirname "$m")")" >&2
        done
        exit 1
      fi

      echo "error: no plan found for '$input'" >&2
      echo "  try: ag run          (interactive picker)" >&2
      echo "  or:  ag run ./path   (explicit file)" >&2
      exit 1
    }

    run_plan=""
    run_topic=""

    if [[ -z "$run_input" ]]; then
      # interactive fzf picker
      if ! command -v fzf &>/dev/null; then
        echo "usage: ag run <plan> (install fzf for interactive picker)" >&2; exit 1
      fi
      plan_lines=$(_run_collect_plans "$run_artifacts_only")
      if [[ -z "$plan_lines" ]]; then
        echo "no plans found" >&2; exit 1
      fi
      pick=$(echo "$plan_lines" | fzf \
        --prompt="run> " \
        --header="enter: launch  ctrl-e: edit  |  SLUG  TITLE  [SOURCE]  TASKS  ART  MODIFIED" \
        --delimiter=$'\t' \
        --with-nth=1.. \
        --preview='
          slug={1}; src=$(echo {3} | tr -d "[] ")
          slug=$(echo "$slug" | sed "s/^ *//;s/ *$//")
          if [ "$src" = "art" ]; then
            cat "$HOME/.agents/artifacts/$slug/plan.md" 2>/dev/null
          elif [ "$src" = "cursor" ]; then
            cat "$HOME/.cursor/plans/${slug}.plan.md" 2>/dev/null
          elif [ "$src" = "claude" ]; then
            cat "$HOME/.claude/plans/${slug}.md" 2>/dev/null || cat "$HOME/.claude/plans/saved/${slug}.md" 2>/dev/null
          fi
        ' \
        --preview-window=right:50% \
        --bind="ctrl-e:execute(
          slug={1}; src=\$(echo {3} | tr -d '[] ')
          slug=\$(echo \"\$slug\" | sed 's/^ *//;s/ *\$//')
          if [ \"\$src\" = 'art' ]; then
            \${EDITOR:-vim} \"\$HOME/.agents/artifacts/\$slug/plan.md\"
          elif [ \"\$src\" = 'cursor' ]; then
            \${EDITOR:-vim} \"\$HOME/.cursor/plans/\${slug}.plan.md\"
          elif [ \"\$src\" = 'claude' ]; then
            f=\"\$HOME/.claude/plans/\${slug}.md\"
            [ -f \"\$f\" ] || f=\"\$HOME/.claude/plans/saved/\${slug}.md\"
            \${EDITOR:-vim} \"\$f\"
          fi
        )" \
      ) || exit 0

      picked_slug=$(echo "$pick" | awk -F'\t' '{print $1}' | sed 's/^ *//;s/ *$//')
      picked_src=$(echo "$pick" | awk -F'\t' '{print $3}' | tr -d '[] ')

      case "$picked_src" in
        art)
          run_topic="$picked_slug"
          run_plan="$HOME/.agents/artifacts/$picked_slug/plan.md"
          ;;
        cursor)
          run_plan="$HOME/.cursor/plans/${picked_slug}.plan.md"
          run_topic="$picked_slug"
          ;;
        claude)
          run_plan="$HOME/.claude/plans/${picked_slug}.md"
          [[ -f "$run_plan" ]] || run_plan="$HOME/.claude/plans/saved/${picked_slug}.md"
          run_topic="$picked_slug"
          ;;
      esac
    else
      _run_resolve_plan "$run_input"
    fi

    # read plan frontmatter for agent preference (CLI flag wins)
    if [[ -z "$run_cmd" && -f "$run_plan" ]]; then
      fm_agent=$(sed -n '/^---$/,/^---$/{ /^agent:/{ s/^agent: *//; p; q; } }' "$run_plan" 2>/dev/null || true)
      [[ -n "$fm_agent" ]] && run_cmd="$fm_agent"
    fi
    [[ -z "$run_cmd" ]] && run_cmd="${AGENT_EXECUTOR:-claude}"
    command -v "$run_cmd" >/dev/null 2>&1 || { echo "$run_cmd not found on PATH" >&2; exit 1; }

    # merge skip stages: CLI --skip + plan frontmatter
    fm_skip=$(sed -n '/^---$/,/^---$/{ /^skip:/{ s/^skip: *\[//; s/\].*//; s/,/ /g; p; q; } }' "$run_plan" 2>/dev/null || true)
    for s in $fm_skip; do
      s=$(echo "$s" | tr -d ' ')
      _found=false
      for existing in "${run_skip[@]:-}"; do
        [[ "$existing" == "$s" ]] && _found=true
      done
      [[ "$_found" == false ]] && run_skip+=("$s")
    done
    skip_str=""
    if [[ ${#run_skip[@]} -gt 0 ]]; then
      skip_str=$(IFS=,; echo "${run_skip[*]}")
    fi

    # count linked artifacts (artifact plans only)
    topic_dir=$(dirname "$run_plan")
    artifact_count=0
    if [[ "$topic_dir" == *"/artifacts/"* ]]; then
      artifact_count=$(find "$topic_dir" -maxdepth 1 -name '*.md' ! -name plan.md 2>/dev/null | wc -l | tr -d ' ')
    fi

    local_repo=$(repo_name)
    session="ag-${local_repo}-${run_topic}"

    # --dry-run
    if [[ "$run_dry" == true ]]; then
      if [[ "$run_json" == true ]]; then
        jq -n \
          --arg topic "$run_topic" --arg plan "$run_plan" \
          --arg agent "$run_cmd" --arg session "$session" \
          --arg repo "$local_repo" --arg skip "$skip_str" \
          --argjson artifacts "$artifact_count" \
          '{topic:$topic, plan:$plan, agent:$agent, session:$session, repo:$repo, skip:$skip, artifacts:$artifacts}'
      else
        echo "🎪 ag run (dry-run): $run_topic" >&2
        echo "  📋 plan: $run_plan" >&2
        echo "  🌿 branch: $run_topic" >&2
        echo "  💻 session: $session" >&2
        echo "  🤖 agent: $run_cmd" >&2
        [[ -n "$skip_str" ]] && echo "  ⏭  skip: $skip_str" >&2
        (( artifact_count > 0 )) && echo "  📎 artifacts: $artifact_count linked" >&2
      fi
      exit 0
    fi

    echo "🎪 ag run: $run_topic" >&2
    echo "  📋 plan: $run_plan" >&2

    # create worktree + session
    worktree=$(WT_CREATE_MODE=new ~/tools/wt-resolve "$run_topic") || exit 1

    if tmux has-session -t "$session" 2>/dev/null; then
      echo "session already exists: $session" >&2
      echo "  ag $run_topic    attach" >&2
      echo "  ag kill $run_topic    kill first" >&2
      exit 1
    fi

    if ! tmux new-session -d -s "$session" -c "$worktree" 2>/dev/null; then
      echo "error: failed to create tmux session '$session'" >&2; exit 1
    fi
    _ag_set_env "$session" "$run_topic" "$local_repo" "$run_topic"
    tmux set-environment -t "$session" AG_BACKGROUND 1
    [[ -n "$skip_str" ]] && tmux set-environment -t "$session" AG_SKIP_STAGES "$skip_str"

    # create state dir for phase tracking
    mkdir -p "$HOME/.agents/state/$run_topic"
    echo "starting" > "$HOME/.agents/state/$run_topic/phase"

    # launch agent with /run
    run_prompt="/run $run_plan"
    tmux send-keys -t "$session" "$run_cmd $(printf '%q' "$run_prompt")" Enter

    echo "  🌿 branch: $run_topic" >&2
    echo "  💻 session: $session" >&2
    echo "  🤖 agent: $run_cmd" >&2
    [[ -n "$skip_str" ]] && echo "  ⏭  skip: $skip_str" >&2
    (( artifact_count > 0 )) && echo "  📎 artifacts: $artifact_count linked" >&2
    echo "" >&2
    echo "  ag $run_topic    attach to session" >&2
    echo "  ag status        see all agents" >&2
    echo "  ag               pick from list" >&2

    if [[ "$run_json" == true ]]; then
      jq -n \
        --arg topic "$run_topic" --arg plan "$run_plan" \
        --arg agent "$run_cmd" --arg session "$session" \
        --arg repo "$local_repo" --arg worktree "$worktree" \
        --arg skip "$skip_str" --argjson artifacts "$artifact_count" \
        '{topic:$topic, plan:$plan, agent:$agent, session:$session, repo:$repo, worktree:$worktree, skip:$skip, artifacts:$artifacts}'
    fi
    ;;
  pr)
    if [[ "${2:-}" == "--help" || "${2:-}" == "-h" ]]; then
      echo "ag pr – checkout PR into worktree + attach"
      echo "  ag pr 90                                    local repo PR"
      echo "  ag pr https://github.com/org/repo/pull/90   any repo PR"
      echo "  ag pr 90 -m MSG                             checkout + launch agent"
      echo "  ag pr 90 --review                           review diff with agent (no worktree)"
      exit 0
    fi
    [[ -z "${2:-}" ]] && { echo "usage: ag pr <number|url>" >&2; exit 1; }

    # smart input: URL or number
    pr_input="$2"
    shift 2
    gh_repo_flag=""

    if [[ "$pr_input" =~ ^https://github\.com/([^/]+/[^/]+)/pull/([0-9]+) ]]; then
      # URL: extract org/repo and number
      pr_repo="${BASH_REMATCH[1]}"
      pr_number="${BASH_REMATCH[2]}"
      gh_repo_flag="--repo $pr_repo"
    elif [[ "$pr_input" =~ ^[0-9]+$ ]]; then
      pr_number="$pr_input"
    else
      echo "error: expected PR number or GitHub PR URL" >&2
      echo "  ag pr 90" >&2
      echo "  ag pr https://github.com/org/repo/pull/90" >&2
      exit 1
    fi

    # get PR metadata
    pr_json=$(gh pr view "$pr_number" $gh_repo_flag --json headRefName,title,url,state 2>/dev/null) || {
      echo "error: could not find PR #$pr_number" >&2; exit 1
    }
    pr_branch=$(echo "$pr_json" | jq -r '.headRefName')
    pr_title=$(echo "$pr_json" | jq -r '.title')
    pr_url=$(echo "$pr_json" | jq -r '.url')

    # parse flags
    pr_prompt=""
    pr_review=false
    while [[ $# -gt 0 ]]; do
      case "$1" in
        -m) [[ -z "${2:-}" ]] && { echo "usage: ag pr <number> -m MSG" >&2; exit 1; }
            pr_prompt="$2"; shift 2 ;;
        --review) pr_review=true; shift ;;
        *) echo "unknown flag: $1" >&2; exit 1 ;;
      esac
    done

    # --review: no worktree, just pipe diff to agent (works for any repo via API)
    if [[ "$pr_review" == true ]]; then
      echo "reviewing PR #$pr_number: $pr_title"
      echo "  $pr_url"
      cmd="${AGENT_EXECUTOR:-claude}"
      exec $cmd "Review this PR: $pr_title ($pr_url). Here is the diff: $(gh pr diff "$pr_number" $gh_repo_flag 2>/dev/null)"
    fi

    # checkout mode: need local repo
    if [[ -n "$gh_repo_flag" ]]; then
      # cross-repo PR: check if we have it cloned locally
      # look in common locations: ~/<repo>, ~/code/<repo>
      pr_repo_name="${pr_repo#*/}"
      local_repo=""
      for candidate in "$HOME/$pr_repo_name" "$HOME/code/$pr_repo_name" "$HOME/src/$pr_repo_name"; do
        if [[ -d "$candidate/.git" ]]; then
          local_repo="$candidate"
          break
        fi
      done
      if [[ -z "$local_repo" ]]; then
        echo "error: repo '$pr_repo' not cloned locally" >&2
        echo "  git clone git@github.com:${pr_repo}.git ~/$pr_repo_name" >&2
        echo "  then retry: ag pr $pr_input" >&2
        exit 1
      fi
      # operate from the local repo
      cd "$local_repo"
    fi

    # resolve worktree via wt-resolve (handles fetch, existing worktree, creation)
    dest=$(~/tools/wt-resolve "$pr_branch") || exit 1
    slug=$(echo "$pr_branch" | tr '/' '-')
    local_repo=$(repo_name)
    session="ag-${local_repo}-${slug}"

    if tmux has-session -t "$session" 2>/dev/null; then
      echo "attaching to $slug (PR #$pr_number)"
      echo "  ag             switch to another session"
      echo "  ag status      see all agents"
      echo "  C-a d          detach back to terminal"
      attach_or_switch "$session"
      exit 0
    fi

    # create tmux session + store metadata
    if ! tmux new-session -d -s "$session" -c "$dest" 2>/dev/null; then
      echo "error: failed to create tmux session '$session'" >&2; exit 1
    fi
    _ag_set_env "$session" "$slug" "$local_repo" "$pr_branch"

    if [[ -n "$pr_prompt" ]]; then
      cmd="${AGENT_EXECUTOR:-claude}"
      tmux send-keys -t "$session" "$cmd $(printf '%q' "$pr_prompt")" Enter
      echo "launched $slug (PR #$pr_number: $pr_title)"
      echo "  $pr_url"
      echo "  ag $slug       attach to session"
      echo "  ag status      see all agents"
      echo "  ag             pick from list"
    else
      tmux send-keys -t "$session" "${AGENT_EXECUTOR:-claude}" Enter
      echo "attaching to $slug (PR #$pr_number)"
      echo "  $pr_url"
      echo "  ag             switch to another session"
      echo "  ag status      see all agents"
      echo "  C-a d          detach back to terminal"
      attach_or_switch "$session"
    fi
    ;;
  kill)
    if [[ "${2:-}" == "--help" || "${2:-}" == "-h" ]]; then
      echo "ag kill <name> – kill an agent session"; exit 0
    fi
    [[ -z "${2:-}" ]] && { echo "usage: ag kill <name>" >&2; exit 1; }
    local_repo=$(repo_name)
    tmux kill-session -t "ag-${local_repo}-${2}" 2>/dev/null && echo "killed ag-${local_repo}-${2}" || echo "no session ag-${local_repo}-${2}" >&2
    ;;
  status)
    json=false
    for arg in "${@:2}"; do
      case "$arg" in
        --help|-h) echo "ag status – show all agent sessions across repos"
                   echo "  --json    machine-readable output"
                   exit 0 ;;
        --json) json=true ;;
      esac
    done
    # cross-repo: iterate all ag-* tmux sessions
    sessions_list=$(tmux list-sessions -F '#{session_name}' 2>/dev/null | grep '^ag-' || true)
    if [[ -z "$sessions_list" ]]; then
      [[ "$json" == true ]] && echo "[]" || echo "no agent sessions"
      exit 0
    fi

    [[ "$json" == false ]] && printf "%-20s %-14s %-20s %s\n" "NAME" "STATUS" "BRANCH" "PR"

    # collect session info, fire gh calls in parallel
    tmpdir=$(mktemp -d)
    trap "rm -rf '$tmpdir'" EXIT
    while read -r sess; do
      wt_path=$(tmux display-message -t "$sess" -p '#{pane_current_path}' 2>/dev/null) || continue
      branch=$(_ag_branch "$sess" "$wt_path")
      [[ -z "$branch" ]] && branch="-"
      pane_cmd=$(tmux display-message -t "$sess" -p '#{pane_current_command}' 2>/dev/null)
      if [[ "$pane_cmd" == "zsh" || "$pane_cmd" == "bash" ]]; then
        state="idle"
      else
        state="active"
      fi
      slug=$(_ag_slug "$sess")
      # overlay /run phase state + task progress if available
      phase_file="$HOME/.agents/state/$slug/phase"
      tasks_file="$HOME/.agents/state/$slug/tasks"
      tasks_info=""
      if [[ -f "$phase_file" ]]; then
        phase=$(cat "$phase_file" 2>/dev/null)
        [[ -n "$phase" && "$phase" != "done" ]] && state="$phase"
        [[ "$phase" == "done" ]] && state="done"
      fi
      [[ -f "$tasks_file" ]] && tasks_info=$(cat "$tasks_file" 2>/dev/null)
      echo "$sess $branch $state $slug $tasks_info" >> "$tmpdir/sessions"
      if [[ "$branch" != "-" ]]; then
        (gh pr list --head "$branch" --no-interactive --json state --jq '.[0].state // "-"' 2>/dev/null || echo "-") > "$tmpdir/pr-${sess}" &
      else
        echo "-" > "$tmpdir/pr-${sess}"
      fi
    done <<< "$sessions_list"
    wait

    # print results
    if [[ "$json" == true ]]; then
      echo "["
      first=true
      while read -r sess branch state slug tasks_info; do
        pr_state=$(cat "$tmpdir/pr-${sess}" 2>/dev/null || echo "-")
        $first || echo ","
        printf '  {"name":"%s","session":"%s","branch":"%s","state":"%s","pr":"%s","tasks":"%s"}' \
          "$slug" "$sess" "$branch" "$state" "$pr_state" "${tasks_info:-}"
        first=false
      done < "$tmpdir/sessions"
      echo ""
      echo "]"
    else
      while read -r sess branch state slug tasks_info; do
        pr_state=$(cat "$tmpdir/pr-${sess}" 2>/dev/null || echo "-")
        case "$state" in
          executing) display_state="🦊 executing" ;;
          shipping)  display_state="🦅 shipping" ;;
          reviewing) display_state="🦉 reviewing" ;;
          fixing)    display_state="🔧 fixing" ;;
          learning)  display_state="🐘 learning" ;;
          done)      display_state="✅ done" ;;
          active)    display_state="● active" ;;
          idle)      display_state="○ idle" ;;
          *)         display_state="$state" ;;
        esac
        [[ -n "$tasks_info" ]] && display_state="$display_state ($tasks_info)"
        printf "%-20s %-18s %-20s %s\n" "$slug" "$display_state" "$branch" "$pr_state"
      done < "$tmpdir/sessions"
    fi
    ;;
  clean)
    force=false
    clean_all=false
    [[ "$no_input" == true ]] && force=true
    for arg in "${@:2}"; do
      case "$arg" in
        --help|-h)
          echo "ag clean – comprehensive cleanup of agent resources"
          echo "  kills dead sessions, removes merged worktrees,"
          echo "  finds orphan worktrees/sessions, cleans state files"
          echo "  --all               nuclear: kill all sessions + worktrees + state"
          echo "  --force/--no-input  skip confirmation prompts"
          exit 0 ;;
        --all) clean_all=true ;;
        --force|-f|--no-input) force=true ;;
      esac
    done

    if [[ "$clean_all" == true ]]; then
      # nuclear: kill all ag sessions, remove all worktrees, clean all state
      ag_sessions=$(tmux list-sessions -F '#{session_name}' 2>/dev/null | grep '^ag-' || true)
      sess_count=0
      [[ -n "$ag_sessions" ]] && sess_count=$(echo "$ag_sessions" | wc -l | tr -d ' ')
      state_count=0
      if [[ -d "$HOME/.agents/state" ]]; then
        state_count=$(find "$HOME/.agents/state" -mindepth 1 -maxdepth 1 -type d 2>/dev/null | wc -l | tr -d ' ')
      fi
      echo "ag clean --all:"
      echo "  $sess_count ag session(s)"
      echo "  state dirs: $state_count"
      # show worktree count (delegate to wt for the actual list)
      if [[ "$force" != true ]]; then
        [[ -t 0 ]] || { echo "use --force or run interactively" >&2; exit 1; }
        read -r -p "remove everything? [y/N] " reply
        [[ ! "$reply" =~ ^[Yy] ]] && exit 0
      fi
      # 1. kill all ag sessions
      if [[ -n "$ag_sessions" ]]; then
        while read -r sess; do
          tmux kill-session -t "$sess" 2>/dev/null
          echo "  killed $sess"
        done <<< "$ag_sessions"
      fi
      # 2. remove all worktrees (delegate to wt clean --all --force)
      # wt is a shell function; source the zshrc approach via inline logic
      if main_repo_root &>/dev/null; then
        root=$(main_repo_root)
        while read -r wt_path; do
          [[ "$wt_path" == "$root" ]] && continue
          branch=$(git -C "$wt_path" rev-parse --abbrev-ref HEAD 2>/dev/null) || true
          if git worktree remove "$wt_path" --force 2>/dev/null; then
            [[ -n "$branch" && "$branch" != "HEAD" ]] && git -C "$root" branch -d "$branch" 2>/dev/null || true
            echo "  removed $(basename "$wt_path")"
          else
            echo "  failed: $(basename "$wt_path")" >&2
          fi
        done < <(git worktree list --porcelain 2>/dev/null | awk '/^worktree /{print $2}')
        git worktree prune 2>/dev/null
      fi
      # 3. clean all state files
      if [[ -d "$HOME/.agents/state" ]]; then
        rm -rf "$HOME/.agents/state"/*/
        echo "  cleaned state files"
      fi
      exit 0
    fi

    # standard cleanup: categorized
    to_remove=()

    # 1. dead sessions (agent exited, sitting at shell prompt)
    echo "=== dead sessions ==="
    found_dead=false
    ag_sessions=$(tmux list-sessions -F '#{session_name}' 2>/dev/null | grep '^ag-' || true)
    if [[ -n "$ag_sessions" ]]; then
      while read -r sess; do
        pane_cmd=$(tmux display-message -t "$sess" -p '#{pane_current_command}' 2>/dev/null)
        if [[ "$pane_cmd" == "zsh" || "$pane_cmd" == "bash" ]]; then
          slug=$(_ag_slug "$sess")
          echo "  $slug (session idle)"
          tmux kill-session -t "$sess"
          found_dead=true
        fi
      done <<< "$ag_sessions"
    fi
    $found_dead || echo "  (none)"

    # 2. orphan sessions (tmux session exists but worktree is gone)
    echo ""
    echo "=== orphan sessions (no worktree) ==="
    found_orphan_sess=false
    ag_sessions=$(tmux list-sessions -F '#{session_name}' 2>/dev/null | grep '^ag-' || true)
    if [[ -n "$ag_sessions" ]]; then
      while read -r sess; do
        wt_path=$(tmux display-message -t "$sess" -p '#{pane_current_path}' 2>/dev/null || echo "")
        if [[ -z "$wt_path" || ! -d "$wt_path/.git" ]]; then
          slug=$(_ag_slug "$sess")
          echo "  $slug (worktree missing)"
          tmux kill-session -t "$sess"
          found_orphan_sess=true
        fi
      done <<< "$ag_sessions"
    fi
    $found_orphan_sess || echo "  (none)"

    if main_repo_root &>/dev/null; then
      root=$(main_repo_root)
      repo=$(basename "$root")

      # 3. merged worktrees (PR merged, safe to remove)
      echo ""
      echo "=== merged worktrees ($repo) ==="
      found_merged=false
      while read -r wt_path; do
        [[ "$wt_path" == "$root" ]] && continue
        wt_name=$(basename "$wt_path")
        wt_slug="${wt_name#*-wt-}"
        expected_sess="ag-${repo}-${wt_slug}"
        # get branch: prefer tmux env (handles detached HEAD), fall back to git
        branch=$(_ag_branch "$expected_sess" "$wt_path")
        [[ -z "$branch" || "$branch" == "HEAD" ]] && continue
        merged=$(gh pr list --head "$branch" --state merged --no-interactive --json number --jq '.[0].number // empty' 2>/dev/null || true)
        if [[ -n "$merged" ]]; then
          echo "  $wt_slug ($branch) – PR #$merged merged"
          to_remove+=("$wt_path")
          found_merged=true
        fi
      done < <(git worktree list --porcelain 2>/dev/null | awk '/^worktree /{print $2}')
      $found_merged || echo "  (none)"

      # 4. orphan worktrees (worktree exists but no tmux session)
      echo ""
      echo "=== orphan worktrees (no session) ==="
      found_orphan_wt=false
      while read -r wt_path; do
        [[ "$wt_path" == "$root" ]] && continue
        wt_name=$(basename "$wt_path")
        wt_slug="${wt_name#*-wt-}"
        expected_sess="ag-${repo}-${wt_slug}"
        if ! tmux has-session -t "$expected_sess" 2>/dev/null; then
          branch=$(git -C "$wt_path" rev-parse --abbrev-ref HEAD 2>/dev/null || echo "-")
          echo "  $wt_slug ($branch) – no active session"
          to_remove+=("$wt_path")
          found_orphan_wt=true
        fi
      done < <(git worktree list --porcelain 2>/dev/null | awk '/^worktree /{print $2}')
      $found_orphan_wt || echo "  (none)"

      # 5. stale state files
      if [[ -d "$HOME/.agents/state" ]]; then
        echo ""
        echo "=== stale state files ==="
        found_stale=false
        for state_dir in "$HOME/.agents/state"/*/; do
          [[ ! -d "$state_dir" ]] && continue
          state_name=$(basename "$state_dir")
          expected_sess="ag-${repo}-${state_name}"
          if ! tmux has-session -t "$expected_sess" 2>/dev/null; then
            echo "  $state_name"
            found_stale=true
            rm -rf "$state_dir"
          fi
        done
        $found_stale || echo "  (none)"
      fi

      # prompt to remove worktrees
      if [[ ${#to_remove[@]} -gt 0 ]]; then
        echo ""
        if [[ "$force" == true ]]; then
          reply="y"
        elif [[ -t 0 ]]; then
          read -r -p "Remove ${#to_remove[@]} worktree(s)? [y/N] " reply
        else
          echo "skipping prompt (not a TTY). Use 'ag clean --force'." >&2
          reply="n"
        fi
        if [[ "$reply" =~ ^[Yy] ]]; then
          for wt_path in "${to_remove[@]}"; do
            wt_name=$(basename "$wt_path")
            wt_slug="${wt_name#*-wt-}"
            sess_name="ag-${repo}-${wt_slug}"
            branch=$(_ag_branch "$sess_name" "$wt_path")
            tmux kill-session -t "$sess_name" 2>/dev/null
            if git worktree remove "$wt_path" --force 2>/dev/null; then
              if [[ -n "$branch" && "$branch" != "HEAD" ]]; then
                git -C "$root" branch -d "$branch" 2>/dev/null || true
              fi
              echo "  removed $wt_slug"
            else
              echo "  failed to remove $wt_slug (dirty?)" >&2
            fi
          done
        fi
      fi
    fi
    ;;
  "")
    # dashboard: all sessions, ag sessions enriched with state + PR
    all_sessions=$(tmux list-sessions -F '#{session_name}' 2>/dev/null || true)
    [[ -z "$all_sessions" ]] && { echo "no tmux sessions"; exit 0; }

    # build display lines: slug/name  state  repo  PR
    lines=""
    while read -r sess; do
      if [[ "$sess" == ag-* ]]; then
        slug=$(_ag_slug "$sess")
        repo=$(tmux show-environment -t "$sess" AG_REPO 2>/dev/null | sed 's/^AG_REPO=//' || true)
        [[ -z "$repo" ]] && { tmp="${sess#ag-}"; repo="${tmp%%-*}"; }
        pane_cmd=$(tmux display-message -t "$sess" -p '#{pane_current_command}' 2>/dev/null || echo "")
        if [[ "$pane_cmd" == "zsh" || "$pane_cmd" == "bash" || -z "$pane_cmd" ]]; then
          state="idle"
        else
          state="active"
        fi
        # quick PR check (cached from parallel calls)
        wt_path=$(tmux display-message -t "$sess" -p '#{pane_current_path}' 2>/dev/null || echo "")
        branch=$(git -C "$wt_path" rev-parse --abbrev-ref HEAD 2>/dev/null || echo "-")
        pr_info=$(gh pr list --head "$branch" --no-interactive --json number,state --jq '"PR #" + (.[0].number|tostring) + " " + (.[0].state|ascii_downcase)' 2>/dev/null || true)
        line=$(printf "%-20s %-8s %-12s %s" "$slug" "$state" "$repo" "$pr_info")
      else
        line=$(printf "%-20s %-8s" "$sess" "")
      fi
      lines+="$line"$'\n'
    done <<< "$all_sessions"

    if command -v fzf &>/dev/null; then
      pick=$(echo "$lines" | fzf \
        --prompt="agent> " \
        --header="enter: attach | ctrl-o: open PR | ctrl-p: copy plan" \
        --preview='~/tools/ag-preview {1}' \
        --preview-window=right:50% \
        --bind="ctrl-o:execute-silent(url=\$(~/tools/ag-preview {1} | grep -o 'https://[^ ]*' | head -1); if command -v open >/dev/null; then open \"\$url\"; elif command -v xdg-open >/dev/null; then xdg-open \"\$url\"; fi)" \
        --bind="ctrl-p:execute-silent(~/tools/ag-preview {1} | grep '^plan: ' | sed 's/^plan: //' | tr -d '\n' | if command -v pbcopy >/dev/null; then pbcopy; elif command -v xclip >/dev/null; then xclip -selection clipboard; fi)" \
        | awk '{print $1}') || exit 0

      # resolve: if it's an ag slug, convert back to session name
      if tmux has-session -t "$pick" 2>/dev/null; then
        attach_or_switch "$pick"
      else
        # find ag session matching this slug
        match=$(tmux list-sessions -F '#{session_name}' 2>/dev/null | grep -F -- "-${pick}" | head -1 || true)
        if [[ -n "$match" ]]; then
          attach_or_switch "$match"
        else
          echo "no session matching '$pick'" >&2
          exit 1
        fi
      fi
    else
      echo "$lines"
    fi
    ;;
  *)
    # launch: ag <name> [flags]
    name="$1"
    if [[ "$name" == -* ]]; then
      echo "error: name cannot start with '-': $name" >&2
      echo "run 'ag --help' for usage" >&2
      exit 1
    fi
    if [[ ! "$name" =~ ^[a-zA-Z0-9][a-zA-Z0-9_-]*$ ]]; then
      echo "error: name must be alphanumeric (hyphens/underscores ok): $name" >&2
      exit 1
    fi
    shift

    cmd="${AGENT_EXECUTOR:-claude}"
    open_cursor=false
    prompt=""

    while [[ $# -gt 0 ]]; do
      case "$1" in
        --cursor) open_cursor=true; shift ;;
        --gemini) cmd="gemini"; shift ;;
        --claude) cmd="claude"; shift ;;
        --codex)  cmd="codex"; shift ;;
        --no-input) no_input=true; shift ;;
        -m)       [[ -z "${2:-}" ]] && { echo "usage: ag <name> -m MSG" >&2; exit 1; }
                  prompt="$2"; shift 2 ;;
        *)        echo "unknown flag: $1" >&2; exit 1 ;;
      esac
    done

    command -v "$cmd" >/dev/null 2>&1 || { echo "$cmd not found on PATH" >&2; exit 1; }

    # resolve worktree: ag creates new branches (not checking out existing remote)
    if [[ -n "$prompt" || "$no_input" == true ]]; then
      # auto-confirm for background launch
      worktree=$(WT_CREATE_MODE=new ~/tools/wt-resolve "$name") || exit 1
    elif [[ -t 0 ]]; then
      # interactive: confirm creation
      echo "will create worktree for '$name' if needed" >&2
      worktree=$(WT_CREATE_MODE=new ~/tools/wt-resolve "$name") || exit 1
    else
      worktree=$(WT_CREATE_MODE=new ~/tools/wt-resolve "$name") || exit 1
    fi
    local_repo=$(repo_name)
    session="ag-${local_repo}-${name}"

    # if session exists, just attach
    if tmux has-session -t "$session" 2>/dev/null; then
      echo "attaching to $name"
      echo "  ag             switch to another session"
      echo "  ag status      see all agents"
      echo "  C-a d          detach back to terminal"
      attach_or_switch "$session"
      exit 0
    fi

    # open cursor in worktree if requested
    if [[ "$open_cursor" == true ]]; then
      if command -v cursor &>/dev/null; then
        cursor "$worktree" &
        echo "opened cursor: $worktree"
      else
        echo "cursor not found on PATH" >&2
      fi
    fi

    # create tmux session + store metadata
    if ! tmux new-session -d -s "$session" -c "$worktree" 2>/dev/null; then
      echo "error: failed to create tmux session '$session'" >&2
      echo "cleaning up worktree..." >&2
      git worktree remove "$worktree" 2>/dev/null
      exit 1
    fi
    _ag_set_env "$session" "$name" "$local_repo" "$name"

    if [[ -n "$prompt" ]]; then
      # background agents get AG_BACKGROUND=1 so they know not to block on input
      tmux set-environment -t "$session" AG_BACKGROUND 1

      # plan discovery: check for matching plan.md by agent name
      plan_file="$HOME/.agents/artifacts/$name/plan.md"
      if [[ -f "$plan_file" ]]; then
        prompt="Context: plan at $plan_file — $prompt"
        echo "  plan: $plan_file" >&2
      fi
      # positional arg = first message in interactive session (not -p pipe mode)
      tmux send-keys -t "$session" "$cmd $(printf '%q' "$prompt")" Enter
      # background launch: print guided output, don't attach
      echo "launched $name (branch: $name)"
      echo "  ag $name       attach to session"
      echo "  ag status      see all agents"
      echo "  ag             pick from list"
    else
      tmux send-keys -t "$session" "$cmd" Enter
      attach_or_switch "$session"
    fi
    ;;
esac
