#!/usr/bin/env bash
# ag - agent session manager (stage 6-7 orchestrator)
# One command for parallel agent work: auto-creates worktrees, launches claude.
set -euo pipefail

# --no-input / AG_NO_INPUT: skip all interactive prompts
no_input=false
[[ "${AG_NO_INPUT:-}" == "1" ]] && no_input=true

usage() {
  cat <<'EOF'
ag - agent session manager
  ag <name>                 launch $AGENT_EXECUTOR (default claude) in worktree
  ag <name> -m MSG          launch with initial task
  ag <name> --cursor        cursor + agent in worktree
  ag <name> --claude        force using claude
  ag <name> --gemini        force using gemini
  ag <name> --codex         force using codex
  ag pr <number|url>        checkout PR into worktree + attach
  ag pr <number|url> -m MSG checkout PR + launch agent with task
  ag pr <number|url> --review  review PR diff with agent (no worktree)
  ag                        dashboard – all sessions, all repos (fzf)
  ag status                 cross-repo unified view
  ag kill <name>            kill session
  ag clean                  dead sessions + merged worktrees
  ag clean --no-input       same, skip confirmation (also: --force)
  AG_NO_INPUT=1 ag ...      skip all prompts (for scripts/orchestrator)
EOF
}

main_repo_root() {
  local toplevel common
  toplevel=$(git rev-parse --show-toplevel 2>/dev/null) || return 1
  common=$(git rev-parse --git-common-dir 2>/dev/null)
  if [[ "$common" != ".git" && "$common" != "$(git rev-parse --git-dir 2>/dev/null)" ]]; then
    # Inside a worktree: common dir is /path/to/main/.git
    (cd "$(dirname "$common")" && pwd)
  else
    echo "$toplevel"
  fi
}

repo_name() {
  basename "$(main_repo_root 2>/dev/null)" 2>/dev/null || echo "local"
}

# Resolve worktree path: exact match → fuzzy → fzf disambiguate → auto-create
resolve_worktree() {
  local name="$1" auto_confirm="${2:-false}"
  local root repo dest
  root=$(main_repo_root) || { echo "not in a git repo" >&2; return 1; }
  repo=$(basename "$root")
  dest="${root}/../${repo}-wt-${name}"

  # exact match – fast path
  if [[ -d "$dest" ]]; then
    echo "$dest"; return
  fi

  # substring search across existing worktrees
  local matches=()
  while read -r wt; do
    [[ -z "$wt" ]] && continue
    [[ "$(basename "$wt")" == *"$name"* ]] && matches+=("$wt")
  done < <(git worktree list --porcelain 2>/dev/null | awk '/^worktree /{print $2}')

  if [[ ${#matches[@]} -eq 1 ]]; then
    echo "${matches[0]}"; return
  elif [[ ${#matches[@]} -gt 1 ]]; then
    if command -v fzf &>/dev/null; then
      local pick
      pick=$(printf '%s\n' "${matches[@]}" "+ create new: $name" | fzf --prompt="multiple matches> ") || return 1
      if [[ "$pick" != "+ create new: $name" ]]; then
        echo "$pick"; return
      fi
    else
      echo "multiple worktrees match '$name':" >&2
      printf '  %s\n' "${matches[@]}" >&2
      return 1
    fi
  fi

  # lock to prevent race between concurrent ag calls
  local lockdir="/tmp/ag-create-${name}.lock"
  if ! mkdir "$lockdir" 2>/dev/null; then
    echo "error: another ag instance is creating '$name'" >&2
    return 1
  fi
  trap "rmdir '$lockdir' 2>/dev/null" RETURN

  # auto-create worktree – confirm unless auto_confirm or non-TTY
  if [[ "$auto_confirm" != true && -t 0 ]]; then
    echo "will create worktree: $dest (branch: $name)" >&2
    read -r -p "continue? [Y/n] " reply
    [[ "$reply" =~ ^[Nn] ]] && return 1
  fi
  local default_branch
  default_branch=$(git symbolic-ref refs/remotes/origin/HEAD 2>/dev/null | sed 's|refs/remotes/origin/||')
  if [[ -z "$default_branch" ]]; then
    default_branch="main"
    echo "warning: origin/HEAD not set, assuming '$default_branch'" >&2
  fi
  if ! git fetch origin "$default_branch" --quiet 2>&1; then
    echo "error: git fetch failed – check network/auth" >&2
    return 1
  fi
  local output
  if ! output=$(git worktree add "$dest" -b "$name" "origin/$default_branch" 2>&1); then
    if echo "$output" | grep -q "already exists"; then
      echo "error: branch '$name' already exists – use a different name or: git branch -d $name" >&2
    else
      echo "error: failed to create worktree '$name': $output" >&2
    fi
    return 1
  fi
  echo "created worktree: $dest" >&2
  echo "$dest"
}

attach_or_switch() {
  local session="$1"
  if [[ -n "${TMUX:-}" ]]; then
    tmux switch-client -t "$session"
  else
    tmux attach-session -t "$session"
  fi
}

case "${1:-}" in
  -h|--help) usage ;;
  pr)
    if [[ "${2:-}" == "--help" || "${2:-}" == "-h" ]]; then
      echo "ag pr – checkout PR into worktree + attach"
      echo "  ag pr 90                                    local repo PR"
      echo "  ag pr https://github.com/org/repo/pull/90   any repo PR"
      echo "  ag pr 90 -m MSG                             checkout + launch agent"
      echo "  ag pr 90 --review                           review diff with agent (no worktree)"
      exit 0
    fi
    [[ -z "${2:-}" ]] && { echo "usage: ag pr <number|url>" >&2; exit 1; }

    # smart input: URL or number
    pr_input="$2"
    shift 2
    gh_repo_flag=""

    if [[ "$pr_input" =~ ^https://github\.com/([^/]+/[^/]+)/pull/([0-9]+) ]]; then
      # URL: extract org/repo and number
      pr_repo="${BASH_REMATCH[1]}"
      pr_number="${BASH_REMATCH[2]}"
      gh_repo_flag="--repo $pr_repo"
    elif [[ "$pr_input" =~ ^[0-9]+$ ]]; then
      pr_number="$pr_input"
    else
      echo "error: expected PR number or GitHub PR URL" >&2
      echo "  ag pr 90" >&2
      echo "  ag pr https://github.com/org/repo/pull/90" >&2
      exit 1
    fi

    # get PR metadata
    pr_json=$(gh pr view "$pr_number" $gh_repo_flag --json headRefName,title,url,state 2>/dev/null) || {
      echo "error: could not find PR #$pr_number" >&2; exit 1
    }
    pr_branch=$(echo "$pr_json" | jq -r '.headRefName')
    pr_title=$(echo "$pr_json" | jq -r '.title')
    pr_url=$(echo "$pr_json" | jq -r '.url')

    # parse flags
    pr_prompt=""
    pr_review=false
    while [[ $# -gt 0 ]]; do
      case "$1" in
        -m) [[ -z "${2:-}" ]] && { echo "usage: ag pr <number> -m MSG" >&2; exit 1; }
            pr_prompt="$2"; shift 2 ;;
        --review) pr_review=true; shift ;;
        *) echo "unknown flag: $1" >&2; exit 1 ;;
      esac
    done

    # --review: no worktree, just pipe diff to agent (works for any repo via API)
    if [[ "$pr_review" == true ]]; then
      echo "reviewing PR #$pr_number: $pr_title"
      echo "  $pr_url"
      cmd="${AGENT_EXECUTOR:-claude}"
      exec $cmd "Review this PR: $pr_title ($pr_url). Here is the diff: $(gh pr diff "$pr_number" $gh_repo_flag 2>/dev/null)"
    fi

    # checkout mode: need local repo
    if [[ -n "$gh_repo_flag" ]]; then
      # cross-repo PR: check if we have it cloned locally
      # look in common locations: ~/<repo>, ~/code/<repo>
      pr_repo_name="${pr_repo#*/}"
      local_repo=""
      for candidate in "$HOME/$pr_repo_name" "$HOME/code/$pr_repo_name" "$HOME/src/$pr_repo_name"; do
        if [[ -d "$candidate/.git" ]]; then
          local_repo="$candidate"
          break
        fi
      done
      if [[ -z "$local_repo" ]]; then
        echo "error: repo '$pr_repo' not cloned locally" >&2
        echo "  git clone git@github.com:${pr_repo}.git ~/$pr_repo_name" >&2
        echo "  then retry: ag pr $pr_input" >&2
        exit 1
      fi
      # operate from the local repo
      cd "$local_repo"
    fi

    # fetch the PR branch
    if ! git fetch origin "$pr_branch" --quiet 2>&1; then
      echo "error: could not fetch branch '$pr_branch'" >&2; exit 1
    fi

    # create worktree from PR branch (use branch name as slug)
    # sanitize branch name for worktree slug (feat/foo → feat-foo)
    slug=$(echo "$pr_branch" | tr '/' '-')
    root=$(main_repo_root) || exit 1
    repo=$(basename "$root")
    dest="${root}/../${repo}-wt-${slug}"

    if [[ ! -d "$dest" ]]; then
      if ! git worktree add "$dest" "origin/$pr_branch" --detach 2>/dev/null; then
        echo "error: could not create worktree for '$pr_branch'" >&2; exit 1
      fi
      # create local tracking branch
      git -C "$dest" checkout -b "$pr_branch" "origin/$pr_branch" 2>/dev/null || true
      echo "checked out PR #$pr_number: $pr_title" >&2
    fi

    session="ag-${repo}-${slug}"

    if tmux has-session -t "$session" 2>/dev/null; then
      echo "attaching to $slug (PR #$pr_number)"
      echo "  ag             switch to another session"
      echo "  ag status      see all agents"
      echo "  C-a d          detach back to terminal"
      attach_or_switch "$session"
      exit 0
    fi

    # create tmux session
    if ! tmux new-session -d -s "$session" -c "$dest" 2>/dev/null; then
      echo "error: failed to create tmux session '$session'" >&2; exit 1
    fi

    if [[ -n "$pr_prompt" ]]; then
      cmd="${AGENT_EXECUTOR:-claude}"
      tmux send-keys -t "$session" "$cmd $(printf '%q' "$pr_prompt")" Enter
      echo "launched $slug (PR #$pr_number: $pr_title)"
      echo "  $pr_url"
      echo "  ag $slug       attach to session"
      echo "  ag status      see all agents"
      echo "  ag             pick from list"
    else
      tmux send-keys -t "$session" "${AGENT_EXECUTOR:-claude}" Enter
      echo "attaching to $slug (PR #$pr_number)"
      echo "  $pr_url"
      echo "  ag             switch to another session"
      echo "  ag status      see all agents"
      echo "  C-a d          detach back to terminal"
      attach_or_switch "$session"
    fi
    ;;
  kill)
    if [[ "${2:-}" == "--help" || "${2:-}" == "-h" ]]; then
      echo "ag kill <name> – kill an agent session"; exit 0
    fi
    [[ -z "${2:-}" ]] && { echo "usage: ag kill <name>" >&2; exit 1; }
    local_repo=$(repo_name)
    tmux kill-session -t "ag-${local_repo}-${2}" 2>/dev/null && echo "killed ag-${local_repo}-${2}" || echo "no session ag-${local_repo}-${2}" >&2
    ;;
  status)
    json=false
    for arg in "${@:2}"; do
      case "$arg" in
        --help|-h) echo "ag status – show all agent sessions across repos"
                   echo "  --json    machine-readable output"
                   exit 0 ;;
        --json) json=true ;;
      esac
    done
    # cross-repo: iterate all ag-* tmux sessions
    sessions_list=$(tmux list-sessions -F '#{session_name}' 2>/dev/null | grep '^ag-' || true)
    if [[ -z "$sessions_list" ]]; then
      [[ "$json" == true ]] && echo "[]" || echo "no agent sessions"
      exit 0
    fi

    [[ "$json" == false ]] && printf "%-20s %-10s %-20s %s\n" "NAME" "STATUS" "BRANCH" "PR"

    # collect session info, fire gh calls in parallel
    tmpdir=$(mktemp -d)
    trap "rm -rf '$tmpdir'" EXIT
    while read -r sess; do
      wt_path=$(tmux display-message -t "$sess" -p '#{pane_current_path}' 2>/dev/null) || continue
      branch=$(git -C "$wt_path" rev-parse --abbrev-ref HEAD 2>/dev/null || echo "-")
      pane_cmd=$(tmux display-message -t "$sess" -p '#{pane_current_command}' 2>/dev/null)
      if [[ "$pane_cmd" == "zsh" || "$pane_cmd" == "bash" ]]; then
        state="idle"
      else
        state="active"
      fi
      # extract slug: ag-<repo>-<slug> → slug
      tmp="${sess#ag-}"
      slug="${tmp#*-}"
      echo "$sess $branch $state $slug" >> "$tmpdir/sessions"
      if [[ "$branch" != "-" ]]; then
        (gh pr list --head "$branch" --no-interactive --json state --jq '.[0].state // "-"' 2>/dev/null || echo "-") > "$tmpdir/pr-${sess}" &
      else
        echo "-" > "$tmpdir/pr-${sess}"
      fi
    done <<< "$sessions_list"
    wait

    # print results
    if [[ "$json" == true ]]; then
      echo "["
      first=true
      while read -r sess branch state slug; do
        pr_state=$(cat "$tmpdir/pr-${sess}" 2>/dev/null || echo "-")
        $first || echo ","
        printf '  {"name":"%s","session":"%s","branch":"%s","state":"%s","pr":"%s"}' \
          "$slug" "$sess" "$branch" "$state" "$pr_state"
        first=false
      done < "$tmpdir/sessions"
      echo ""
      echo "]"
    else
      while read -r sess branch state slug; do
        pr_state=$(cat "$tmpdir/pr-${sess}" 2>/dev/null || echo "-")
        printf "%-20s %-10s %-20s %s\n" "$slug" "$state" "$branch" "$pr_state"
      done < "$tmpdir/sessions"
    fi
    ;;
  clean)
    force=false
    [[ "$no_input" == true ]] && force=true
    for arg in "${@:2}"; do
      case "$arg" in
        --help|-h)
          echo "ag clean – comprehensive cleanup of agent resources"
          echo "  kills dead sessions, removes merged worktrees,"
          echo "  finds orphan worktrees/sessions, cleans state files"
          echo "  --force/--no-input  skip confirmation prompts"
          exit 0 ;;
        --force|-f|--no-input) force=true ;;
      esac
    done

    to_remove=()

    # 1. dead sessions (agent exited, sitting at shell prompt)
    echo "=== dead sessions ==="
    found_dead=false
    ag_sessions=$(tmux list-sessions -F '#{session_name}' 2>/dev/null | grep '^ag-' || true)
    if [[ -n "$ag_sessions" ]]; then
      while read -r sess; do
        pane_cmd=$(tmux display-message -t "$sess" -p '#{pane_current_command}' 2>/dev/null)
        if [[ "$pane_cmd" == "zsh" || "$pane_cmd" == "bash" ]]; then
          tmp="${sess#ag-}"
          slug="${tmp#*-}"
          echo "  $slug (session idle)"
          tmux kill-session -t "$sess"
          found_dead=true
        fi
      done <<< "$ag_sessions"
    fi
    $found_dead || echo "  (none)"

    # 2. orphan sessions (tmux session exists but worktree is gone)
    echo ""
    echo "=== orphan sessions (no worktree) ==="
    found_orphan_sess=false
    ag_sessions=$(tmux list-sessions -F '#{session_name}' 2>/dev/null | grep '^ag-' || true)
    if [[ -n "$ag_sessions" ]]; then
      while read -r sess; do
        wt_path=$(tmux display-message -t "$sess" -p '#{pane_current_path}' 2>/dev/null || echo "")
        if [[ -z "$wt_path" || ! -d "$wt_path/.git" ]]; then
          tmp="${sess#ag-}"
          slug="${tmp#*-}"
          echo "  $slug (worktree missing)"
          tmux kill-session -t "$sess"
          found_orphan_sess=true
        fi
      done <<< "$ag_sessions"
    fi
    $found_orphan_sess || echo "  (none)"

    if main_repo_root &>/dev/null; then
      root=$(main_repo_root)
      repo=$(basename "$root")

      # 3. merged worktrees (PR merged, safe to remove)
      echo ""
      echo "=== merged worktrees ($repo) ==="
      found_merged=false
      while read -r wt_path; do
        [[ "$wt_path" == "$root" ]] && continue
        branch=$(git -C "$wt_path" rev-parse --abbrev-ref HEAD 2>/dev/null || echo "")
        [[ -z "$branch" ]] && continue
        wt_name=$(basename "$wt_path")
        merged=$(gh pr list --head "$branch" --state merged --no-interactive --json number --jq '.[0].number // empty' 2>/dev/null || true)
        if [[ -n "$merged" ]]; then
          echo "  $wt_name ($branch) – PR #$merged merged"
          to_remove+=("$wt_path")
          found_merged=true
        fi
      done < <(git worktree list --porcelain 2>/dev/null | awk '/^worktree /{print $2}')
      $found_merged || echo "  (none)"

      # 4. orphan worktrees (worktree exists but no tmux session)
      echo ""
      echo "=== orphan worktrees (no session) ==="
      found_orphan_wt=false
      while read -r wt_path; do
        [[ "$wt_path" == "$root" ]] && continue
        wt_name=$(basename "$wt_path")
        # extract slug from worktree name: <repo>-wt-<slug>
        wt_slug="${wt_name#*-wt-}"
        expected_sess="ag-${repo}-${wt_slug}"
        if ! tmux has-session -t "$expected_sess" 2>/dev/null; then
          branch=$(git -C "$wt_path" rev-parse --abbrev-ref HEAD 2>/dev/null || echo "-")
          echo "  $wt_slug ($branch) – no active session"
          to_remove+=("$wt_path")
          found_orphan_wt=true
        fi
      done < <(git worktree list --porcelain 2>/dev/null | awk '/^worktree /{print $2}')
      $found_orphan_wt || echo "  (none)"

      # 5. stale state files
      if [[ -d "$HOME/.agents/state" ]]; then
        echo ""
        echo "=== stale state files ==="
        found_stale=false
        for state_dir in "$HOME/.agents/state"/*/; do
          [[ ! -d "$state_dir" ]] && continue
          state_name=$(basename "$state_dir")
          expected_sess="ag-${repo}-${state_name}"
          if ! tmux has-session -t "$expected_sess" 2>/dev/null; then
            echo "  $state_name"
            found_stale=true
            # auto-remove state files (low risk, regenerated)
            rm -rf "$state_dir"
          fi
        done
        $found_stale || echo "  (none)"
      fi

      # prompt to remove worktrees
      if [[ ${#to_remove[@]} -gt 0 ]]; then
        echo ""
        if [[ "$force" == true ]]; then
          reply="y"
        elif [[ -t 0 ]]; then
          read -r -p "Remove ${#to_remove[@]} worktree(s)? [y/N] " reply
        else
          echo "skipping prompt (not a TTY). Use 'ag clean --force'." >&2
          reply="n"
        fi
        if [[ "$reply" =~ ^[Yy] ]]; then
          for wt_path in "${to_remove[@]}"; do
            wt_name=$(basename "$wt_path")
            wt_slug="${wt_name#*-wt-}"
            tmux kill-session -t "ag-${repo}-${wt_slug}" 2>/dev/null
            if git worktree remove "$wt_path" --force 2>/dev/null; then
              # also clean up the branch
              branch=$(git -C "$root" branch --list "$wt_slug" 2>/dev/null | tr -d ' *')
              [[ -n "$branch" ]] && git -C "$root" branch -d "$branch" 2>/dev/null
              echo "  removed $wt_slug"
            else
              echo "  failed to remove $wt_slug (dirty?)" >&2
            fi
          done
        fi
      fi
    fi
    ;;
  "")
    # dashboard: all sessions, ag sessions enriched with state + PR
    all_sessions=$(tmux list-sessions -F '#{session_name}' 2>/dev/null || true)
    [[ -z "$all_sessions" ]] && { echo "no tmux sessions"; exit 0; }

    # build display lines: slug/name  state  repo  PR
    lines=""
    while read -r sess; do
      if [[ "$sess" == ag-* ]]; then
        tmp="${sess#ag-}"
        repo="${tmp%%-*}"
        slug="${tmp#*-}"
        pane_cmd=$(tmux display-message -t "$sess" -p '#{pane_current_command}' 2>/dev/null || echo "")
        if [[ "$pane_cmd" == "zsh" || "$pane_cmd" == "bash" || -z "$pane_cmd" ]]; then
          state="idle"
        else
          state="active"
        fi
        # quick PR check (cached from parallel calls)
        wt_path=$(tmux display-message -t "$sess" -p '#{pane_current_path}' 2>/dev/null || echo "")
        branch=$(git -C "$wt_path" rev-parse --abbrev-ref HEAD 2>/dev/null || echo "-")
        pr_info=$(gh pr list --head "$branch" --no-interactive --json number,state --jq '"PR #" + (.[0].number|tostring) + " " + (.[0].state|ascii_downcase)' 2>/dev/null || true)
        line=$(printf "%-20s %-8s %-12s %s" "$slug" "$state" "$repo" "$pr_info")
      else
        line=$(printf "%-20s %-8s" "$sess" "")
      fi
      lines+="$line"$'\n'
    done <<< "$all_sessions"

    if command -v fzf &>/dev/null; then
      pick=$(echo "$lines" | fzf \
        --prompt="agent> " \
        --header="enter: attach | ctrl-o: open PR | ctrl-p: copy plan" \
        --preview='~/tools/ag-preview {1}' \
        --preview-window=right:50% \
        --bind="ctrl-o:execute-silent(~/tools/ag-preview {1} | grep -o 'https://[^ ]*' | head -1 | xargs open 2>/dev/null)" \
        --bind="ctrl-p:execute-silent(~/tools/ag-preview {1} | grep '^plan: ' | sed 's/^plan: //' | tr -d '\n' | pbcopy 2>/dev/null)" \
        | awk '{print $1}') || exit 0

      # resolve: if it's an ag slug, convert back to session name
      if tmux has-session -t "$pick" 2>/dev/null; then
        attach_or_switch "$pick"
      else
        # find ag session matching this slug
        match=$(tmux list-sessions -F '#{session_name}' 2>/dev/null | grep -F -- "-${pick}" | head -1 || true)
        if [[ -n "$match" ]]; then
          attach_or_switch "$match"
        else
          echo "no session matching '$pick'" >&2
          exit 1
        fi
      fi
    else
      echo "$lines"
    fi
    ;;
  *)
    # launch: ag <name> [flags]
    name="$1"
    if [[ "$name" == -* ]]; then
      echo "error: name cannot start with '-': $name" >&2
      echo "run 'ag --help' for usage" >&2
      exit 1
    fi
    if [[ ! "$name" =~ ^[a-zA-Z0-9][a-zA-Z0-9_-]*$ ]]; then
      echo "error: name must be alphanumeric (hyphens/underscores ok): $name" >&2
      exit 1
    fi
    shift

    cmd="${AGENT_EXECUTOR:-claude}"
    open_cursor=false
    prompt=""

    while [[ $# -gt 0 ]]; do
      case "$1" in
        --cursor) open_cursor=true; shift ;;
        --gemini) cmd="gemini"; shift ;;
        --claude) cmd="claude"; shift ;;
        --codex)  cmd="codex"; shift ;;
        --no-input) no_input=true; shift ;;
        -m)       [[ -z "${2:-}" ]] && { echo "usage: ag <name> -m MSG" >&2; exit 1; }
                  prompt="$2"; shift 2 ;;
        *)        echo "unknown flag: $1" >&2; exit 1 ;;
      esac
    done

    command -v "$cmd" >/dev/null 2>&1 || { echo "$cmd not found on PATH" >&2; exit 1; }

    auto_confirm=false
    [[ -n "$prompt" || "$no_input" == true ]] && auto_confirm=true
    worktree=$(resolve_worktree "$name" "$auto_confirm") || exit 1
    local_repo=$(repo_name)
    session="ag-${local_repo}-${name}"

    # if session exists, just attach
    if tmux has-session -t "$session" 2>/dev/null; then
      echo "attaching to $name"
      echo "  ag             switch to another session"
      echo "  ag status      see all agents"
      echo "  C-a d          detach back to terminal"
      attach_or_switch "$session"
      exit 0
    fi

    # open cursor in worktree if requested
    if [[ "$open_cursor" == true ]]; then
      if command -v cursor &>/dev/null; then
        cursor "$worktree" &
        echo "opened cursor: $worktree"
      else
        echo "cursor not found on PATH" >&2
      fi
    fi

    # create tmux session
    if ! tmux new-session -d -s "$session" -c "$worktree" 2>/dev/null; then
      echo "error: failed to create tmux session '$session'" >&2
      echo "cleaning up worktree..." >&2
      git worktree remove "$worktree" 2>/dev/null
      exit 1
    fi
    if [[ -n "$prompt" ]]; then
      # plan discovery: check for matching plan.md by agent name
      plan_file="$HOME/.agents/docs/$name/plan.md"
      if [[ -f "$plan_file" ]]; then
        prompt="Context: plan at $plan_file — $prompt"
        echo "  plan: $plan_file" >&2
      fi
      # positional arg = first message in interactive session (not -p pipe mode)
      tmux send-keys -t "$session" "$cmd $(printf '%q' "$prompt")" Enter
      # background launch: print guided output, don't attach
      echo "launched $name (branch: $name)"
      echo "  ag $name       attach to session"
      echo "  ag status      see all agents"
      echo "  ag             pick from list"
    else
      tmux send-keys -t "$session" "$cmd" Enter
      attach_or_switch "$session"
    fi
    ;;
esac
