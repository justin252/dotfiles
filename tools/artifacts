#!/usr/bin/env bash
set -euo pipefail

# artifacts - browse agent artifacts (problem → design → plan → output → review → reference)
# Sources: ~/.agents/artifacts/<topic>/ with YAML frontmatter
# category: browse

usage() {
  cat <<'EOF'
artifacts – browse agent artifacts (fzf)

Usage:
  artifacts [query]

Options:
  -h, --help    Show this help

Sources: ~/.agents/artifacts/<topic>/ with YAML frontmatter.
Actions: edit, view, execute, propose, review, claude, cursor, gemini, plan.
EOF
}

ARTIFACTS_ROOT="${ARTIFACTS_ROOT:-$HOME/.agents/artifacts}"

case "${1:-}" in -h|--help) usage; exit 0 ;; esac

if ! command -v fzf &>/dev/null; then
  echo "fzf required but not found" >&2
  exit 1
fi

# ANSI color codes
RED=$'\033[31m'
BLUE=$'\033[34m'
YELLOW=$'\033[33m'
GREEN=$'\033[32m'
MAGENTA=$'\033[35m'
DIM=$'\033[2m'
RESET=$'\033[0m'

# Map doc type to color
color_for_type() {
  case "$1" in
    problem)   printf '%s' "$RED" ;;
    design)    printf '%s' "$BLUE" ;;
    plan)      printf '%s' "$YELLOW" ;;
    output)    printf '%s' "$GREEN" ;;
    review)    printf '%s' "$MAGENTA" ;;
    reference) printf '%s' "$DIM" ;;
    *)         printf '%s' "$RESET" ;;
  esac
}

# Batch-parse frontmatter via single ruby invocation (macOS stdlib, zero install)
# Outputs: path \t topic \t repo \t component \t status  (one line per file)
batch_frontmatter() {
  ruby -ryaml -rdate -e '
    ARGV.each do |path|
      content = File.read(path) rescue ""
      if content =~ /\A---\n(.*?\n)---/m
        fm = YAML.safe_load($1, permitted_classes: [Date]) || {}
        puts [path, fm["topic"], fm["repo"], fm["component"], fm["status"]].map(&:to_s).join("\t")
      else
        puts "#{path}\t\t\t\t"
      end
    end
  ' "$@" 2>/dev/null
}

# Build entries list
# Format: "colored_display \t full_path \t type \t topic_root \t topic \t repo \t component \t status"
entries=""

if [[ -d "$ARTIFACTS_ROOT" ]]; then
  # Collect all .md files
  md_files=()
  while IFS= read -r f; do
    md_files+=("$f")
  done < <(find "$ARTIFACTS_ROOT" -type f -name '*.md' | sort)

  # Single Ruby process for all frontmatter
  fm_output=""
  if [[ ${#md_files[@]} -gt 0 ]]; then
    fm_output=$(batch_frontmatter "${md_files[@]}")
  fi

  for file in "${md_files[@]}"; do
    fname=$(basename "$file" .md)
    topic_dir=$(dirname "$file")
    topic_name=$(basename "$topic_dir")

    # Skip non-doc files at root level
    [[ "$topic_dir" == "$ARTIFACTS_ROOT" ]] && continue

    # Determine type from filename or subdir
    parent_name=$(basename "$topic_dir")
    if [[ "$parent_name" == "outputs" || "$parent_name" == "reviews" ]]; then
      topic_dir=$(dirname "$topic_dir")
      topic_name=$(basename "$topic_dir")
      doc_type="${parent_name%?}"
    else
      doc_type="$fname"
    fi
    color=$(color_for_type "$doc_type")

    # Look up cached frontmatter
    fm_line=$(grep -F "$file" <<< "$fm_output" | head -1)
    if [[ -n "$fm_line" ]]; then
      IFS=$'\t' read -r _path fm_topic fm_repo fm_component fm_status <<< "$fm_line"
    else
      fm_topic="" fm_repo="" fm_component="" fm_status=""
    fi

    # Use frontmatter values or defaults
    repo="${fm_repo:-}"
    component="${fm_component:-}"
    status="${fm_status:-}"

    # Build display: [type] topic  repo/component  status
    display="${color}[${doc_type}]${RESET}  ${topic_name}"
    [[ -n "$repo" ]] && display+="  ${DIM}${repo}"
    [[ -n "$component" ]] && display+="/${component}"
    [[ -n "$repo" ]] && display+="${RESET}"
    [[ -n "$status" ]] && display+="  ${DIM}${status}${RESET}"

    entries+="${display}"$'\t'"${file}"$'\t'"${doc_type}"$'\t'"${topic_dir}"$'\t'"${topic_name}"$'\t'"${repo}"$'\t'"${component}"$'\t'"${status}"$'\n'
  done
fi

if [[ -z "$entries" ]]; then
  echo "No documents found in $ARTIFACTS_ROOT" >&2
  exit 1
fi

# Preview uses hidden field {2} = full path
preview_cmd="bat --style=plain --color=always {2} 2>/dev/null || cat {2}"

# fzf with optional query arg – searches across all fields including hidden ones
fzf_args=(
  --prompt="artifacts> "
  --ansi
  --delimiter=$'\t'
  --with-nth=1
  --preview="$preview_cmd"
  --preview-window=right:60%:wrap
)
[[ $# -gt 0 ]] && fzf_args+=(--query="$1")

selection=$(printf '%s' "$entries" | fzf "${fzf_args[@]}") || exit 0
[[ -z "$selection" ]] && exit 0

# Parse hidden fields from selection
full=$(echo "$selection" | cut -f2)
doc_type=$(echo "$selection" | cut -f3)
topic_dir=$(echo "$selection" | cut -f4)
topic=$(echo "$selection" | cut -f5)

# Build actions list based on what exists in topic dir
actions=("edit" "view")

if [[ -f "$topic_dir/plan.md" ]]; then
  actions+=("execute")
elif [[ -f "$topic_dir/problem.md" || -f "$topic_dir/design.md" ]]; then
  actions+=("propose")
fi

if [[ "$doc_type" == "output" || "$doc_type" == "review" || -f "$topic_dir/output.md" ]]; then
  actions+=("review")
fi

actions+=("claude" "cursor" "gemini" "plan")

action=$(printf '%s\n' "${actions[@]}" | \
  fzf --prompt="action> " --header="$topic – $(basename "$full")") || exit 0

case "$action" in
  edit)
    ${EDITOR:-cursor} "$full" ;;
  view)
    if command -v bat &>/dev/null; then
      bat --style=plain "$full"
    else
      cat "$full"
    fi ;;
  execute)
    slug="$topic"
    if git rev-parse --show-toplevel &>/dev/null; then
      echo "Launching agent: ag $slug -m \"/execute from $topic_dir/plan.md\""
      ag "$slug" -m "/execute from $topic_dir/plan.md"
    else
      echo "Launching Claude Code: /execute $topic"
      cd "$topic_dir" && claude "/execute $topic"
    fi ;;
  propose)
    slug="$topic"
    if git rev-parse --show-toplevel &>/dev/null; then
      echo "Launching agent: ag $slug -m \"/propose $topic\""
      ag "$slug" -m "/propose $topic"
    else
      echo "Launching Claude Code: /propose $topic"
      cd "$topic_dir" && claude "/propose $topic"
    fi ;;
  review)
    review --topic "$topic_dir" ;;
  claude)
    if [[ -d "$topic_dir" && "$topic_dir" != "$ARTIFACTS_ROOT" ]]; then
      echo "Launching Claude Code: $topic"
      cd "$topic_dir" && claude "load $topic ($topic_dir/)"
    else
      echo "Launching Claude Code: $(basename "$full")"
      claude "load $full"
    fi ;;
  gemini)
    if [[ -d "$topic_dir" && "$topic_dir" != "$ARTIFACTS_ROOT" ]]; then
      echo "Launching Gemini: $topic"
      cd "$topic_dir" && gemini "load $topic ($topic_dir/)"
    else
      echo "Launching Gemini: $(basename "$full")"
      gemini "load $full"
    fi ;;
  plan)
    planner="${AG_EXECUTE_MODEL:-claude:opus}"
    planner="${planner%%:*}"
    case "$planner" in
      claude) plan_flag="--permission-mode plan" ;;
      gemini) plan_flag="--approval-mode plan" ;;
      *)      plan_flag="" ;;
    esac
    if [[ -d "$topic_dir" && "$topic_dir" != "$ARTIFACTS_ROOT" ]]; then
      echo "Launching $planner (Plan Mode): $topic"
      cd "$topic_dir" && $planner $plan_flag "load $topic ($topic_dir/)"
    else
      echo "Launching $planner (Plan Mode): $(basename "$full")"
      $planner $plan_flag "load $full"
    fi ;;
  cursor)
    if [[ -d "$topic_dir" && "$topic_dir" != "$ARTIFACTS_ROOT" ]]; then
      cursor "$topic_dir"
    else
      cursor "$full"
    fi ;;
esac
