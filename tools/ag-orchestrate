#!/usr/bin/env bash
# ag-orchestrate - multi-stage pipeline orchestrator (the ringmaster)
# Called by `ag run` as a background process. Sequences stages with per-stage models.
# category: agent
set -euo pipefail

usage() {
  cat <<'EOF'
ag-orchestrate - run pipeline stages with per-stage executors

Usage: ag-orchestrate --session <name> --topic <slug> --plan <path> [options]

Options:
  --session NAME    tmux session name
  --topic SLUG      topic slug (state dir name)
  --plan PATH       path to plan.md
  --skip STAGES     comma-separated stages to skip
  --resume          resume from last incomplete stage
  --test            integration test mode (stub artifacts in /tmp)
  -h, --help        show this help

Env vars (format: executor:model, e.g. claude:opus, codex:gpt-5.4):
  AG_SCOUT_MODEL    scout stage (default: claude:haiku)
  AG_TEST_MODEL     test-writer stage (default: claude:sonnet)
  AG_EXECUTE_MODEL  execute + verify stages (default: claude:opus)
  AG_SHIP_MODEL     ship stage (default: claude:sonnet)
  AG_REVIEW_MODEL   review stage (default: codex:gpt-5.4)
  AG_RETRO_MODEL    retro stage (default: claude:haiku)
  AG_CONTEXT_BYTES  artifact context cap per file (default: 8000)
  AG_VERIFY_MAX     max verify iterations (default: 3)

Stages: scout, test, execute, verify, ship, review, fix, retro
EOF
}

# --- parsing helpers ---

_executor() { echo "${1%%:*}"; }
_model()    { local m="${1#*:}"; [[ "$m" == "$1" ]] && m=""; echo "$m"; }

_build_cmd() {
  local val="$1" prompt="$2"
  local exe model cmd
  exe="$(_executor "$val")"
  model="$(_model "$val")"

  case "$exe" in
    claude) cmd="claude${model:+ --model $model}" ;;
    codex)  cmd="codex exec${model:+ -m $model}" ;;
    *)      cmd="$exe" ;;
  esac
  echo "$cmd $(printf '%q' "$prompt")"
}

_now() { date -u +%FT%TZ; }

# --- smart truncation: preserve frontmatter + ## Open ---

_smart_truncate() {
  local file="$1" max_bytes="$2"
  [[ ! -f "$file" ]] && return
  local size
  size=$(wc -c < "$file" | tr -d ' ')
  if (( size <= max_bytes )); then
    cat "$file"
    return
  fi
  head -c "$((max_bytes * 3 / 4))" "$file"
  printf '\n...[truncated]...\n'
  if grep -q '^## Open' "$file" 2>/dev/null; then
    awk '/^## Open$/,0' "$file"
  fi
}

# --- blocker detection (matches review-instructions.md P0/P1 format) ---

_has_blockers() {
  local review_file="$1"
  [[ -f "$review_file" ]] || return 1
  # unchecked P0/P1 items; checked [x] and P2 items are not blockers
  grep -qE '^\- \[ \] P[01] ' "$review_file" 2>/dev/null
}

# --- review_pass tracking ---

_inc_review_pass() {
  local state_dir="$1"
  local tmp="$state_dir/pipeline.json.tmp"
  jq '.review_pass = (.review_pass + 1)' "$state_dir/pipeline.json" > "$tmp" \
    && mv "$tmp" "$state_dir/pipeline.json"
}

_get_review_pass() {
  jq -r '.review_pass' "$1/pipeline.json"
}

# --- pipeline.json state management ---

_init_pipeline() {
  local state_dir="$1" topic="$2" session="$3"
  jq -n \
    --arg topic "$topic" \
    --arg session "$session" \
    --arg started "$(_now)" \
    '{
      topic: $topic,
      session: $session,
      started: $started,
      current_stage: null,
      review_pass: 0,
      stages: {
        scout:   {status: "pending"},
        test:    {status: "pending"},
        execute: {status: "pending"},
        verify:  {status: "pending"},
        ship:    {status: "pending"},
        review:  {status: "pending"},
        fix:     {status: "pending"},
        retro:   {status: "pending"}
      }
    }' > "$state_dir/pipeline.json"
}

_update_stage() {
  local state_dir="$1" stage="$2" field="$3" value="$4"
  local tmp="$state_dir/pipeline.json.tmp"
  jq --arg s "$stage" --arg f "$field" --arg v "$value" \
    '.stages[$s][$f] = $v' "$state_dir/pipeline.json" > "$tmp" \
    && mv "$tmp" "$state_dir/pipeline.json"
}

_set_current() {
  local state_dir="$1" stage="$2"
  local tmp="$state_dir/pipeline.json.tmp"
  jq --arg s "$stage" '.current_stage = $s' "$state_dir/pipeline.json" > "$tmp" \
    && mv "$tmp" "$state_dir/pipeline.json"
}

_stage_status() {
  local state_dir="$1" stage="$2"
  jq -r --arg s "$stage" '.stages[$s].status' "$state_dir/pipeline.json"
}

_start_stage() {
  local state_dir="$1" stage="$2" model="$3"
  _set_current "$state_dir" "$stage"
  _update_stage "$state_dir" "$stage" "status" "running"
  _update_stage "$state_dir" "$stage" "started" "$(_now)"
  _update_stage "$state_dir" "$stage" "model" "$model"
}

_finish_stage() {
  local state_dir="$1" stage="$2" status="$3"
  _update_stage "$state_dir" "$stage" "status" "$status"
  _update_stage "$state_dir" "$stage" "ended" "$(_now)"
}

# --- sentinel-based stage execution ---

_wait_sentinel() {
  local sentinel="$1" timeout="$2"
  local elapsed=0
  while [[ ! -f "$sentinel" ]]; do
    sleep 5
    elapsed=$((elapsed + 5))
    if (( elapsed >= timeout )); then
      return 2
    fi
  done
  local result
  result=$(cat "$sentinel")
  rm -f "$sentinel"
  [[ "$result" == "done" ]]
}

_wait_stage() {
  local state_dir="$1" stage="$2" timeout="${3:-600}"
  local sentinel="$state_dir/stage-done"
  local elapsed=0

  while [[ ! -f "$sentinel" ]]; do
    sleep 5
    elapsed=$((elapsed + 5))

    # Check for context filling (agent needs restart)
    if _check_context_filling "$state_dir" && [[ "$test_mode" != true ]]; then
      if _relaunch_agent "$session" "$state_dir" "$topic" "$plan" "$_current_model" "$stage"; then
        elapsed=0  # reset timeout for relaunched agent
        continue
      else
        return 1  # escalation happened
      fi
    fi

    if (( elapsed >= timeout )); then
      echo "timeout waiting for stage '$stage' after ${timeout}s" >&2
      _finish_stage "$state_dir" "$stage" "failed"
      _escalate "$state_dir" "$topic" "$stage" "Timeout after ${timeout}s"
      return 1
    fi
  done

  local result
  result=$(cat "$sentinel")
  rm -f "$sentinel"
  if [[ "$result" == "done" ]]; then
    _finish_stage "$state_dir" "$stage" "done"
    return 0
  else
    _finish_stage "$state_dir" "$stage" "failed"
    return 1
  fi
}

_run_in_session() {
  local session="$1" cmd="$2" state_dir="$3"
  local sentinel="$state_dir/stage-done"
  rm -f "$sentinel"
  tmux send-keys -t "$session" \
    "$cmd && echo done > $(printf '%q' "$sentinel") || echo fail > $(printf '%q' "$sentinel")" Enter
}

_run_in_window() {
  local session="$1" window="$2" cmd="$3" sentinel="$4"
  rm -f "$sentinel"
  tmux new-window -t "${session}:${window}" -n test-writer -d
  tmux send-keys -t "${session}:${window}" \
    "$cmd && echo done > $(printf '%q' "$sentinel") || echo fail > $(printf '%q' "$sentinel")" Enter
}

# --- test mode stubs ---

_run_test_stage() {
  local state_dir="$1" stage="$2" topic="$3"
  local artifact_dir="$state_dir/artifacts"
  mkdir -p "$artifact_dir"

  case "$stage" in
    scout)   echo "stub: codebase patterns found" > "$state_dir/scout-findings.txt" ;;
    test)    echo "stub: failing tests written from contract" > "$artifact_dir/test-writer.log" ;;
    execute) echo "stub: would implement tasks from plan.md" > "$artifact_dir/execute.log" ;;
    verify)  ;; # passes immediately in test mode
    ship)    echo "stub: would create PR" > "$artifact_dir/output.md" ;;
    review)  printf "## Action items\n\n- [ ] P0 Stub blocker for fix-stage trigger\n" > "$artifact_dir/review.md" ;;
    fix)     echo "stub: would fix 1 blocker" > "$artifact_dir/fix.log" ;;
    retro)   echo "stub: would capture learnings to INBOX.md" > "$artifact_dir/retro.log" ;;
  esac
}

# --- notifications ---

_notify() {
  local topic="$1" message="$2"
  tput bel 2>/dev/null || true
  tmux display-message "$message" 2>/dev/null || true
  if command -v terminal-notifier >/dev/null 2>&1; then
    terminal-notifier -title "ag: $topic" -message "$message" -sound default 2>/dev/null || true
  elif command -v notify-send >/dev/null 2>&1; then
    notify-send "ag: $topic" "$message" 2>/dev/null || true
  fi
}

# --- escalation ---

_escalate() {
  local state_dir="$1" topic="$2" stage="$3" reason="$4"
  local topic_dir="$HOME/.agents/artifacts/$topic"
  mkdir -p "$topic_dir"
  cat > "$topic_dir/stuck.md" << STUCK
---
topic: $topic
stage: $stage
updated: $(_now)
---
## Blocked
$reason
## Context
- Pipeline: $state_dir/pipeline.json
- Stage: $stage
## What it needs
Human intervention: ag $topic to attach and resolve.
STUCK
  echo "stuck" > "$state_dir/phase"
  _set_current "$state_dir" "stuck"
  _notify "$topic" "STUCK: $topic ($stage) - $reason"
}

# --- auto-restart (context fill detection) ---

_compose_resume_context() {
  local state_dir="$1" topic="$2" plan="$3"
  local context=""
  if [[ -f "$state_dir/context.json" ]]; then
    local summary
    summary=$(jq -r '.summary // empty' "$state_dir/context.json" 2>/dev/null || true)
    [[ -n "$summary" ]] && context+="Previous session summary: $summary"$'\n\n'
  fi
  if [[ -f "$plan" ]]; then
    local unchecked
    unchecked=$(grep -E '^\s*- \[ \]' "$plan" 2>/dev/null | head -20 || true)
    [[ -n "$unchecked" ]] && context+="Remaining tasks from plan:"$'\n'"$unchecked"$'\n\n'
  fi
  local wt_path=""
  [[ -n "${TMUX:-}" ]] && wt_path=$(tmux display-message -t "$session" -p '#{pane_current_path}' 2>/dev/null || true)
  if [[ -n "$wt_path" ]]; then
    local recent_log
    recent_log=$(git -C "$wt_path" log --oneline -5 2>/dev/null || true)
    [[ -n "$recent_log" ]] && context+="Recent commits:"$'\n'"$recent_log"$'\n\n'
  fi
  echo "$context"
}

_check_context_filling() {
  local state_dir="$1"
  [[ -f "$state_dir/context.json" ]] || return 1
  jq -e '.context_filling == true' "$state_dir/context.json" >/dev/null 2>&1
}

_relaunch_agent() {
  local session="$1" state_dir="$2" topic="$3" plan="$4" model_val="$5" stage="$6"
  local count=0
  [[ -f "$state_dir/context.json" ]] && \
    count=$(jq -r '.relaunch_count // 0' "$state_dir/context.json" 2>/dev/null || echo 0)
  count=$((count + 1))
  if (( count > 3 )); then
    echo "max relaunches ($count) for stage $stage, escalating" >&2
    _escalate "$state_dir" "$topic" "$stage" "Max relaunches (3) exceeded"
    return 1
  fi
  echo "relaunch #$count for stage $stage (context filled)" >&2
  if [[ -f "$state_dir/context.json" ]]; then
    jq --argjson c "$count" '.relaunch_count = $c | .context_filling = false' \
      "$state_dir/context.json" > "$state_dir/context.json.tmp" \
      && mv "$state_dir/context.json.tmp" "$state_dir/context.json"
  fi
  local resume_ctx
  resume_ctx=$(_compose_resume_context "$state_dir" "$topic" "$plan")
  tmux send-keys -t "$session" C-c 2>/dev/null || true
  sleep 2
  local resume_prompt="Resume: continuing $topic (stage: $stage, relaunch #$count).
$resume_ctx
Continue from where you left off. Complete the current stage."
  local cmd
  cmd="$(_build_cmd "$model_val" "$resume_prompt")"
  local sentinel="$state_dir/stage-done"
  rm -f "$sentinel"
  tmux send-keys -t "$session" \
    "$cmd && echo done > $(printf '%q' "$sentinel") || echo fail > $(printf '%q' "$sentinel")" Enter
  return 0
}

# --- chain context: gather upstream artifacts for stage prompts ---

_gather_chain_context() {
  local topic_dir="$1" max_bytes="${2:-8000}"; shift 2 2>/dev/null || shift
  local artifacts=("$@")
  [[ ${#artifacts[@]} -eq 0 ]] && artifacts=(problem.md design.md plan.md output.md)
  local context=""
  for artifact in "${artifacts[@]}"; do
    local path="$topic_dir/$artifact"
    [[ -f "$path" ]] || continue
    context+="--- $artifact ---"$'\n'
    context+="$(_smart_truncate "$path" "$max_bytes")"$'\n\n'
  done
  echo "$context"
}

_log_context() {
  local topic_dir="$1"; shift
  local _found=() _missing=()
  for _a in "$@"; do
    if [[ -f "$topic_dir/$_a" ]]; then _found+=("$_a"); else _missing+=("$_a"); fi
  done
  echo "  context: ${_found[*]:-none}" >&2
  [[ ${#_missing[@]} -gt 0 ]] && echo "  missing: ${_missing[*]}" >&2
}

# --- main ---

session="" topic="" plan="" skip_str="" resume=false test_mode=false

while [[ $# -gt 0 ]]; do
  case "$1" in
    --session) session="$2"; shift 2 ;;
    --topic)   topic="$2"; shift 2 ;;
    --plan)    plan="$2"; shift 2 ;;
    --skip)    skip_str="$2"; shift 2 ;;
    --resume)  resume=true; shift ;;
    --test)    test_mode=true; shift ;;
    -h|--help) usage; exit 0 ;;
    *)         echo "unknown flag: $1" >&2; exit 1 ;;
  esac
done

[[ -z "$session" || -z "$topic" ]] && { usage >&2; exit 1; }
[[ "$test_mode" == false && -z "$plan" ]] && { usage >&2; exit 1; }

state_dir="$HOME/.agents/state/$topic"
mkdir -p "$state_dir"

# PID tracking
_cleanup_pid() {
  rm -f "$state_dir/orchestrator.pid"
}

# test mode: use temp dir
if [[ "$test_mode" == true ]]; then
  state_dir=$(mktemp -d "/tmp/ag-test-XXXXX")
  plan="$state_dir/plan.md"
  cat > "$plan" <<PLANEOF
---
topic: $topic
---
# Test Plan

## Phase 1
- [ ] stub task
PLANEOF
  trap 'echo "test artifacts: $state_dir" >&2; _cleanup_pid' EXIT
fi

# Write PID file
echo $$ > "$state_dir/orchestrator.pid"
if [[ "$test_mode" != true ]]; then
  trap '_cleanup_pid' EXIT
fi

# Parse skip list
IFS=',' read -ra skips <<< "${skip_str:-}"
_should_skip() {
  local stage="$1"
  for s in "${skips[@]:-}"; do
    [[ "$s" == "$stage" ]] && return 0
  done
  return 1
}

# Resolve per-stage config
scout_val="${AG_SCOUT_MODEL:-claude:haiku}"
test_val="${AG_TEST_MODEL:-claude:sonnet}"
exe_val="${AG_EXECUTE_MODEL:-claude:opus}"
ship_val="${AG_SHIP_MODEL:-claude:sonnet}"
review_val="${AG_REVIEW_MODEL:-codex:gpt-5.4}"
retro_val="${AG_RETRO_MODEL:-claude:haiku}"
context_bytes="${AG_CONTEXT_BYTES:-8000}"
verify_max="${AG_VERIFY_MAX:-3}"

# Init or resume pipeline state
if [[ "$resume" == true && -f "$state_dir/pipeline.json" ]]; then
  echo "ag-orchestrate: resuming $topic" >&2
else
  _init_pipeline "$state_dir" "$topic" "$session"
fi

echo "ag-orchestrate: $topic" >&2
echo "  scout:   $scout_val" >&2
echo "  test:    $test_val" >&2
echo "  execute: $exe_val" >&2
echo "  ship:    $ship_val" >&2
echo "  review:  $review_val" >&2
echo "  retro:   $retro_val" >&2
[[ -n "$skip_str" ]] && echo "  skip:    $skip_str" >&2
[[ "$test_mode" == true ]] && echo "  mode:    test" >&2
[[ "$resume" == true ]] && echo "  mode:    resume" >&2

topic_dir="$HOME/.agents/artifacts/$topic"

_run_stage() {
  local stage="$1" model_val="$2" phase_name="$3" timeout="$4" prompt="$5"
  _current_model="$model_val"  # track for _relaunch_agent

  if _should_skip "$stage"; then
    echo "skipping: $stage" >&2
    _update_stage "$state_dir" "$stage" "status" "skipped"
    return 0
  fi

  # resume: skip already-done stages
  if [[ "$resume" == true ]]; then
    local cur_status
    cur_status=$(_stage_status "$state_dir" "$stage")
    if [[ "$cur_status" == "done" || "$cur_status" == "skipped" ]]; then
      echo "already done: $stage" >&2
      return 0
    fi
  fi

  echo "stage: $stage ($model_val)" >&2
  echo "$phase_name" > "$state_dir/phase"
  _start_stage "$state_dir" "$stage" "$model_val"

  if [[ "$test_mode" == true ]]; then
    _run_test_stage "$state_dir" "$stage" "$topic"
    sleep 1
    _finish_stage "$state_dir" "$stage" "done"
    return 0
  fi

  [[ "${AG_DEBUG:-}" == "1" ]] && echo "debug: $stage prompt: $prompt" >&2

  local cmd
  cmd="$(_build_cmd "$model_val" "$prompt")"
  _run_in_session "$session" "$cmd" "$state_dir"
  _wait_stage "$state_dir" "$stage" "$timeout"
}

# --- Stage 1: Scout (pre-execute codebase exploration) ---
scout_prompt="Search the codebase for existing patterns, utilities, and conventions relevant to planned changes."
if [[ -f "$plan" ]]; then
  plan_tasks=$(grep -E '^\s*- \[ \]' "$plan" | head -20 || true)
  if [[ -n "$plan_tasks" ]]; then
    scout_prompt="Search the codebase for existing patterns, utilities, and conventions relevant to these tasks:

$plan_tasks

Write findings to $state_dir/scout-findings.txt. Include: relevant files, reusable functions, conventions to follow."
  fi
fi
_run_stage "scout" "$scout_val" "scouting" 120 "$scout_prompt"

# --- Stage 2: Test-writer (TDD, separate context window) ---
if ! _should_skip "test"; then
  cur_status="pending"
  [[ "$resume" == true ]] && cur_status=$(_stage_status "$state_dir" "test")
  if [[ "$cur_status" != "done" && "$cur_status" != "skipped" ]]; then
    echo "stage: test ($test_val)" >&2
    echo "testing" > "$state_dir/phase"
    _start_stage "$state_dir" "test" "$test_val"

    if [[ "$test_mode" == true ]]; then
      _run_test_stage "$state_dir" "test" "$topic"
      sleep 1
      _finish_stage "$state_dir" "test" "done"
    else
      test_prompt="Read the plan at $plan and write failing tests for the specified tasks.

Rules:
- Read the plan/spec ONLY - do NOT read or write any implementation code
- Write tests that define the CONTRACT based on the spec
- Enumerate inputs, boundaries, and error cases
- Tests should fail when run (implementation does not exist yet)
- Follow the project existing test conventions"
      test_sentinel="$state_dir/test-writer-done"
      test_cmd="$(_build_cmd "$test_val" "$test_prompt")"
      _run_in_window "$session" 9 "$test_cmd" "$test_sentinel"
      if _wait_sentinel "$test_sentinel" 600; then
        _finish_stage "$state_dir" "test" "done"
      else
        _finish_stage "$state_dir" "test" "failed"
        echo "fatal: test-writer failed; aborting pipeline" >&2
        tmux kill-window -t "${session}:9" 2>/dev/null || true
        exit 1
      fi
      tmux kill-window -t "${session}:9" 2>/dev/null || true
    fi
  fi
else
  echo "skipping: test" >&2
  _update_stage "$state_dir" "test" "status" "skipped"
fi

# --- Stage 3: Execute ---
exe_artifacts=(problem.md design.md plan.md)
exe_context=""
if [[ -d "$topic_dir" ]]; then
  _log_context "$topic_dir" "${exe_artifacts[@]}"
  exe_context="$(_gather_chain_context "$topic_dir" "$context_bytes" "${exe_artifacts[@]}")"
  if [[ "${AG_DEBUG:-}" == "1" && -n "$exe_context" ]]; then
    echo "debug: execute context:" >&2; echo "$exe_context" >&2
  fi
fi
scout_findings=""
if [[ -f "$state_dir/scout-findings.txt" ]]; then
  scout_findings="--- scout findings ---
$(head -c "$context_bytes" "$state_dir/scout-findings.txt")

"
  [[ "${AG_DEBUG:-}" == "1" ]] && echo "debug: scout findings included in execute context" >&2
fi
exe_prompt="/execute $plan"
if [[ -n "$exe_context" || -n "$scout_findings" ]]; then
  exe_prompt="Upstream artifacts for context:
${exe_context}${scout_findings}${exe_prompt}"
fi
_run_stage "execute" "$exe_val" "executing" 1800 "$exe_prompt"

# --- Stage 4: Verify (test runner with retry loop) ---
if ! _should_skip "verify"; then
  cur_status="pending"
  [[ "$resume" == true ]] && cur_status=$(_stage_status "$state_dir" "verify")
  if [[ "$cur_status" != "done" && "$cur_status" != "skipped" ]]; then
    echo "stage: verify ($exe_val)" >&2
    echo "verifying" > "$state_dir/phase"
    _start_stage "$state_dir" "verify" "$exe_val"

    if [[ "$test_mode" == true ]]; then
      _run_test_stage "$state_dir" "verify" "$topic"
      sleep 1
      _finish_stage "$state_dir" "verify" "done"
    else
      verify_done=false
      for (( vi=1; vi<=verify_max; vi++ )); do
        _update_stage "$state_dir" "verify" "verify_iteration" "$vi"
        sentinel="$state_dir/stage-done"
        rm -f "$sentinel"

        if (( vi == 1 )); then
          verify_prompt="Run the project test suite. If tests fail, fix the code (not the tests) and re-run until all pass."
          cmd="$(_build_cmd "$exe_val" "$verify_prompt")"
        elif (( vi <= 2 )); then
          # Same-context retry; --continue only works with claude executor
          verify_prompt="Tests still failing. Try a different approach to fix the code. Re-run tests."
          if [[ "$(_executor "$exe_val")" == "claude" ]]; then
            vmodel="$(_model "$exe_val")"
            cmd="claude --continue${vmodel:+ --model $vmodel} $(printf '%q' "$verify_prompt")"
          else
            cmd="$(_build_cmd "$exe_val" "$verify_prompt")"
          fi
        else
          # Fresh compose on final retry (clean context, accumulated evidence)
          verify_prompt="Fresh verify attempt. Run the test suite, analyze failures, fix code (not tests). Start from current state."
          cmd="$(_build_cmd "$exe_val" "$verify_prompt")"
        fi

        [[ "${AG_DEBUG:-}" == "1" ]] && echo "debug: verify iter=$vi" >&2
        tmux send-keys -t "$session" \
          "$cmd && echo done > $(printf '%q' "$sentinel") || echo fail > $(printf '%q' "$sentinel")" Enter

        if _wait_sentinel "$sentinel" 600; then
          verify_done=true
          break
        fi
        echo "  verify iteration $vi/$verify_max failed" >&2
      done

      if [[ "$verify_done" == true ]]; then
        _finish_stage "$state_dir" "verify" "done"
      else
        _finish_stage "$state_dir" "verify" "failed"
        echo "fatal: verify failed after $verify_max attempts; aborting pipeline" >&2
        exit 1
      fi
    fi
  fi
else
  echo "skipping: verify" >&2
  _update_stage "$state_dir" "verify" "status" "skipped"
fi

# --- Stage 5: Ship ---
_run_stage "ship" "$ship_val" "shipping" 600 "/checkpoint"

# --- Stages 6-7: Review Loop (max 2 passes) ---
# Review > fix > re-review. If blockers remain after pass 2: stuck + notify.

_run_review_stage() {
  local state_dir="$1" review_val="$2" topic="$3" test_mode="$4"

  echo "stage: review ($review_val)" >&2
  echo "reviewing" > "$state_dir/phase"
  _start_stage "$state_dir" "review" "$review_val"

  if [[ "$test_mode" == true ]]; then
    _run_test_stage "$state_dir" "review" "$topic"
    sleep 1
    _finish_stage "$state_dir" "review" "done"
  else
    ~/tools/review --topic "$topic" 2>/dev/null &
    local review_pid=$!
    local review_elapsed=0
    while (( review_elapsed < 600 )); do
      if [[ -f "$HOME/.agents/artifacts/$topic/review-state.json" ]]; then
        if jq -e '.status == "done" or .status == "failed"' "$HOME/.agents/artifacts/$topic/review-state.json" >/dev/null 2>&1; then
          break
        fi
      fi
      sleep 10
      review_elapsed=$((review_elapsed + 10))
    done
    wait "$review_pid" 2>/dev/null || true
    local review_status="failed"
    if [[ -f "$HOME/.agents/artifacts/$topic/review-state.json" ]]; then
      review_status=$(jq -r '.status' "$HOME/.agents/artifacts/$topic/review-state.json" 2>/dev/null || echo "failed")
    fi
    _finish_stage "$state_dir" "review" "$review_status"
  fi
}

_run_fix_stage() {
  local state_dir="$1" exe_val="$2" topic="$3" test_mode="$4" review_md="$5"
  local topic_dir="$HOME/.agents/artifacts/$topic"
  local context_bytes="${AG_CONTEXT_BYTES:-8000}"

  echo "stage: fix ($exe_val)" >&2
  echo "fixing" > "$state_dir/phase"
  _start_stage "$state_dir" "fix" "$exe_val"

  if [[ "$test_mode" == true ]]; then
    _run_test_stage "$state_dir" "fix" "$topic"
    sleep 1
    _finish_stage "$state_dir" "fix" "done"
  else
    local fix_artifacts=(problem.md design.md plan.md output.md)
    local fix_context=""
    if [[ -d "$topic_dir" ]]; then
      _log_context "$topic_dir" "${fix_artifacts[@]}"
      fix_context="$(_gather_chain_context "$topic_dir" "$context_bytes" "${fix_artifacts[@]}")"
      if [[ "${AG_DEBUG:-}" == "1" && -n "$fix_context" ]]; then
        echo "debug: fix context:" >&2; echo "$fix_context" >&2
      fi
    fi
    local fix_prompt="Read $review_md and fix all P0/P1 findings. Then run /checkpoint to amend and push."
    if [[ -n "$fix_context" ]]; then
      fix_prompt="Upstream artifacts for context:
$fix_context
$fix_prompt"
    fi
    local cmd
    cmd="$(_build_cmd "$exe_val" "$fix_prompt")"
    _run_in_session "$session" "$cmd" "$state_dir"
    _current_model="$exe_val"
    _wait_stage "$state_dir" "fix" 900 || true
  fi
}

review_skip=false
fix_skip=false
if _should_skip "review"; then review_skip=true; fi
if _should_skip "fix"; then fix_skip=true; fi

if [[ "$review_skip" != true ]]; then
  for (( rp=1; rp<=2; rp++ )); do
    _inc_review_pass "$state_dir"

    # Resume: skip if already done
    if [[ "$resume" == true ]]; then
      cur_status=$(_stage_status "$state_dir" "review")
      if [[ "$cur_status" == "done" || "$cur_status" == "skipped" ]]; then
        break
      fi
    fi

    _run_review_stage "$state_dir" "$review_val" "$topic" "$test_mode"

    # Resolve review.md path
    review_md="$HOME/.agents/artifacts/$topic/review.md"
    [[ "$test_mode" == true ]] && review_md="$state_dir/artifacts/review.md"

    if ! _has_blockers "$review_md"; then
      # No blockers; skip fix, exit loop
      if [[ "$fix_skip" != true ]]; then
        _update_stage "$state_dir" "fix" "status" "skipped"
      fi
      break
    fi

    # Pass 2 with blockers: escalate
    if (( rp == 2 )); then
      _finish_stage "$state_dir" "fix" "stuck"
      _escalate "$state_dir" "$topic" "fix" "Blockers remain after 2 review passes"
      break
    fi

    # Pass 1 with blockers: fix, then loop for re-review
    if [[ "$fix_skip" != true ]]; then
      _run_fix_stage "$state_dir" "$exe_val" "$topic" "$test_mode" "$review_md"
      # Reset review stage for pass 2
      _update_stage "$state_dir" "review" "status" "pending"
    fi
  done
else
  _update_stage "$state_dir" "review" "status" "skipped"
  if [[ "$fix_skip" != true ]]; then
    _update_stage "$state_dir" "fix" "status" "skipped"
  fi
fi

# --- Stage 8: Retro ---
_run_stage "retro" "$retro_val" "learning" 300 "/retro" || true

# --- Done ---
# Only mark done if escalation didn't set stuck
if [[ "$(cat "$state_dir/phase" 2>/dev/null)" != "stuck" ]]; then
  echo "done" > "$state_dir/phase"
  _set_current "$state_dir" "done"
fi

_final_phase=$(cat "$state_dir/phase" 2>/dev/null)
if [[ "$test_mode" == true ]]; then
  echo "" >&2
  echo "=== test results ===" >&2
  all_pass=true
  for s in scout test execute verify ship review fix retro; do
    st=$(_stage_status "$state_dir" "$s")
    if [[ "$st" == "done" || "$st" == "skipped" || "$st" == "stuck" ]]; then
      echo "  $s: $st ✓" >&2
    else
      echo "  $s: $st ✗" >&2
      all_pass=false
    fi
  done
  rp=$(_get_review_pass "$state_dir")
  echo "  review_pass: $rp" >&2
  if [[ "$all_pass" == true ]]; then
    echo "ALL STAGES PASS" >&2
  else
    echo "SOME STAGES FAILED" >&2
    exit 1
  fi
elif [[ "$_final_phase" != "stuck" ]]; then
  _notify "$topic" "pipeline complete: $topic"
fi

[[ "$_final_phase" != "stuck" ]] && echo "ag-orchestrate: $topic complete" >&2
