#!/usr/bin/env bash
# wt-resolve – resolve a ref to a worktree path
# Input: branch name, PR number (#90 or 90), or PR URL
# Output: worktree path on stdout (creates worktree if needed)
# Used by: wt() shell function, ag script
set -euo pipefail

usage() {
  cat <<'EOF'
wt-resolve – resolve a ref to a worktree path

Usage:
  wt-resolve <branch|PR#|PR-URL>

Examples:
  wt-resolve feat/auth        Find or create worktree for branch
  wt-resolve 90               Resolve PR #90 to worktree
  wt-resolve https://github.com/org/repo/pull/90

Environment:
  WT_CREATE_MODE=new    Create new branch off main (default: fetch remote)
EOF
}

case "${1:-}" in -h|--help) usage; exit 0 ;; esac

_main_repo_root() {
  local toplevel common
  toplevel=$(git rev-parse --show-toplevel 2>/dev/null) || return 1
  common=$(git rev-parse --git-common-dir 2>/dev/null)
  if [[ "$common" != ".git" && "$common" != "$(git rev-parse --git-dir 2>/dev/null)" ]]; then
    (cd "$(dirname "$common")" && pwd)
  else
    echo "$toplevel"
  fi
}

ref="${1:-}"
[[ -z "$ref" ]] && { usage >&2; exit 1; }

# --hierarchical mode: when creating new worktree for a name that doesn't exist
# on remote, branch off default branch (used by ag for new work)
create_mode="${WT_CREATE_MODE:-remote}"  # "remote" = fetch existing branch; "new" = create new branch off main

# 1. Parse ref → branch name
branch=""
gh_repo_flag=""

if [[ "$ref" =~ ^https://github\.com/([^/]+/[^/]+)/pull/([0-9]+) ]]; then
  pr_repo="${BASH_REMATCH[1]}"
  pr_number="${BASH_REMATCH[2]}"
  gh_repo_flag="--repo $pr_repo"
  branch=$(gh pr view "$pr_number" $gh_repo_flag --json headRefName --jq '.headRefName' 2>/dev/null)
  [[ -z "$branch" ]] && { echo "error: could not find PR at $ref" >&2; exit 1; }
elif [[ "$ref" =~ ^#?([0-9]+)$ ]]; then
  pr_number="${BASH_REMATCH[1]}"
  branch=$(gh pr view "$pr_number" --json headRefName --jq '.headRefName' 2>/dev/null)
  [[ -z "$branch" ]] && { echo "error: could not find PR #$pr_number" >&2; exit 1; }
else
  branch="$ref"
fi

[[ -z "$branch" ]] && { echo "error: could not resolve '$ref'" >&2; exit 1; }
echo "resolved: $branch" >&2

root=$(_main_repo_root) || { echo "error: not in a git repo" >&2; exit 1; }

# 2. Find existing worktree by branch name
existing=$(git worktree list --porcelain 2>/dev/null | awk -v b="$branch" \
  '/^worktree /{wt=$2} /^branch /{if($2 == "refs/heads/"b) print wt}')
if [[ -n "$existing" ]]; then
  echo "$existing"
  exit 0
fi

# 3. Check detached worktrees (ag pr creates these)
# Also check worktrees whose slug matches (path-based, covers renamed branches)
base=$(basename "$root")
slug=$(echo "$branch" | tr '/' '-')
dest="${root}/../${base}-wt-${slug}"

if [[ -d "$dest" ]]; then
  echo "$dest"
  exit 0
fi

# 4. Create new worktree
# Lock to prevent race between concurrent calls
lockdir="/tmp/wt-resolve-${slug}.lock"
if ! mkdir "$lockdir" 2>/dev/null; then
  echo "error: another wt-resolve is creating '$slug'" >&2
  exit 1
fi
trap "rmdir '$lockdir' 2>/dev/null" EXIT

if [[ "$create_mode" == "new" ]]; then
  # Create new branch off default branch (for ag <name> new work)
  default_branch=$(git symbolic-ref refs/remotes/origin/HEAD 2>/dev/null | sed 's|refs/remotes/origin/||')
  if [[ -z "$default_branch" ]]; then
    default_branch="main"
    echo "warning: origin/HEAD not set, assuming '$default_branch'" >&2
  fi
  git fetch origin "$default_branch" --quiet 2>&1 || {
    echo "error: git fetch failed – check network/auth" >&2; exit 1
  }
  output=$(git worktree add "$dest" -b "$branch" "origin/$default_branch" 2>&1) || {
    if echo "$output" | grep -q "already exists"; then
      echo "error: branch '$branch' already exists – use a different name or: git branch -d $branch" >&2
    else
      echo "error: failed to create worktree: $output" >&2
    fi
    exit 1
  }
  echo "created worktree: $dest (new branch from $default_branch)" >&2
else
  # Fetch existing remote branch
  git fetch origin "$branch" --quiet 2>&1 || {
    echo "error: could not fetch '$branch' – does it exist on origin?" >&2; exit 1
  }
  git worktree add "$dest" "origin/$branch" --detach 2>/dev/null || {
    echo "error: could not create worktree for '$branch'" >&2; exit 1
  }
  # Create local tracking branch (silent fail if exists)
  git -C "$dest" checkout -b "$branch" "origin/$branch" 2>/dev/null || true
  echo "checked out $branch at $dest" >&2
fi

echo "$dest"
