#!/usr/bin/env bash
set -euo pipefail

# doc - browse agent docs (problem → design → plan → output → review → reference)
# Sources: ~/.agents/docs/<topic>/ with YAML frontmatter

DOCS_ROOT="${DOCS_ROOT:-$HOME/.agents/docs}"

if ! command -v fzf &>/dev/null; then
  echo "fzf required but not found" >&2
  exit 1
fi

# ANSI color codes
RED=$'\033[31m'
BLUE=$'\033[34m'
YELLOW=$'\033[33m'
GREEN=$'\033[32m'
MAGENTA=$'\033[35m'
DIM=$'\033[2m'
RESET=$'\033[0m'

# Map doc type to color
color_for_type() {
  case "$1" in
    problem)   printf '%s' "$RED" ;;
    design)    printf '%s' "$BLUE" ;;
    plan)      printf '%s' "$YELLOW" ;;
    output)    printf '%s' "$GREEN" ;;
    review)    printf '%s' "$MAGENTA" ;;
    reference) printf '%s' "$DIM" ;;
    *)         printf '%s' "$RESET" ;;
  esac
}

# Parse frontmatter via ruby (macOS stdlib, zero install)
# Returns: topic repo component status
parse_frontmatter() {
  ruby -ryaml -rdate -e '
    content = File.read(ARGV[0])
    if content =~ /\A---\n(.*?\n)---/m
      fm = YAML.safe_load($1, permitted_classes: [Date]) || {}
      puts [fm["topic"], fm["repo"], fm["component"], fm["status"]].map { |v| v.to_s }.join("\t")
    else
      puts "\t\t\t"
    end
  ' "$1" 2>/dev/null || printf '\t\t\t'
}

# Build entries list
# Format: "colored_display \t full_path \t type \t topic_root \t topic \t repo \t component \t status"
entries=""

if [[ -d "$DOCS_ROOT" ]]; then
  while IFS= read -r file; do
    fname=$(basename "$file" .md)
    topic_dir=$(dirname "$file")
    topic_name=$(basename "$topic_dir")

    # Skip non-doc files at root level
    [[ "$topic_dir" == "$DOCS_ROOT" ]] && continue

    # Determine type from filename or subdir
    parent_name=$(basename "$topic_dir")
    if [[ "$parent_name" == "outputs" || "$parent_name" == "reviews" ]]; then
      topic_dir=$(dirname "$topic_dir")
      topic_name=$(basename "$topic_dir")
      doc_type="${parent_name%?}"
    else
      doc_type="$fname"
    fi
    color=$(color_for_type "$doc_type")

    # Parse frontmatter
    IFS=$'\t' read -r fm_topic fm_repo fm_component fm_status <<< "$(parse_frontmatter "$file")"

    # Use frontmatter values or defaults
    repo="${fm_repo:-}"
    component="${fm_component:-}"
    status="${fm_status:-}"

    # Build display: [type] topic  repo/component  status
    display="${color}[${doc_type}]${RESET}  ${topic_name}"
    [[ -n "$repo" ]] && display+="  ${DIM}${repo}"
    [[ -n "$component" ]] && display+="/${component}"
    [[ -n "$repo" ]] && display+="${RESET}"
    [[ -n "$status" ]] && display+="  ${DIM}${status}${RESET}"

    entries+="${display}"$'\t'"${file}"$'\t'"${doc_type}"$'\t'"${topic_dir}"$'\t'"${topic_name}"$'\t'"${repo}"$'\t'"${component}"$'\t'"${status}"$'\n'
  done < <(find "$DOCS_ROOT" -type f -name '*.md' | sort)
fi

if [[ -z "$entries" ]]; then
  echo "No documents found in $DOCS_ROOT" >&2
  exit 1
fi

# Preview uses hidden field {2} = full path
preview_cmd="bat --style=plain --color=always {2} 2>/dev/null || cat {2}"

# fzf with optional query arg – searches across all fields including hidden ones
fzf_args=(
  --prompt="doc> "
  --ansi
  --delimiter=$'\t'
  --with-nth=1
  --preview="$preview_cmd"
  --preview-window=right:60%:wrap
)
[[ $# -gt 0 ]] && fzf_args+=(--query="$1")

selection=$(printf '%s' "$entries" | fzf "${fzf_args[@]}") || exit 0
[[ -z "$selection" ]] && exit 0

# Parse hidden fields from selection
full=$(echo "$selection" | cut -f2)
doc_type=$(echo "$selection" | cut -f3)
topic_dir=$(echo "$selection" | cut -f4)
topic=$(echo "$selection" | cut -f5)

# Build actions list based on what exists in topic dir
actions=("edit" "view")

if [[ -f "$topic_dir/plan.md" ]]; then
  actions+=("execute")
elif [[ -f "$topic_dir/problem.md" || -f "$topic_dir/design.md" ]]; then
  actions+=("propose")
fi

if [[ "$doc_type" == "output" || "$doc_type" == "review" || -f "$topic_dir/output.md" ]]; then
  actions+=("review")
fi

actions+=("claude" "cursor")

action=$(printf '%s\n' "${actions[@]}" | \
  fzf --prompt="action> " --header="$topic – $(basename "$full")") || exit 0

case "$action" in
  edit)
    ${EDITOR:-cursor} "$full" ;;
  view)
    if command -v bat &>/dev/null; then
      bat --style=plain "$full"
    else
      cat "$full"
    fi ;;
  execute)
    slug="$topic"
    if git rev-parse --show-toplevel &>/dev/null; then
      echo "Launching agent: ag $slug -m \"/execute from $topic_dir/plan.md\""
      ag "$slug" -m "/execute from $topic_dir/plan.md"
    else
      echo "Launching Claude Code: /execute $topic"
      cd "$topic_dir" && claude "/execute $topic"
    fi ;;
  propose)
    slug="$topic"
    if git rev-parse --show-toplevel &>/dev/null; then
      echo "Launching agent: ag $slug -m \"/propose $topic\""
      ag "$slug" -m "/propose $topic"
    else
      echo "Launching Claude Code: /propose $topic"
      cd "$topic_dir" && claude "/propose $topic"
    fi ;;
  review)
    repo_arg=()
    if git rev-parse --show-toplevel >/dev/null 2>&1; then
      repo_arg=(--repo "$(git rev-parse --show-toplevel)")
    fi
    if [[ "$doc_type" == "output" || "$doc_type" == "review" ]]; then
      slug="$(basename "$full" .md)"
      if [[ "$slug" == "output" || "$slug" == "review" ]]; then
        review-output "$topic_dir" "${repo_arg[@]}"
      else
        review-output "$topic_dir" "${repo_arg[@]}" --output "$slug"
      fi
    else
      review-output "$topic_dir" "${repo_arg[@]}"
    fi ;;
  claude)
    if [[ -d "$topic_dir" && "$topic_dir" != "$DOCS_ROOT" ]]; then
      echo "Launching Claude Code: $topic"
      cd "$topic_dir" && claude "load $topic ($topic_dir/)"
    else
      echo "Launching Claude Code: $(basename "$full")"
      claude "load $full"
    fi ;;
  cursor)
    if [[ -d "$topic_dir" && "$topic_dir" != "$DOCS_ROOT" ]]; then
      cursor "$topic_dir"
    else
      cursor "$full"
    fi ;;
esac
