#!/usr/bin/env bash
set -euo pipefail

usage() {
  cat <<'EOF'
sync-codex-config - set Codex CLI autonomy defaults

Usage:
  sync-codex-config

Sets approval_policy=never and sandbox_mode=workspace-write in
~/.codex/config.toml without replacing auth, trust, or profile entries.
EOF
}

case "${1:-}" in
  -h|--help) usage; exit 0 ;;
esac

config_dir="${HOME}/.codex"
config_file="${config_dir}/config.toml"
tmp_file="$(mktemp "${TMPDIR:-/tmp}/codex-config.XXXXXX")"

mkdir -p "$config_dir"
[[ -f "$config_file" ]] || touch "$config_file"

trap 'rm -f "$tmp_file"' EXIT

awk '
  BEGIN {
    entered_section = 0
    found_approval = 0
    found_sandbox = 0
  }

  function print_missing() {
    if (!found_approval) print "approval_policy = \"never\""
    if (!found_sandbox) print "sandbox_mode = \"workspace-write\""
  }

  {
    if (!entered_section && $0 ~ /^[[:space:]]*\[/) {
      print_missing()
      entered_section = 1
    }

    if (!entered_section && $0 ~ /^[[:space:]]*approval_policy[[:space:]]*=/) {
      print "approval_policy = \"never\""
      found_approval = 1
      next
    }

    if (!entered_section && $0 ~ /^[[:space:]]*sandbox_mode[[:space:]]*=/) {
      print "sandbox_mode = \"workspace-write\""
      found_sandbox = 1
      next
    }

    print
  }

  END {
    if (!entered_section) {
      print_missing()
    }
  }
' "$config_file" >"$tmp_file"

mv "$tmp_file" "$config_file"

echo "synced Codex defaults in $config_file"
