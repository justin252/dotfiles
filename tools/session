#!/usr/bin/env bash
set -euo pipefail

# session - browse curated session summaries (~/.agents/sessions/)
# Curated .md notes for context handoff to new agent sessions.
# Save side: from any agent, "save session" writes .md here.
# Default: .md summaries only. --all includes raw JSON transcripts.

usage() {
  cat <<'EOF'
session – browse curated session summaries (fzf)

Usage:
  session [--all] [query]

Options:
  --all         Include raw JSON transcripts (default: .md only)
  -h, --help    Show this help

Sources: ~/.agents/sessions/ (curated .md for context handoff).
EOF
}

SESSIONS_ROOT="$HOME/.agents/sessions"

if ! command -v fzf &>/dev/null; then
  echo "fzf required but not found" >&2
  exit 1
fi

mkdir -p "$SESSIONS_ROOT"

# Parse flags
show_all=false
query=""
while [[ $# -gt 0 ]]; do
  case "$1" in
    -h|--help) usage; exit 0 ;;
    --all) show_all=true; shift ;;
    *) query="$1"; shift ;;
  esac
done

# ANSI color codes
YELLOW=$'\033[33m'
DIM=$'\033[2m'
RESET=$'\033[0m'

entries=""

# Curated session summaries (.md)
while IFS= read -r file; do
  [[ -f "$file" ]] || continue
  rel="${file#"$SESSIONS_ROOT"/}"
  entries+="${YELLOW}[session]${RESET} $rel"$'\t'"$file"$'\n'
done < <(find "$SESSIONS_ROOT" -maxdepth 1 -type f -name '*.md' | sort)

# Optionally show JSON transcripts
if [[ "$show_all" == true ]]; then
  while IFS= read -r file; do
    [[ -f "$file" ]] || continue
    rel="${file#"$SESSIONS_ROOT"/}"
    entries+="${DIM}[json]${RESET} $rel"$'\t'"$file"$'\n'
  done < <(find "$SESSIONS_ROOT" -maxdepth 1 -type f -name '*.json' | sort)
fi

if [[ -z "$entries" ]]; then
  echo "No sessions found in $SESSIONS_ROOT" >&2
  exit 1
fi

preview_cmd="bat --style=plain --color=always {2} 2>/dev/null || cat {2}"

fzf_args=(
  --prompt="session> "
  --ansi
  --delimiter=$'\t'
  --with-nth=1
  --preview="$preview_cmd"
  --preview-window=right:60%:wrap
)
[[ -n "$query" ]] && fzf_args+=(--query="$query")

selection=$(printf '%s' "$entries" | fzf "${fzf_args[@]}") || exit 0
[[ -z "$selection" ]] && exit 0

full=$(echo "$selection" | cut -f2)
fname=$(basename "$full")

actions=("view" "claude" "gemini" "edit")

action=$(printf '%s\n' "${actions[@]}" | \
  fzf --prompt="action> " --header="$fname") || exit 0

case "$action" in
  view)
    if command -v bat &>/dev/null; then
      bat --style=plain "$full"
    else
      cat "$full"
    fi ;;
  claude)
    echo "Launching Claude Code: ${fname%.md}"
    claude "load ${fname%.md} ($full)" ;;
  gemini)
    echo "Launching Gemini: ${fname%.md}"
    gemini "load ${fname%.md} ($full)" ;;
  edit)
    ${EDITOR:-vim} "$full" ;;
esac
