#!/usr/bin/env bash
# refresh-skills - rebuild shared skills, sync Claude symlinks, and copy Cursor skills
# Codex reads ~/.agents/skills directly in this setup.
set -euo pipefail

DOTFILES="${DOTFILES:-$HOME/dotfiles}"
WORK_DOTFILES="${WORK_DOTFILES:-$HOME/dotfiles-work}"

usage() {
  cat <<'EOF'
refresh-skills - rebuild shared skills and sync tool adapters

Usage:
  refresh-skills

Sources:
  ~/dotfiles/.agents/skills
  ~/dotfiles-work/.agents/skills (optional overlay)
EOF
}

case "${1:-}" in
  -h|--help)
    usage
    exit 0
    ;;
esac

prune_broken_links() {
  local dir="$1"
  [[ -d "$dir" ]] || return 0
  find "$dir" -maxdepth 1 -type l ! -exec test -e {} \; -delete 2>/dev/null || true
}

add_unique_name() {
  local name="$1"
  local existing=""
  for existing in "${managed_names[@]:-}"; do
    [[ "$existing" == "$name" ]] && return 0
  done
  managed_names+=("$name")
}

[[ -L "$HOME/.agents/skills" ]] && rm -f "$HOME/.agents/skills"
[[ -L "$HOME/.claude/skills" ]] && rm -f "$HOME/.claude/skills"
[[ -L "$HOME/.cursor/skills" ]] && rm -f "$HOME/.cursor/skills"

mkdir -p "$HOME/.agents/skills" "$HOME/.claude/skills" "$HOME/.cursor/skills" "$HOME/.gemini/commands"

prune_broken_links "$HOME/.agents/skills"
prune_broken_links "$HOME/.claude/skills"
prune_broken_links "$HOME/.gemini/commands"

skill_sources=()
[[ -d "$DOTFILES/.agents/skills" ]] && skill_sources+=("$DOTFILES/.agents/skills")
[[ -d "$WORK_DOTFILES/.agents/skills" ]] && skill_sources+=("$WORK_DOTFILES/.agents/skills")
[[ ${#skill_sources[@]} -gt 0 ]] || { echo "no skill sources found" >&2; exit 1; }

managed_names=()
source_dir=""
skill=""
for source_dir in "${skill_sources[@]}"; do
  for skill in "$source_dir"/*/; do
    [[ -d "$skill" ]] || continue
    add_unique_name "$(basename "$skill")"
  done
done

skill_name=""
for skill_name in "${managed_names[@]:-}"; do
  rm -rf "$HOME/.agents/skills/$skill_name" "$HOME/.claude/skills/$skill_name" "$HOME/.cursor/skills/$skill_name" "$HOME/.gemini/commands/$skill_name.toml"
done

for source_dir in "${skill_sources[@]}"; do
  for skill in "$source_dir"/*/; do
    [[ -d "$skill" ]] || continue
    skill_name="$(basename "$skill")"
    ln -sfn "$skill" "$HOME/.agents/skills/$skill_name"

    # Gemini Custom Command: makes /skillname available as a slash command
    cat > "$HOME/.gemini/commands/$skill_name.toml" <<EOF
description = "Activate the $skill_name skill."
prompt = "Please activate the $skill_name skill."
EOF
  done
done

count=0
for skill in "$HOME/.agents/skills"/*/; do
  [[ -d "$skill" ]] || continue
  skill_name="$(basename "$skill")"
  ln -sfn "$skill" "$HOME/.claude/skills/$skill_name"
  rm -rf "$HOME/.cursor/skills/$skill_name"
  cp -R -L "$skill" "$HOME/.cursor/skills/$skill_name"
  ((count++)) || true
done

echo "refreshed $count skills → ~/.agents/skills/, ~/.claude/skills/, ~/.cursor/skills/"
echo "generated Gemini slash commands → ~/.gemini/commands/"
echo "codex uses ~/.agents/skills/ directly in this setup"
