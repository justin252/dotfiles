#!/usr/bin/env bash
# refresh-skills - prune broken shared skills, re-sync Claude symlinks, and copy Cursor skills
# Cursor doesn't follow symlinks, so skills must be real files.
# Called by pull-dot automatically; run manually after editing skills.
set -euo pipefail

mkdir -p ~/.agents/skills ~/.claude/skills

for dir in ~/.agents/skills ~/.claude/skills; do
  find "$dir" -maxdepth 1 -type l ! -exec test -e {} \; -delete 2>/dev/null || true
done

[[ -d ~/.agents/skills ]] || { echo "no skills dir (~/.agents/skills)" >&2; exit 1; }

rm -rf ~/.cursor/skills
mkdir -p ~/.cursor/skills
count=0
for skill in ~/.agents/skills/*/; do
  [[ -d "$skill" ]] || continue
  ln -sfn "$skill" ~/.claude/skills/"$(basename "$skill")"
  cp -rL "$skill" ~/.cursor/skills/"$(basename "$skill")"
  ((count++)) || true
done
echo "refreshed $count skills → ~/.claude/skills/, ~/.cursor/skills/"
