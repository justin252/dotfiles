#!/usr/bin/env python3
# category: convert
"""Convert CSV to JSON array of objects."""

import csv
import json
import sys
from pathlib import Path


USAGE = """\
csv2json – convert CSV to JSON array of objects

Usage:
  csv2json <input.csv|-> [output.json]

Examples:
  csv2json data.csv                 Write data.json
  csv2json data.csv output.json     Explicit output path
  csv2json - < data.csv             Read stdin, write stdout
  cat data.csv | csv2json -         Pipe mode"""


def main():
    if len(sys.argv) > 1 and sys.argv[1] in ("-h", "--help"):
        print(USAGE)
        sys.exit(0)

    if len(sys.argv) < 2:
        print(USAGE, file=sys.stderr)
        sys.exit(1)

    input_arg = sys.argv[1]
    output_arg = sys.argv[2] if len(sys.argv) > 2 else None

    if input_arg == "-":
        rows = list(csv.DictReader(sys.stdin))
        input_path = None
    else:
        input_path = Path(input_arg)
        if not input_path.exists():
            print(f"File not found: {input_path}", file=sys.stderr)
            sys.exit(1)
        with input_path.open(newline="", encoding="utf-8") as f:
            rows = list(csv.DictReader(f))

    result = json.dumps(rows, indent=2, ensure_ascii=False)

    if output_arg == "-" or (output_arg is None and input_path is None):
        print(result)
    else:
        output_path = Path(output_arg) if output_arg else input_path.with_suffix(".json")
        output_path.write_text(result + "\n", encoding="utf-8")
        print(f"{len(rows)} rows → {output_path}", file=sys.stderr)


if __name__ == "__main__":
    main()
