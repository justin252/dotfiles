#!/usr/bin/env bash
set -euo pipefail

# sesh - browse agent session summaries
# Condensed .md notes for humans to read and to pass context to new sessions.
# Default: .md summaries only. --all includes JSON transcripts.

CLAUDE_SESSIONS="$HOME/.claude/sessions"
GEMINI_SESSIONS="$HOME/.codex/sessions"

if ! command -v fzf &>/dev/null; then
  echo "fzf required but not found" >&2
  exit 1
fi

mkdir -p "$CLAUDE_SESSIONS" "$GEMINI_SESSIONS"

# Parse flags
show_all=false
query=""
while [[ $# -gt 0 ]]; do
  case "$1" in
    --all) show_all=true; shift ;;
    *) query="$1"; shift ;;
  esac
done

# ANSI color codes
YELLOW=$'\033[33m'
BLUE=$'\033[34m'
DIM=$'\033[2m'
RESET=$'\033[0m'

entries=""

# Claude Sessions (.md)
while IFS= read -r file; do
  [[ -f "$file" ]] || continue
  rel="${file#"$CLAUDE_SESSIONS"/}"
  entries+="${YELLOW}[claude]${RESET} $rel"$'\t'"$file"$'\n'
done < <(find "$CLAUDE_SESSIONS" -maxdepth 1 -type f -name '*.md' | sort)

# Gemini Sessions (.md)
while IFS= read -r file; do
  [[ -f "$file" ]] || continue
  rel="${file#"$GEMINI_SESSIONS"/}"
  entries+="${BLUE}[gemini]${RESET} $rel"$'\t'"$file"$'\n'
done < <(find "$GEMINI_SESSIONS" -maxdepth 1 -type f -name '*.md' | sort)

# Optionally show JSON transcripts
if [[ "$show_all" == true ]]; then
  while IFS= read -r file; do
    [[ -f "$file" ]] || continue
    rel="${file#"$CLAUDE_SESSIONS"/}"
    entries+="${DIM}[claude-json]${RESET} $rel"$'\t'"$file"$'\n'
  done < <(find "$CLAUDE_SESSIONS" -maxdepth 1 -type f -name '*.json' | sort)
  while IFS= read -r file; do
    [[ -f "$file" ]] || continue
    rel="${file#"$GEMINI_SESSIONS"/}"
    entries+="${DIM}[gemini-json]${RESET} $rel"$'\t'"$file"$'\n'
  done < <(find "$GEMINI_SESSIONS" -maxdepth 1 -type f -name '*.json' | sort)
fi

if [[ -z "$entries" ]]; then
  echo "No sessions found." >&2
  exit 1
fi

preview_cmd="bat --style=plain --color=always {2} 2>/dev/null || cat {2}"

fzf_args=(
  --prompt="sesh> "
  --ansi
  --delimiter=$'\t'
  --with-nth=1
  --preview="$preview_cmd"
  --preview-window=right:60%:wrap
)
[[ -n "$query" ]] && fzf_args+=(--query="$query")

selection=$(printf '%s' "$entries" | fzf "${fzf_args[@]}") || exit 0
[[ -z "$selection" ]] && exit 0

full=$(echo "$selection" | cut -f2)
fname=$(basename "$full")

actions=("view" "claude" "gemini" "edit")

action=$(printf '%s\n' "${actions[@]}" | \
  fzf --prompt="action> " --header="$fname") || exit 0

case "$action" in
  view)
    if command -v bat &>/dev/null; then
      bat --style=plain "$full"
    else
      cat "$full"
    fi ;;
  claude)
    echo "Launching Claude Code: ${fname%.md}"
    claude "load ${fname%.md} ($full)" ;;
  gemini)
    echo "Launching Gemini: ${fname%.md}"
    gemini "load ${fname%.md} ($full)" ;;
  edit)
    ${EDITOR:-vim} "$full" ;;
esac

